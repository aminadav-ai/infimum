//
// Pure-HTTP Client for `infimum-agentd` over `infimum-web`'s universal `CAP_NET`
// (`HostOp::NetHttpRequest` + `HostOp::CapArgGet`).
//
// Zero filesystem or process effects inside `infimum_code.ifw`: all developer
// operations are authenticated via Bearer token to `127.0.0.1:<port>`.

use "abi.ifm";
use "bridge_gen.ifm";
use "primitives.ifm";
use "std/sys_mem.ifm";
use "std/mem.ifm";
use "std/buf.ifm";

pub mod daemon {
  // --- String Buffer Builders (UTF-32 word-addressed: [len, cp0, cp1, ...]) ---

  pub fn buf_append_buf(dst: i64, max_cap: i64, src: i64) -[Mem]-> unit {
    let slen = buf_len(src, 32768);
    for i in 0..slen max 32768 {
      buf_push_cp(dst, max_cap, buf_get_cp(src, i));
    }
  }

  pub fn buf_append_lit(dst: i64, max_cap: i64, s: str) -[Mem]-> unit {
    buf_push_str(dst, max_cap, s);
  }

  pub fn buf_copy_slice(dst: i64, max_cap: i64, src: i64, start: i64, count: i64) -[Mem]-> unit {
    let slen = buf_len(src, 65536);
    let actual = clamp_i64(count, 0, max_cap);
    let mut written = 0;
    for i in 0..actual max 33000 {
      if start + i >= slen { break; }
      buf_set_cp(dst, written, buf_get_cp(src, start + i));
      written += 1;
    }
    buf_set_len(dst, written);
  }

  // --- Parsing Helpers (cursor stored in `StudioMem.http_key_tmp[0]`) ---

  fn skip_spaces(buf: i64) -[Mem]-> unit {
    let n = buf_len(buf, 65536);
    let mut p = StudioMem.http_key_tmp[0];
    while p < n max 1024 {
      let ch = buf_get_cp(buf, p);
      if ch == ' ' || ch == '\t' || ch == '\r' {
        p += 1;
      } else {
        break;
      }
    }
    StudioMem.http_key_tmp[0] = p;
  }

  pub fn parse_i64(buf: i64) -[Mem]-> i64 {
    skip_spaces(buf);
    let n = buf_len(buf, 65536);
    let mut p = StudioMem.http_key_tmp[0];
    let mut neg = false;
    if p < n && buf_get_cp(buf, p) == '-' {
      neg = true;
      p += 1;
    }
    let mut acc = 0;
    while p < n max 24 {
      let ch = buf_get_cp(buf, p);
      if ch >= '0' && ch <= '9' {
        acc = acc * 10 + (ch - '0');
        p += 1;
      } else {
        break;
      }
    }
    StudioMem.http_key_tmp[0] = p;
    if neg { 0 - acc } else { acc }
  }

  pub fn parse_skip_to_next_line(buf: i64) -[Mem]-> unit {
    let n = buf_len(buf, 65536);
    let mut p = StudioMem.http_key_tmp[0];
    while p < n max 65536 {
      let ch = buf_get_cp(buf, p);
      p += 1;
      if ch == '\n' { break; }
    }
    StudioMem.http_key_tmp[0] = p;
  }

  pub fn parse_line_into(buf: i64, dst: i64, max_cap: i64) -[Mem]-> unit {
    let n = buf_len(buf, 65536);
    let mut p = StudioMem.http_key_tmp[0];
    let mut w = 0;
    while p < n max 4096 {
      let ch = buf_get_cp(buf, p);
      p += 1;
      if ch == '\n' {
        break;
      } else if ch != '\r' && w < max_cap {
        buf_set_cp(dst, w, ch);
        w += 1;
      }
    }
    buf_set_len(dst, w);
    StudioMem.http_key_tmp[0] = p;
  }

  pub fn parse_timeline_words(buf: i64, count: i64) -[Mem]-> unit {
    let capped = clamp_i64(count, 0, LIVE_TIMELINE_MAX_WORDS);
    for i in 0..capped max 9000 {
      StudioMem.live_timeline_buf[i] = parse_i64(buf);
    }
    StudioMem.live_timeline_words = capped;
    parse_skip_to_next_line(buf);
  }

  // --- Daemon Connection Init & HTTP Transport ---

  pub fn init() -[Mem, Net]-> unit {
    buf_clear(StudioMem::agent_url_buf);
    buf_clear(StudioMem::agent_tok_buf);

    // Load AGENT_URL from explicit --cap-arg=AGENT_URL=...
    scratch_reset();
    let kptr = scratch_alloc(64);
    if kptr >= 0 {
      buf_set_str(kptr, 60, "AGENT_URL");
      do Net.call(HostOp::CapArgGet, kptr, StudioMem::agent_url_buf, 250);
    }
    if host_ret() <= 0 {
      buf_clear(StudioMem::agent_url_buf);
      buf_append_lit(StudioMem::agent_url_buf, 250, "http://127.0.0.1:43210");
    }

    // Load AGENT_TOKEN from explicit --cap-arg=AGENT_TOKEN=... -> "Bearer <tok>"
    if kptr >= 0 {
      buf_set_str(kptr, 60, "AGENT_TOKEN");
      do Net.call(HostOp::CapArgGet, kptr, StudioMem::http_body_tmp, 200);
      if host_ret() > 0 {
        buf_append_lit(StudioMem::agent_tok_buf, 250, "Bearer ");
        buf_append_buf(StudioMem::agent_tok_buf, 250, StudioMem::http_body_tmp);
      }
    }

    // Detect Online Infimum Code mode (--cap-arg=ONLINE_MODE=1 -> show only Gemini + OpenRouter)
    if kptr >= 0 {
      buf_set_str(kptr, 60, "ONLINE_MODE");
      do Net.call(HostOp::CapArgGet, kptr, StudioMem::http_body_tmp, 16);
      StudioMem.online_mode = if host_ret() > 0 && buf_get_cp(StudioMem::http_body_tmp, 0) == '1' { 1 } else { 0 };
    }
  }

  pub fn http(method: str, path_q: str, body_ptr: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_req_buf);
    buf_append_lit(StudioMem::http_req_buf, 35900, method);
    buf_push_cp(StudioMem::http_req_buf, 35900, '\n');
    buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_url_buf);
    buf_append_lit(StudioMem::http_req_buf, 35900, path_q);
    buf_push_cp(StudioMem::http_req_buf, 35900, '\n');
    buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_tok_buf);
    buf_push_cp(StudioMem::http_req_buf, 35900, '\n');
    buf_append_lit(StudioMem::http_req_buf, 35900, "text/plain");
    buf_push_cp(StudioMem::http_req_buf, 35900, '\n');
    if body_ptr > 0 {
      buf_append_buf(StudioMem::http_req_buf, 35900, body_ptr);
    }
    buf_clear(StudioMem::http_resp_buf);
    do Net.call(HostOp::NetHttpRequest, StudioMem::http_req_buf, StudioMem::http_resp_buf, 65500);
    host_ret()
  }

  // --- High-Level Studio Daemon API ---

  pub fn settings_load() -[Mem, Net]-> i64 {
    let code = http("GET", "/settings?format=ifm", 0);
    if code != 200 {
      0
    } else {
      bridge_settings_decode(StudioMem::http_resp_buf)
    }
  }

  pub fn settings_save() -[Mem, Net]-> i64 {
    bridge_settings_encode(StudioMem::http_body_tmp);
    let code = http("PUT", "/settings?format=ifm", StudioMem::http_body_tmp);
    if code == 200 { 1 } else { 0 }
  }

  pub fn list_projects() -[Mem, Net]-> i64 {
    let code = http("GET", "/workspaces?format=ifm", 0);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 3500);
      buf_copy_slice(StudioMem::projects_buf, 3500, StudioMem::http_resp_buf, 0, n);
      n
    } else {
      0
    }
  }

  pub fn add_project() -[Mem, Net]-> i64 {
    let code = http("POST", "/workspaces?format=ifm", 0);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 3500);
      if n > 0 {
        buf_copy_slice(StudioMem::projects_buf, 3500, StudioMem::http_resp_buf, 0, n);
      }
      n
    } else {
      0
    }
  }

  pub fn remove_project(idx: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_req_buf);
    buf_append_lit(StudioMem::http_req_buf, 35900, "DELETE\n");
    buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_url_buf);
    buf_append_lit(StudioMem::http_req_buf, 35900, "/workspaces/");
    buf_push_int(StudioMem::http_req_buf, 35900, idx);
    buf_append_lit(StudioMem::http_req_buf, 35900, "?format=ifm\n");
    buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_tok_buf);
    buf_append_lit(StudioMem::http_req_buf, 35900, "\ntext/plain\n");
    buf_clear(StudioMem::http_resp_buf);
    do Net.call(HostOp::NetHttpRequest, StudioMem::http_req_buf, StudioMem::http_resp_buf, 65500);
    if host_ret() == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 3500);
      buf_copy_slice(StudioMem::projects_buf, 3500, StudioMem::http_resp_buf, 0, n);
      n
    } else {
      0
    }
  }

  pub fn list_convs() -[Mem, Net]-> i64 {
    let code = http("GET", "/conversations?format=ifm", 0);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, CONVS_BUF_MAX_CHARS);
      buf_copy_slice(StudioMem::convs_buf, CONVS_BUF_MAX_CHARS, StudioMem::http_resp_buf, 0, n);
      n
    } else {
      0
    }
  }

  pub fn list_files() -[Mem, Net]-> i64 {
    let code = http("GET", "/files?format=ifm", 0);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 3500);
      buf_copy_slice(StudioMem::files_buf, 3500, StudioMem::http_resp_buf, 0, n);
      n
    } else {
      0
    }
  }

  pub fn fetch_file_window(start_line: i64, max_lines: i64) -[Mem, Net]-> i64 {
    let req_len = buf_len(StudioMem::file_view_req_buf, 250);
    if req_len <= 0 {
      0
    } else {
      buf_clear(StudioMem::http_body_tmp);
      for i in 0..req_len max 250 {
        buf_push_cp(StudioMem::http_body_tmp, 1024, buf_get_cp(StudioMem::file_view_req_buf, i));
      }
      buf_push_cp(StudioMem::http_body_tmp, 1024, '\n');
      buf_push_int(StudioMem::http_body_tmp, 1024, max_i64(0, start_line));
      buf_push_cp(StudioMem::http_body_tmp, 1024, ' ');
      buf_push_int(StudioMem::http_body_tmp, 1024, clamp_i64(max_lines, 50, 400));
      let code = if StudioMem.file_view_is_diff == 1 {
        http("POST", "/git/diff?format=ifm", StudioMem::http_body_tmp)
      } else {
        http("POST", "/files/open?format=ifm", StudioMem::http_body_tmp)
      };
      if code == 200 {
        bridge_file_window_decode(StudioMem::http_resp_buf)
      } else {
        0
      }
    }
  }

  pub fn open_file(proj_buf: i64, pstart: i64, plen: i64, fbuf: i64, fstart: i64, flen: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::file_view_req_buf);
    buf_clear(StudioMem::file_view_path_buf);
    let p_vis = clamp_i64(plen, 0, 120);
    for i in 0..p_vis max 120 {
      let ch = buf_get_cp(proj_buf, pstart + i);
      buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
      buf_push_cp(StudioMem::file_view_path_buf, 250, ch);
    }
    buf_push_cp(StudioMem::file_view_req_buf, 250, '\n');
    buf_append_lit(StudioMem::file_view_path_buf, 250, " / ");
    let f_vis = clamp_i64(flen, 0, 120);
    for i in 0..f_vis max 120 {
      let ch = buf_get_cp(fbuf, fstart + i);
      buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
      buf_push_cp(StudioMem::file_view_path_buf, 250, ch);
    }
    StudioMem.file_view_is_diff = 0;
    let ok = fetch_file_window(0, 250);
    if ok == 1 {
      StudioMem.file_view_hl_line = 0;
      StudioMem.file_view_scroll_y = 0;
      StudioMem.file_view_open = 1;
      1
    } else {
      0
    }
  }

  // Open a workspace file directly at a 1-based line number (e.g. from clickable `file:line` links),
  // scrolling the viewport so the target line sits near the top and highlighting it.
  pub fn open_file_at_line(
    proj_buf: i64, pstart: i64, plen: i64,
    fbuf: i64, fstart: i64, flen: i64,
    target_line: i64
  ) -[Mem, Net]-> i64 {
    let prev_is_diff = StudioMem.file_view_is_diff;
    buf_clear(StudioMem::file_view_req_buf);
    buf_clear(StudioMem::file_view_path_buf);
    let p_vis = clamp_i64(plen, 0, 120);
    for i in 0..p_vis max 120 {
      let ch = buf_get_cp(proj_buf, pstart + i);
      buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
      buf_push_cp(StudioMem::file_view_path_buf, 250, ch);
    }
    buf_push_cp(StudioMem::file_view_req_buf, 250, '\n');
    buf_append_lit(StudioMem::file_view_path_buf, 250, " / ");
    let f_vis = clamp_i64(flen, 0, 180);
    for i in 0..f_vis max 180 {
      let ch = buf_get_cp(fbuf, fstart + i);
      buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
      buf_push_cp(StudioMem::file_view_path_buf, 250, ch);
    }
    StudioMem.file_view_is_diff = 0;
    let req_start = max_i64(0, target_line - 45);
    let ok = fetch_file_window(req_start, 250);
    if ok == 1 {
      let total = max_i64(1, StudioMem.file_view_lines);
      let hl = clamp_i64(target_line, 1, total);
      let line_idx = max_i64(0, hl - 1);
      let code_sz = clamp_i64((13 * StudioMem.font_scale_pct + 50) / 100, 10, 44);
      let lh = clamp_i64(code_sz + 7, 18, 36);
      StudioMem.file_view_hl_line = hl;
      StudioMem.file_view_scroll_y = max_i64(0, (line_idx - 6) * lh);
      StudioMem.file_view_open = 1;
      1
    } else {
      StudioMem.file_view_is_diff = prev_is_diff;
      0
    }
  }

  // Open git diff for a specific workspace-relative file (or full project diff if flen == 0).
  pub fn open_diff(proj_buf: i64, pstart: i64, plen: i64, fbuf: i64, fstart: i64, flen: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::file_view_req_buf);
    buf_clear(StudioMem::file_view_path_buf);
    let p_vis = clamp_i64(plen, 0, 120);
    for i in 0..p_vis max 120 {
      let ch = buf_get_cp(proj_buf, pstart + i);
      buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
    }
    buf_push_cp(StudioMem::file_view_req_buf, 250, '\n');
    buf_append_lit(StudioMem::file_view_path_buf, 250, "DIFF: ");
    if flen > 0 {
      let f_vis = clamp_i64(flen, 0, 180);
      for i in 0..f_vis max 180 {
        let ch = buf_get_cp(fbuf, fstart + i);
        buf_push_cp(StudioMem::file_view_req_buf, 250, ch);
        buf_push_cp(StudioMem::file_view_path_buf, 250, ch);
      }
    } else {
      buf_append_lit(StudioMem::file_view_path_buf, 250, "Все изменения проекта");
    }
    StudioMem.file_view_is_diff = 1;
    let ok = fetch_file_window(0, 250);
    if ok == 1 {
      StudioMem.file_view_hl_line = 0;
      StudioMem.file_view_scroll_y = 0;
      StudioMem.file_view_open = 1;
      1
    } else {
      0
    }
  }

  // Fetch git status entries for active project into StudioMem.diff_* arrays.
  pub fn git_status_load(proj_buf: i64) -[Mem, Net]-> i64 {
    let code = http("POST", "/git/status?format=ifm", proj_buf);
    StudioMem.diff_loaded = 1;
    if code == 200 {
      bridge_git_status_decode(StudioMem::http_resp_buf)
    } else {
      StudioMem.diff_count = 0;
      0
    }
  }

  // Fetch details of pending external-mutation approval prompt into StudioMem.approval_*_buf.
  pub fn approval_fetch() -[Mem, Net]-> i64 {
    let code = http("GET", "/agent/approval?format=ifm", 0);
    if code == 200 {
      bridge_approval_prompt_decode(StudioMem::http_resp_buf)
    } else {
      0
    }
  }

  // Send user Approve (1), Allow Always (2), or Deny (0) decision for pending external mutation.
  pub fn approval_decide(id: i64, allow: i64) -[Mem, Net]-> i64 {
    bridge_approval_decide_encode(StudioMem::http_body_tmp, id, allow);
    let code = http("POST", "/agent/approval?format=ifm", StudioMem::http_body_tmp);
    StudioMem.approval_id = 0;
    StudioMem.approval_loaded_id = 0;
    if code == 200 { 1 } else { 0 }
  }

  pub fn play_project(proj_buf: i64, pstart: i64, plen: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    let p_vis = clamp_i64(plen, 0, 200);
    for i in 0..p_vis max 200 {
      buf_push_cp(StudioMem::http_body_tmp, 1024, buf_get_cp(proj_buf, pstart + i));
    }
    let code = http("POST", "/apps/play_project?format=ifm", StudioMem::http_body_tmp);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 16);
      if n >= 1 && buf_get_cp(StudioMem::http_resp_buf, 0) == '2' { 2 } else { 1 }
    } else {
      0
    }
  }

  pub fn delete_conv(idx: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    buf_push_int(StudioMem::http_body_tmp, 64, idx);
    let code = http("POST", "/conversations/delete?format=ifm", StudioMem::http_body_tmp);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, CONVS_BUF_MAX_CHARS);
      buf_copy_slice(StudioMem::convs_buf, CONVS_BUF_MAX_CHARS, StudioMem::http_resp_buf, 0, n);
      n
    } else {
      0
    }
  }

  pub fn keys_status() -[Mem, Net]-> i64 {
    let code = http("GET", "/keys/status?format=ifm", 0);
    if code == 200 {
      StudioMem.http_key_tmp[0] = 0;
      let mask = parse_i64(StudioMem::http_resp_buf);
      StudioMem.keys_status_mask = mask;
      mask
    } else {
      StudioMem.keys_status_mask
    }
  }

  pub fn keys_save(prov_idx: i64, key_buf_ptr: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    buf_push_int(StudioMem::http_body_tmp, 512, prov_idx);
    buf_push_cp(StudioMem::http_body_tmp, 512, '\n');
    buf_append_buf(StudioMem::http_body_tmp, 512, key_buf_ptr);
    let code = http("POST", "/keys/save?format=ifm", StudioMem::http_body_tmp);
    if code == 200 {
      StudioMem.http_key_tmp[0] = 0;
      let mask = parse_i64(StudioMem::http_resp_buf);
      StudioMem.keys_status_mask = mask;
      1
    } else {
      0
    }
  }

  pub fn keys_test(prov_idx: i64, out_buf_ptr: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    buf_push_int(StudioMem::http_body_tmp, 64, prov_idx);
    let code = http("POST", "/keys/test?format=ifm", StudioMem::http_body_tmp);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 150);
      buf_copy_slice(out_buf_ptr, 150, StudioMem::http_resp_buf, 0, n);
      StudioMem.keys_test_ok = if n >= 2 && buf_get_cp(out_buf_ptr, 0) == 'O' && buf_get_cp(out_buf_ptr, 1) == 'K' { 1 } else { 2 };
      n
    } else {
      StudioMem.keys_test_ok = 2;
      0
    }
  }

  pub fn new_conv() -[Mem, Net]-> i64 {
    let code = http("POST", "/conversations/new?format=ifm", StudioMem::active_proj_buf);
    if code == 200 {
      let n = buf_len(StudioMem::http_resp_buf, 200);
      buf_copy_slice(StudioMem::active_hdr_buf, 200, StudioMem::http_resp_buf, 0, n);
      1
    } else {
      0
    }
  }

  pub fn agent_start(prompt_ptr: i64, model_ptr: i64, proj_ptr: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    buf_append_buf(StudioMem::http_body_tmp, 15900, model_ptr);
    buf_push_cp(StudioMem::http_body_tmp, 15900, '\n');
    buf_append_buf(StudioMem::http_body_tmp, 15900, proj_ptr);
    buf_push_cp(StudioMem::http_body_tmp, 15900, '\n');
    buf_append_buf(StudioMem::http_body_tmp, 15900, prompt_ptr);
    StudioMem.live_timeline_words = 0;
    StudioMem.live_cmd_killing = 0;
    let code = http("POST", "/agent/start?format=ifm", StudioMem::http_body_tmp);
    if code == 200 { 1 } else { 0 }
  }

  pub fn agent_poll(reply_ptr: i64, status_ptr: i64) -[Mem, Net]-> i64 {
    let code = http("GET", "/agent/poll?format=ifm", 0);
    if code != 200 {
      0
    } else {
      bridge_agent_poll_decode(StudioMem::http_resp_buf, reply_ptr, status_ptr)
    }
  }

  pub fn agent_cancel() -[Mem, Net]-> i64 {
    let code = http("POST", "/agent/cancel?format=ifm", 0);
    if code == 200 { 1 } else { 0 }
  }

  pub fn agent_kill_cmd() -[Mem, Net]-> i64 {
    let code = http("POST", "/agent/kill-cmd?format=ifm", 0);
    if code == 200 && buf_len(StudioMem::http_resp_buf, 16) > 0 && buf_get_cp(StudioMem::http_resp_buf, 0) == '1' {
      StudioMem.live_cmd_killing = 1;
      1
    } else {
      0
    }
  }

  pub fn play_app(proj_ptr: i64, app_name_ptr: i64) -[Mem, Net]-> i64 {
    buf_clear(StudioMem::http_body_tmp);
    buf_append_buf(StudioMem::http_body_tmp, 1024, proj_ptr);
    buf_push_cp(StudioMem::http_body_tmp, 1024, '\n');
    buf_append_buf(StudioMem::http_body_tmp, 1024, app_name_ptr);
    let code = http("POST", "/apps/play?format=ifm", StudioMem::http_body_tmp);
    if code == 200 { 1 } else { 0 }
  }
}

test "daemon::parse_i64 parses signed integers across whitespace" {
  let b = StudioMem::http_body_tmp;
  buf_clear(b);
  buf_push_cp(b, 64, ' ');
  buf_push_cp(b, 64, '-');
  buf_push_cp(b, 64, '4');
  buf_push_cp(b, 64, '2');
  buf_push_cp(b, 64, ' ');
  buf_push_cp(b, 64, '1');
  buf_push_cp(b, 64, '3');
  buf_push_cp(b, 64, '3');
  buf_push_cp(b, 64, '7');
  StudioMem.http_key_tmp[0] = 0;
  assert(daemon::parse_i64(b) == -42);
  assert(daemon::parse_i64(b) == 1337);
}
