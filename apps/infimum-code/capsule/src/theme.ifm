pub fn currency_short_label(cur_id: i64) -> str {
  match cur_id {
    Currency::Usd => "USD $",
    Currency::Eur => "EUR €",
    _ => "ILS ₪",
  }
}

pub fn currency_menu_label(cur_id: i64) -> str {
  match cur_id {
    Currency::Usd => "USD ($)",
    Currency::Eur => "EUR (€)",
    _ => "ILS (₪)",
  }
}
