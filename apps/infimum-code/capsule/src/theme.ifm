// Dark/light color palette, font scaling, and model/currency display labels.

use "abi.ifm";
use "primitives.ifm";
pub use "std/theme.ifm";

pub fn sf(base_px: i64) -[Mem]-> i64 {
  clamp_i64((base_px * StudioMem.font_scale_pct + 50) / 100, 10, 44)
}

pub fn col_bg(th: i64) -> i64 { theme_bg(th) }
pub fn col_side(th: i64) -> i64 { theme_side(th) }
pub fn col_surf(th: i64) -> i64 { theme_surf(th) }
pub fn col_surf2(th: i64) -> i64 { theme_surf2(th) }
pub fn col_border(th: i64) -> i64 { theme_border(th) }
pub fn col_text(th: i64) -> i64 { theme_text(th) }
pub fn col_muted(th: i64) -> i64 { theme_muted(th) }
pub fn col_accent() -> i64 { theme_accent() }
pub fn col_emerald() -> i64 { theme_success() }
pub fn col_red() -> i64 { theme_danger() }
pub fn col_sel() -> i64 { pack_rgba(59, 130, 246, 110) }

pub fn col_heading(th: i64) -> i64 {
  if th == THEME_LIGHT { pack_rgba(12, 18, 32, 255) } else { pack_rgba(248, 250, 255, 255) }
}

pub fn col_code_bg(th: i64) -> i64 { theme_code_bg(th) }

pub fn col_code_pill(th: i64) -> i64 {
  if th == THEME_LIGHT { pack_rgba(224, 232, 244, 255) } else { pack_rgba(33, 39, 52, 255) }
}

pub fn col_code_text(th: i64) -> i64 {
  if th == THEME_LIGHT { pack_rgba(28, 66, 130, 255) } else { pack_rgba(196, 218, 255, 255) }
}

pub fn is_openrouter_model(m_idx: i64) -> bool {
  m_idx == ModelId::OpenRouterQwenFree
    || m_idx == ModelId::OpenRouterDeepSeekFree
    || m_idx == ModelId::OpenRouterNemotron35VlFree
    || m_idx == ModelId::OpenRouterQwen3Coder480B
    || m_idx == ModelId::OpenRouterDeepSeekV41Flash
    || m_idx == ModelId::OpenRouterDeepSeekV4Flash
    || m_idx == ModelId::OpenRouterGlm53Flash
}

pub fn model_provider_group(m_idx: i64) -> i64 {
  if m_idx <= ModelId::Gemini25FlashLite {
    2 // Google Gemini
  } else if m_idx == ModelId::OpenAiGpt41 || m_idx == ModelId::OpenAiGpt41Mini || m_idx == ModelId::OpenAiO4Mini {
    3 // OpenAI
  } else if m_idx == ModelId::DeepSeekChat || m_idx == ModelId::DeepSeekReasoner {
    4 // DeepSeek
  } else if is_openrouter_model(m_idx) {
    5 // OpenRouter
  } else if m_idx == ModelId::GroqGptOss120B {
    6 // GroqCloud
  } else if m_idx == ModelId::ZaiGlm53Flash {
    7 // Z.ai GLM
  } else {
    8 // Mistral
  }
}

pub fn provider_short_name(p: i64) -> str {
  match p {
    0 => "Gemini",
    1 => "OpenAI",
    2 => "DeepSeek",
    3 => "OpenRouter",
    4 => "Groq",
    5 => "Z.ai",
    _ => "Mistral",
  }
}

