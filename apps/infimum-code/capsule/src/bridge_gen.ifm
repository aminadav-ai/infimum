    StudioMem.dev_mode = clamp_i64(bridge_parse_i64(resp_buf), 0, 1);
    StudioMem.confirm_external_mutations = clamp_i64(bridge_parse_i64(resp_buf), 0, 1);
    StudioMem.turbo_mode = clamp_i64(bridge_parse_i64(resp_buf), 0, 1);
