use "abi.ifm";
use "primitives.ifm";
use "theme.ifm";
use "icons.ifm";
use "daemon_client.ifm";

fn fv_is_alpha(ch: i64) -> bool {
  (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_'
}

fn fv_is_digit(ch: i64) -> bool {
  ch >= '0' && ch <= '9'
}

fn fv_is_ident_cont(ch: i64) -> bool {
  fv_is_alpha(ch) || fv_is_digit(ch)
}

fn fv_is_hex(ch: i64) -> bool {
  fv_is_digit(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
}

fn fv_is_keyword(ptr: i64, len: i64) -[Mem]-> bool {
  if len == 2 {
    slice_eq_str(ptr, len, "fn")
      || slice_eq_str(ptr, len, "if")
      || slice_eq_str(ptr, len, "in")
      || slice_eq_str(ptr, len, "do")
      || slice_eq_str(ptr, len, "at")
      || slice_eq_str(ptr, len, "as")
  } else if len == 3 {
    slice_eq_str(ptr, len, "let")
      || slice_eq_str(ptr, len, "mut")
      || slice_eq_str(ptr, len, "pub")
      || slice_eq_str(ptr, len, "use")
      || slice_eq_str(ptr, len, "mod")
      || slice_eq_str(ptr, len, "for")
      || slice_eq_str(ptr, len, "req")
      || slice_eq_str(ptr, len, "ens")
      || slice_eq_str(ptr, len, "inv")
      || slice_eq_str(ptr, len, "max")
  } else if len == 4 {
    slice_eq_str(ptr, len, "else")
      || slice_eq_str(ptr, len, "enum")
      || slice_eq_str(ptr, len, "test")
      || slice_eq_str(ptr, len, "true")
      || slice_eq_str(ptr, len, "from")
  } else if len == 5 {
    slice_eq_str(ptr, len, "while")
      || slice_eq_str(ptr, len, "break")
      || slice_eq_str(ptr, len, "match")
      || slice_eq_str(ptr, len, "forma")
      || slice_eq_str(ptr, len, "const")
      || slice_eq_str(ptr, len, "false")
  } else if len == 6 {
    slice_eq_str(ptr, len, "struct")
      || slice_eq_str(ptr, len, "layout")
      || slice_eq_str(ptr, len, "export")
      || slice_eq_str(ptr, len, "return")
      || slice_eq_str(ptr, len, "assert")
      || slice_eq_str(ptr, len, "Secret")
      || slice_eq_str(ptr, len, "reveal")
  } else if len == 8 {
    slice_eq_str(ptr, len, "continue")
  } else {
    false
  }
}

fn fv_is_builtin_type(ptr: i64, len: i64) -[Mem]-> bool {
  let c0 = buf_get_cp(ptr - 1, 0);
  if c0 >= 'A' && c0 <= 'Z' {
    true
  } else if len == 3 {
    slice_eq_str(ptr, len, "i64") || slice_eq_str(ptr, len, "str") || slice_eq_str(ptr, len, "vec")
  } else if len == 4 {
    slice_eq_str(ptr, len, "bool") || slice_eq_str(ptr, len, "unit") || slice_eq_str(ptr, len, "word")
  } else if len == 5 {
    slice_eq_str(ptr, len, "fixed")
      || slice_eq_str(ptr, len, "dec64")
      || slice_eq_str(ptr, len, "words")
  } else {
    false
  }
}

pub fn fv_col_kw(th: i64) -> i64 {
  if th == 0 { pack_rgba(192, 132, 252, 255) } else { pack_rgba(126, 34, 206, 255) }
}
pub fn fv_col_ty(th: i64) -> i64 {
  if th == 0 { pack_rgba(56, 189, 248, 255) } else { pack_rgba(3, 105, 161, 255) }
}
pub fn fv_col_fn(th: i64) -> i64 {
  if th == 0 { pack_rgba(125, 211, 252, 255) } else { pack_rgba(2, 132, 199, 255) }
}
pub fn fv_col_num(th: i64) -> i64 {
  if th == 0 { pack_rgba(251, 191, 36, 255) } else { pack_rgba(180, 83, 9, 255) }
}
pub fn fv_col_str(th: i64) -> i64 {
  if th == 0 { pack_rgba(74, 222, 128, 255) } else { pack_rgba(21, 128, 61, 255) }
}
pub fn fv_col_cmt(th: i64) -> i64 {
  if th == 0 { pack_rgba(100, 116, 139, 255) } else { pack_rgba(100, 116, 139, 255) }
}
pub fn fv_col_op(th: i64) -> i64 {
  if th == 0 { pack_rgba(148, 163, 184, 255) } else { pack_rgba(71, 85, 105, 255) }
}

pub fn render_highlighted_line(
  line_start: i64, line_len: i64,
  x0: i64, y: i64, max_x: i64,
  code_sz: i64, th: i64, clip_id: i64
) -[Mem, Gpu]-> unit {
  let mut i = 0;
  let mut cx = x0;
  let base = StudioMem::file_view_buf + 1 + line_start;
  let vis_lim = min_i64(line_len, 220);

  while i < vis_lim && cx < max_x max 220 {
    let ch = buf_get_cp(StudioMem::file_view_buf, line_start + i);
    if ch == ' ' || ch == '\t' {
      let step = if ch == '\t' { glyph_px(' ', code_sz, 2) * 2 } else { glyph_px(' ', code_sz, 2) };
      cx += step;
      i += 1;
    } else if ch == '/' && i + 1 < vis_lim && buf_get_cp(StudioMem::file_view_buf, line_start + i + 1) == '/' {
      // Line comment to end of line
      let c_col = fv_col_cmt(th);
      for k in i..vis_lim max 220 {
        if cx >= max_x { break; }
        let cc = buf_get_cp(StudioMem::file_view_buf, line_start + k);
        let adv = glyph_px(cc, code_sz, 2);
        if cx + adv <= max_x {
          ui_glyph(cx, y, cc, code_sz, 2, c_col, clip_id);
        }
        cx += adv;
      }
      i = vis_lim;
    } else if ch == '"' || ch == '\'' {
      // String or char literal
      let quote = ch;
      let s_col = fv_col_str(th);
      let mut j = i;
      let mut done_str = false;
      while j < vis_lim && !done_str max 220 {
        let sc = buf_get_cp(StudioMem::file_view_buf, line_start + j);
        let adv = glyph_px(sc, code_sz, 2);
        if cx + adv <= max_x {
          ui_glyph(cx, y, sc, code_sz, 2, s_col, clip_id);
        }
        cx += adv;
        if j > i && sc == '\\' && j + 1 < vis_lim {
          j += 1;
          let esc_c = buf_get_cp(StudioMem::file_view_buf, line_start + j);
          let eadv = glyph_px(esc_c, code_sz, 2);
          if cx + eadv <= max_x {
            ui_glyph(cx, y, esc_c, code_sz, 2, s_col, clip_id);
          }
          cx += eadv;
        } else if j > i && sc == quote {
          done_str = true;
        }
        j += 1;
      }
      i = j;
    } else if fv_is_digit(ch) {
      // Numeric literal (decimal or 0x hex)
      let n_col = fv_col_num(th);
      let mut j = i;
      if ch == '0' && j + 1 < vis_lim && (buf_get_cp(StudioMem::file_view_buf, line_start + j + 1) == 'x' || buf_get_cp(StudioMem::file_view_buf, line_start + j + 1) == 'X') {
        j += 2;
        while j < vis_lim && (fv_is_hex(buf_get_cp(StudioMem::file_view_buf, line_start + j)) || buf_get_cp(StudioMem::file_view_buf, line_start + j) == '_') max 40 { j += 1; }
      } else {
        while j < vis_lim && (fv_is_digit(buf_get_cp(StudioMem::file_view_buf, line_start + j)) || buf_get_cp(StudioMem::file_view_buf, line_start + j) == '.' || buf_get_cp(StudioMem::file_view_buf, line_start + j) == '_') max 40 { j += 1; }
      }
      for k in i..j max 40 {
        if cx >= max_x { break; }
        let nc = buf_get_cp(StudioMem::file_view_buf, line_start + k);
        let adv = glyph_px(nc, code_sz, 2);
        if cx + adv <= max_x {
          ui_glyph(cx, y, nc, code_sz, 2, n_col, clip_id);
        }
        cx += adv;
      }
      i = j;
    } else if fv_is_alpha(ch) {
      // Identifier / keyword / type / function call
      let mut j = i + 1;
      while j < vis_lim && fv_is_ident_cont(buf_get_cp(StudioMem::file_view_buf, line_start + j)) max 64 { j += 1; }
      let wlen = j - i;
      let is_call = j < vis_lim && buf_get_cp(StudioMem::file_view_buf, line_start + j) == '(';
      let w_col = if fv_is_keyword(base + i, wlen) {
        fv_col_kw(th)
      } else if fv_is_builtin_type(base + i, wlen) {
        fv_col_ty(th)
      } else if is_call {
        fv_col_fn(th)
      } else {
        col_text(th)
      };
      for k in i..j max 64 {
        if cx >= max_x { break; }
        let ic = buf_get_cp(StudioMem::file_view_buf, line_start + k);
        let adv = glyph_px(ic, code_sz, 2);
        if cx + adv <= max_x {
          ui_glyph(cx, y, ic, code_sz, 2, w_col, clip_id);
        }
        cx += adv;
      }
      i = j;
    } else {
      // Operator or punctuation
      let o_col = fv_col_op(th);
      let adv = glyph_px(ch, code_sz, 2);
      if cx + adv <= max_x {
        ui_glyph(cx, y, ch, code_sz, 2, o_col, clip_id);
      }
      cx += adv;
      i += 1;
    }
  }
}

pub fn render_file_viewer(main_x: i64, main_w: i64, h: i64, top_h: i64, key_special: i64) -[Mem, Gpu, Net]-> unit {
  let th = StudioMem.theme;
  let scale = StudioMem.font_scale_pct;
  let mx = StudioMem.frame_mx;
  let my = StudioMem.frame_my;
  let m_down = StudioMem.frame_m_down;
  let m_clicked = StudioMem.frame_m_clicked;
  let wheel_dy = StudioMem.frame_wheel_dy;
  let modal_none = StudioMem.frame_modal_blocked == 0;

  if modal_none && key_special == KeySpecial::Escape {
    StudioMem.file_view_open = 0;
    StudioMem.active_file_idx = -1;
  } else {
  let ui_sz = sf(14);
  let sm_sz = sf(12);
  let code_sz = sf(13);
  let lh = clamp_i64(code_sz + 7, 18, 36);

  // Full background over the right pane
  ui_rect(main_x, 0, main_w, h, 0, 0, 0, col_bg(th), 0, ClipId::Root);
  ui_rect(main_x, 0, 1, h, 0, 0, 0, col_border(th), 0, ClipId::Root);

  // Top Header Bar
  ui_rect(main_x + 1, 0, main_w - 1, top_h, 0, 0, 0, col_surf(th), 0, ClipId::Root);
  ui_rect(main_x + 1, top_h - 1, main_w - 1, 1, 0, 0, 0, col_border(th), 0, ClipId::Root);

  let btn_sz = clamp_i64(sm_sz + 16, 28, 38);
  let btn_y = (top_h - btn_sz) / 2;
  let close_x = main_x + main_w - 14 - btn_sz;
  let copy_x = close_x - 8 - btn_sz;

  let close_hov = modal_none && point_in_rect(mx, my, close_x, btn_y, btn_sz, btn_sz);
  let copy_hov = modal_none && point_in_rect(mx, my, copy_x, btn_y, btn_sz, btn_sz);
  if close_hov || copy_hov {
    gfx_set_cursor(CursorKind::Pointer);
    if m_clicked == 1 {
      if close_hov {
        StudioMem.file_view_open = 0;
        StudioMem.active_file_idx = -1;
      } else {
        let flen = buf_len(StudioMem::file_view_buf, 32900);
        buf_set_len(StudioMem::copy_mailbox, flen);
        for ci in 0..flen max 32900 {
          buf_set_cp(StudioMem::copy_mailbox, ci, buf_get_cp(StudioMem::file_view_buf, ci));
        }
        StudioMem.copy_override_ptr = -1;
        StudioMem.host_action = HostAction::Copy;
        StudioMem.copy_toast_ticks = 90;
      }
    }
  }

  // Draw file path title
  let path_len = buf_len(StudioMem::file_view_path_buf, 200);
  let max_px = copy_x - 100;
  let mut px = main_x + 18;
  let py_txt = (top_h - ui_sz) / 2;
  for i in 0..path_len max 200 {
    if px >= max_px { break; }
    let ch = buf_get_cp(StudioMem::file_view_path_buf, i);
    let adv = glyph_px(ch, ui_sz, 1);
    if px + adv <= max_px {
      ui_glyph(px, py_txt, ch, ui_sz, 1, col_text(th), ClipId::Root);
    }
    px += adv;
  }
  ui_fmt(px + 12, (top_h - sm_sz) / 2, "{StudioMem.file_view_lines} строк", sm_sz, 0, col_muted(th), ClipId::Root);

  // Copy (two sheets / green check on copied) & Close (X) icon buttons
  let copy_bg = if copy_hov { col_surf2(th) } else { col_bg(th) };
  ui_rect(copy_x, btn_y, btn_sz, btn_sz, 6, 1, 0, copy_bg, col_border(th), ClipId::Root);
  if StudioMem.copy_toast_ticks > 0 {
    icon_check(copy_x + btn_sz / 2, btn_y + btn_sz / 2, 5, pack_rgba(52, 211, 153, 255), ClipId::Root);
  } else {
    let ic_sz = clamp_i64(btn_sz - 12, 14, 22);
    let ic_off = (btn_sz - ic_sz) / 2;
    ui_icon_copy(copy_x + ic_off, btn_y + ic_off, ic_sz, if copy_hov { col_text(th) } else { col_muted(th) }, copy_bg, ClipId::Root);
  }

  let close_bg = if close_hov { col_red() } else { col_bg(th) };
  ui_rect(close_x, btn_y, btn_sz, btn_sz, 6, 1, 0, close_bg, col_border(th), ClipId::Root);
  icon_close(close_x + btn_sz / 2, btn_y + btn_sz / 2, 5, if close_hov { pack_rgba(255, 255, 255, 255) } else { col_muted(th) }, ClipId::Root);

  // Scrollable Code Viewport (Paged / Virtual Scroll — supports files of any size)
  let view_y = top_h + 6;
  let view_h = clamp_i64(h - view_y - 6, 80, 2100);
  let total_lines = clamp_i64(StudioMem.file_view_lines, 1, 2000000);
  let content_h = total_lines * lh + 24;
  let max_scr = if content_h > view_h { content_h - view_h } else { 0 };
  StudioMem.file_view_max_scroll = max_scr;

  let mut scr = clamp_i64(StudioMem.file_view_scroll_y, 0, max_scr);
  if modal_none && wheel_dy != 0 && point_in_rect(mx, my, main_x, top_h, main_w, h - top_h) {
    let dy = clamp_i64(wheel_dy, -800, 800);
    scr = clamp_i64(scr + dy, 0, max_scr);
  }

  // Draggable vertical scrollbar
  let sb_x = main_x + main_w - 12;
  if max_scr > 0 {
    let th_h = clamp_i64((view_h * view_h) / content_h, 28, view_h);
    let track = max_i64(1, view_h - th_h);
    let sb_hov = modal_none && point_in_rect(mx, my, sb_x - 4, view_y, 14, view_h);
    if sb_hov {
      gfx_set_cursor(CursorKind::Pointer);
      if m_clicked == 1 { StudioMem.drag_sb = DragScrollbar::FileView; }
    }
    if StudioMem.drag_sb == DragScrollbar::FileView && m_down == 1 {
      let rel = clamp_i64(my - view_y - th_h / 2, 0, track);
      scr = (rel * max_scr) / track;
    }
    let th_y2 = view_y + (scr * track) / max_scr;
    ui_rect(sb_x, view_y, 6, view_h, 3, 0, 0, col_surf(th), 0, ClipId::Root);
    ui_rect(sb_x, th_y2, 6, th_h, 3, 0, 0, if StudioMem.drag_sb == DragScrollbar::FileView { col_accent() } else { col_border(th) }, 0, ClipId::Root);
  }
  StudioMem.file_view_scroll_y = scr;

  // On-demand paged window fetch if viewport moved outside loaded line window
  let first_line = clamp_i64(scr / lh, 0, total_lines);
  let vis_need = clamp_i64(view_h / lh + 4, 20, 120);
  let cur_ws = StudioMem.file_view_win_start;
  let cur_wc = StudioMem.file_view_win_count;
  let need_fetch = first_line < cur_ws || (first_line + vis_need > cur_ws + cur_wc && cur_ws + cur_wc < total_lines);
  if need_fetch {
    let req_start = max_i64(0, first_line - 60);
    daemon::fetch_file_window(req_start, 250);
  }

  set_clip_rect(ClipId::Feed, main_x + 1, view_y, main_x + main_w - 17, view_y + view_h);

  let gutter_w = clamp_i64((56 * scale) / 100, 48, 88);
  let code_x = main_x + 10 + gutter_w + 10;
  let code_max_x = main_x + main_w - 20;
  ui_rect(main_x + 10 + gutter_w, view_y, 1, view_h, 0, 0, 0, col_border(th), 0, ClipId::Feed);

  let total_len = buf_len(StudioMem::file_view_buf, 65000);
  let win_start = StudioMem.file_view_win_start;
  let skip_target = max_i64(0, first_line - win_start);
  let mut pos = 0;
  let mut rel_line = 0;

  // Fast-skip lines within loaded window above viewport
  while pos < total_len && rel_line < skip_target max 65000 {
    if buf_get_cp(StudioMem::file_view_buf, pos) == '\n' {
      rel_line += 1;
    }
    pos += 1;
  }

  // Render visible lines only
  let mut line_no = win_start + rel_line;
  let mut drawn = 0;
  while pos <= total_len && drawn < 90 max 90 {
    let lstart = pos;
    while pos < total_len && buf_get_cp(StudioMem::file_view_buf, pos) != '\n' max 512 {
      pos += 1;
    }
    let llen = pos - lstart;
    if pos < total_len { pos += 1; }
    let ly = view_y + 4 + line_no * lh - scr;
    if ly > view_y + view_h { break; }
    if ly + lh >= view_y {
      ui_int(main_x + 12, ly, line_no + 1, sm_sz, 2, col_muted(th), ClipId::Feed);
      render_highlighted_line(lstart, llen, code_x, ly, code_max_x, code_sz, th, ClipId::Feed);
    }
    line_no += 1;
    drawn += 1;
    if pos >= total_len && llen == 0 && drawn > 1 { break; }
  }
  }
}
