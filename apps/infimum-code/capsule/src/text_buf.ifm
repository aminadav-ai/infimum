// UTF-32 text buffers, word wrapping, hit-testing, selection, cursor navigation,
// packed message pool, project tree helpers, clipboard handlers, and async host calls.

use "abi.ifm";
use "primitives.ifm";
use "theme.ifm";
use "daemon_client.ifm";
use "std/buf.ifm";
pub use "std/text_edit.ifm";

// --- Plain-Text Wrapping, Hit-Test & Selection (delegated to `std/text_edit.ifm`) ---

pub fn measure_wrapped_ptr(max_w: i64, ptr: i64, size: i64, line_h: i64, style: i64) -[Mem]-> i64 {
  tbuf_measure_wrapped_h(ptr, MAX_MSG_CHARS, max_w, size, line_h, style)
}

pub fn clear_msg_sel() -[Mem]-> unit {
  StudioMem.msg_sel_ptr = 0;
  StudioMem.msg_sel_anchor = 0;
  StudioMem.msg_sel_focus = 0;
  StudioMem.msg_sel_dragging = 0;
}

pub fn select_word_in_msg(ptr: i64, idx: i64) -[Mem]-> unit {
  let n = tbuf_len(ptr, MAX_MSG_CHARS);
  if n > 0 {
    StudioMem.msg_sel_ptr = ptr;
    StudioMem.msg_sel_anchor = tbuf_word_lo(ptr, MAX_MSG_CHARS, idx);
    StudioMem.msg_sel_focus = tbuf_word_hi(ptr, MAX_MSG_CHARS, idx);
    StudioMem.msg_sel_dragging = 0;
  }
}

pub fn hit_wrapped_ptr(mx: i64, my: i64, x: i64, y: i64, max_w: i64, ptr: i64, size: i64, line_h: i64, style: i64) -[Mem]-> i64 {
  tbuf_hit_wrapped(ptr, MAX_MSG_CHARS, mx, my, x, y, max_w, size, line_h, style)
}

pub fn emit_wrapped_sel_ptr(x: i64, y: i64, max_w: i64, ptr: i64, size: i64, line_h: i64, style: i64, rgba: i64, clip: i64, vis_y0: i64, vis_y1: i64, sel_lo_i: i64, sel_hi_i: i64) -[Mem]-> i64 {
  tbuf_draw_wrapped(
    ptr, MAX_MSG_CHARS, x, y, max_w, size, line_h, style, rgba,
    sel_lo_i, sel_hi_i, pack_rgba(59, 130, 246, 115), -1, 0, clip, vis_y0, vis_y1
  )
}

// --- Editable Input Buffer (`StudioMem::input_buf`, cap 8192) ---

pub fn input_len() -[Mem]-> i64 { tbuf_len(StudioMem::input_buf, INPUT_MAX_CHARS) }

pub fn input_delete_range(lo: i64, hi: i64) -[Mem]-> unit {
  let prev_len = input_len();
  let next_pos = tbuf_delete_range(StudioMem::input_buf, INPUT_MAX_CHARS, lo, hi);
  if input_len() != prev_len {
    StudioMem.cursor_pos = next_pos;
    StudioMem.sel_anchor = next_pos;
    StudioMem.in_follow_cursor = 1;
  }
}

pub fn input_delete_selection() -[Mem]-> bool {
  let c = StudioMem.cursor_pos;
  let a = StudioMem.sel_anchor;
  if c != a {
    input_delete_range(min_i64(c, a), max_i64(c, a));
    true
  } else {
    false
  }
}

pub fn input_insert_char(cp: i64) -[Mem]-> unit {
  input_delete_selection();
  let prev_len = input_len();
  let next_pos = tbuf_insert_char(StudioMem::input_buf, INPUT_MAX_CHARS, StudioMem.cursor_pos, cp);
  if input_len() != prev_len {
    StudioMem.cursor_pos = next_pos;
    StudioMem.sel_anchor = next_pos;
    StudioMem.in_follow_cursor = 1;
  }
}

pub fn measure_input_lines(max_w: i64, size: i64) -[Mem]-> i64 {
  let len = input_len();
  let mut lines = 1;
  let mut cx = 0;
  for i in 0..len max 8192 {
    let cp = buf_get_cp(StudioMem::input_buf, i);
    if cp == '\n' {
      lines += 1;
      cx = 0;
    } else {
      let adv = glyph_px(cp, size, 0);
      if cx > 0 && cx + adv > max_w {
        lines += 1;
        cx = adv;
      } else {
        cx += adv;
      }
    }
  }
  lines
}

pub fn hit_input_index_2d(mx: i64, my: i64, box_x: i64, box_y: i64, max_w: i64, size: i64, in_lh: i64) -[Mem]-> i64 {
  let len = input_len();
  let lh = if in_lh > 0 { in_lh } else { 20 };
  let target_row = clamp_i64((my - box_y) / lh, 0, 2000);
  let mut row = 0;
  let mut cx = box_x;
  let mut best = len;
  for i in 0..len max 8192 {
    let cp = buf_get_cp(StudioMem::input_buf, i);
    if cp == '\n' {
      if row == target_row {
        best = i;
        break;
      }
      row += 1;
      cx = box_x;
    } else {
      let adv = glyph_px(cp, size, 0);
      if cx > box_x && (cx - box_x) + adv > max_w {
        if row == target_row {
          best = i;
          break;
        }
        row += 1;
        cx = box_x;
      }
      if row == target_row && mx < cx + adv / 2 {
        best = i;
        break;
      }
      cx += adv;
    }
  }
  best
}

pub fn input_cursor_rel_y(cur_idx: i64, max_w: i64, size: i64, in_lh: i64) -[Mem]-> i64 {
  let len = input_len();
  let lim = clamp_i64(cur_idx, 0, len);
  let mut row = 0;
  let mut cx = 0;
  for i in 0..lim max 8192 {
    let cp = buf_get_cp(StudioMem::input_buf, i);
    if cp == '\n' {
      row += 1;
      cx = 0;
    } else {
      let adv = glyph_px(cp, size, 0);
      if cx > 0 && cx + adv > max_w {
        row += 1;
        cx = adv;
      } else {
        cx += adv;
      }
    }
  }
  row * in_lh
}

pub fn input_move_vertical(dir: i64, max_w: i64, size: i64, in_lh: i64, keep_sel: bool) -[Mem]-> unit {
  let len = input_len();
  let cur = clamp_i64(StudioMem.cursor_pos, 0, len);
  let mut row = 0;
  let mut cx = 0;
  for i in 0..cur max 8192 {
    let cp = buf_get_cp(StudioMem::input_buf, i);
    if cp == '\n' {
      row += 1;
      cx = 0;
    } else {
      let adv = glyph_px(cp, size, 0);
      if cx > 0 && cx + adv > max_w {
        row += 1;
        cx = adv;
      } else {
        cx += adv;
      }
    }
  }
  let target_row = row + dir;
  if target_row < 0 {
    StudioMem.cursor_pos = 0;
    if !keep_sel { StudioMem.sel_anchor = 0; }
  } else {
    let idx = hit_input_index_2d(cx, target_row * in_lh + in_lh / 2, 0, 0, max_w, size, in_lh);
    StudioMem.cursor_pos = idx;
    if !keep_sel { StudioMem.sel_anchor = idx; }
  }
  StudioMem.in_follow_cursor = 1;
}

pub fn input_move_line_edge(to_end: bool, max_w: i64, size: i64, keep_sel: bool) -[Mem]-> unit {
  let len = input_len();
  let cur = clamp_i64(StudioMem.cursor_pos, 0, len);
  let mut cx = 0;
  let mut line_start = 0;
  for i in 0..cur max 8192 {
    let cp = buf_get_cp(StudioMem::input_buf, i);
    if cp == '\n' {
      cx = 0;
      line_start = i + 1;
    } else {
      let adv = glyph_px(cp, size, 0);
      if cx > 0 && cx + adv > max_w {
        cx = adv;
        line_start = i;
      } else {
        cx += adv;
      }
    }
  }
  if cur < len {
    let cp_cur = buf_get_cp(StudioMem::input_buf, cur);
    if cp_cur != '\n' {
      let adv_cur = glyph_px(cp_cur, size, 0);
      if cx > 0 && cx + adv_cur > max_w {
        cx = 0;
        line_start = cur;
      }
    }
  }
  let mut target = line_start;
  if to_end {
    let mut j = cur;
    for _ in 0..8192 {
      if j >= len { break; }
      let cp = buf_get_cp(StudioMem::input_buf, j);
      if cp == '\n' { break; }
      let adv = glyph_px(cp, size, 0);
      if cx > 0 && cx + adv > max_w { break; }
      cx += adv;
      j += 1;
    }
    target = j;
  }
  StudioMem.cursor_pos = target;
  if !keep_sel { StudioMem.sel_anchor = target; }
  StudioMem.in_follow_cursor = 1;
}

// --- Settings, Packed Message Pool & Project Tree Helpers ---

pub fn save_settings() -[Mem, Net]-> unit {
  StudioMem.settings_theme = StudioMem.theme;
  StudioMem.settings_scale = StudioMem.font_scale_pct;
  StudioMem.settings_currency = StudioMem.currency_id;
  StudioMem.settings_model = StudioMem.model_idx;
  StudioMem.settings_dev_mode = StudioMem.dev_mode;
  daemon::settings_save();
}

pub fn reset_tl_expanded() -[Mem]-> unit {
  let mut i = 0;
  while i < MAX_MESSAGES max 512 {
    StudioMem.msg_tl_expanded[i] = 0;
    i += 1;
  }
}

pub fn reset_messages() -[Mem]-> unit {
  StudioMem.msg_count = 0;
  StudioMem.msg_pool_cursor = StudioMem::msg_pool;
  StudioMem.img_count = 0;
  StudioMem.img_pending_base = 0;
  StudioMem.pasted_img_w = 0;
  StudioMem.pasted_img_h = 0;
  StudioMem.img_preview_idx = -1;
  StudioMem.img_preview_start = 0;
  StudioMem.img_preview_count = 0;
  StudioMem.host_action = HostAction::ClearImage;
  StudioMem.cached_layout_col_w = 0;
  StudioMem.cached_layout_scale = 0;
  reset_tl_expanded();
  clear_msg_sel();
}

pub fn copy_msg_meta(dst_slot: i64, src_slot: i64) -[Mem]-> unit {
  StudioMem.msg_meta[dst_slot] = StudioMem.msg_meta[src_slot];
  StudioMem.msg_tl_expanded[dst_slot] = StudioMem.msg_tl_expanded[src_slot];
}

// Evict or invalidate any existing messages whose `text_ptr` or `tl_ptr` overlaps
// `[alloc_start, alloc_end)` before writing into `msg_pool` (prevents silent corruption on wrap-around).
// Returns the updated index of `keep_slot` (or -1 if `keep_slot < 0`).
pub fn evict_msg_pool_range(alloc_start: i64, alloc_end: i64, keep_slot: i64) -[Mem]-> i64 {
  let cnt = clamp_i64(StudioMem.msg_count, 0, MAX_MESSAGES);
  let mut dst = 0;
  let mut new_keep = -1;
  let mut s = 0;
  while s < cnt max 512 {
    let tp = StudioMem.msg_meta[s].text_ptr;
    let tlen = if tp >= StudioMem::msg_pool {
      buf_len(tp, MAX_MSG_CHARS) + 2
    } else {
      0
    };
    let text_overlaps = tp >= StudioMem::msg_pool && tp < alloc_end && (tp + tlen) > alloc_start;
    if s != keep_slot && text_overlaps {
      // Drop overwritten historical message
    } else {
      let tlp = StudioMem.msg_meta[s].tl_ptr;
      if tlp >= StudioMem::msg_pool && tlp < alloc_end && (tlp + LIVE_TIMELINE_MAX_WORDS + 2) > alloc_start {
        StudioMem.msg_meta[s].tl_ptr = 0;
        StudioMem.msg_tl_expanded[s] = 0;
      }
      if dst != s {
        copy_msg_meta(dst, s);
      }
      if s == keep_slot {
        new_keep = dst;
      }
      dst += 1;
    }
    s += 1;
  }
  if dst != cnt {
    StudioMem.msg_count = clamp_i64(dst, 0, MAX_MESSAGES);
    StudioMem.cached_layout_col_w = 0;
    clear_msg_sel();
  }
  new_keep
}

pub fn append_message(role: i64, src_ptr: i64, el_tenths: i64, cost_m: i64, tokens: i64) -[Mem]-> unit {
  let cur_raw = StudioMem.msg_pool_cursor;
  let mut cursor = if cur_raw < StudioMem::msg_pool || cur_raw > StudioMem::msg_pool + MSG_POOL_WRAP_OFFSET {
    StudioMem::msg_pool
  } else {
    cur_raw
  };
  let n_raw = buf_len(src_ptr, MAX_MSG_CHARS);
  let avail = clamp_i64((StudioMem::msg_pool + MSG_POOL_GUARD_OFFSET) - cursor, 0, MAX_MSG_CHARS);
  let n = if n_raw <= avail {
    n_raw
  } else {
    cursor = StudioMem::msg_pool;
    clamp_i64(n_raw, 0, MAX_MSG_CHARS)
  };
  let _ = evict_msg_pool_range(cursor, cursor + n + 2, -1);

  let cnt = clamp_i64(StudioMem.msg_count, 0, MAX_MESSAGES);
  let slot = if cnt < MAX_MESSAGES {
    cnt
  } else {
    let mut s = 0;
    while s < MAX_MESSAGES - 1 max 511 {
      copy_msg_meta(s, s + 1);
      s += 1;
    }
    MAX_MESSAGES - 1
  };

  buf_set_len(cursor, n);
  let mut i = 0;
  while i < n max 32768 {
    buf_set_cp(cursor, i, buf_get_cp(src_ptr, i));
    i += 1;
  }
  StudioMem.msg_pool_cursor = cursor + n + 2;

  StudioMem.msg_meta[slot].role = role;
  StudioMem.msg_meta[slot].elapsed_tenths = el_tenths;
  StudioMem.msg_meta[slot].cost_milli = cost_m;
  StudioMem.msg_meta[slot].tokens = tokens;
  StudioMem.msg_meta[slot].text_ptr = cursor;
  StudioMem.msg_meta[slot].cached_h = 0;
  StudioMem.msg_meta[slot].feedback_pack = 0;
  StudioMem.msg_meta[slot].tl_ptr = 0;
  StudioMem.msg_tl_expanded[slot] = 0;
  if cnt < MAX_MESSAGES { StudioMem.msg_count = cnt + 1; }
  StudioMem.auto_scroll_bottom = 1;
}

pub fn attach_live_timeline_to_msg(slot_idx: i64, reset_exp: bool) -[Mem]-> unit {
  let tl_n = clamp_i64(StudioMem.live_timeline_words, 0, LIVE_TIMELINE_MAX_WORDS);
  let cnt = clamp_i64(StudioMem.msg_count, 0, MAX_MESSAGES);
  if tl_n >= 7 && slot_idx >= 0 && slot_idx < cnt {
    let cur_raw = StudioMem.msg_pool_cursor;
    let mut cursor = if cur_raw < StudioMem::msg_pool || cur_raw > StudioMem::msg_pool + MSG_POOL_WRAP_OFFSET {
      StudioMem::msg_pool
    } else {
      cur_raw
    };
    if cursor + tl_n + 2 > StudioMem::msg_pool + MSG_POOL_GUARD_OFFSET {
      cursor = StudioMem::msg_pool;
    }
    let slot = evict_msg_pool_range(cursor, cursor + tl_n + 2, slot_idx);
    if slot >= 0 && slot < MAX_MESSAGES && cursor >= 0 {
      let dst_tl = slice_i64(cursor, tl_n);
      for i in 0..dst_tl.len max 9000 {
        if i < LIVE_TIMELINE_MAX_WORDS {
          dst_tl[i] = StudioMem.live_timeline_buf[i];
        }
      }
      StudioMem.msg_pool_cursor = cursor + tl_n + 2;
      StudioMem.msg_meta[slot].tl_ptr = cursor;
      if reset_exp {
        StudioMem.msg_tl_expanded[slot] = 0;
      }
    }
  }
  StudioMem.live_timeline_words = 0;
  StudioMem.live_cmd_killing = 0;
}

pub fn attach_live_timeline_to_last_msg() -[Mem]-> unit {
  let cnt = clamp_i64(StudioMem.msg_count, 0, MAX_MESSAGES);
  if cnt > 0 {
    attach_live_timeline_to_msg(cnt - 1, true);
  } else {
    StudioMem.live_timeline_words = 0;
    StudioMem.live_cmd_killing = 0;
  }
}

pub fn spans_equal(buf_a: i64, start_a: i64, len_a: i64, buf_b: i64, start_b: i64, len_b: i64) -[Mem]-> bool {
  if len_a != len_b || len_a <= 0 {
    false
  } else {
    let mut ok = true;
    let mut i = 0;
    let lim = clamp_i64(len_a, 0, 96);
    while i < lim && ok max 96 {
      if buf_get_cp(buf_a, start_a + i) != buf_get_cp(buf_b, start_b + i) {
        ok = false;
      }
      i += 1;
    }
    ok
  }
}

pub fn project_has_convs(p_start: i64, p_len: i64) -[Mem]-> bool {
  let clen = buf_len(StudioMem::convs_buf, CONVS_BUF_MAX_CHARS);
  let mut cpi = 0;
  let mut found = false;
  for _ in 0..MAX_CONVS max 256 {
    if cpi >= clen { break; }
    let lstart = cpi;
    let mut tab_pos = -1;
    for _ in 0..140 {
      if cpi >= clen { break; }
      let ch = buf_get_cp(StudioMem::convs_buf, cpi);
      if ch == '\n' { break; }
      if ch == '\t' && tab_pos < 0 { tab_pos = cpi; }
      cpi += 1;
    }
    let lend = cpi;
    if cpi < clen { cpi += 1; }
    if tab_pos > lstart && lend > tab_pos {
      if spans_equal(StudioMem::projects_buf, p_start, p_len, StudioMem::convs_buf, lstart, tab_pos - lstart) {
        found = true;
        break;
      }
    }
  }
  found
}

pub fn count_and_init_project_tree() -[Mem]-> unit {
  for k in 0..MAX_PROJECTS max 64 {
    StudioMem.proj_expanded[k] = 0;
  }
  let clen = buf_len(StudioMem::convs_buf, CONVS_BUF_MAX_CHARS);
  let mut first_plen = 0;
  for ci in 0..min_i64(clen, 96) max 96 {
    let ch = buf_get_cp(StudioMem::convs_buf, ci);
    if ch == '\t' || ch == '\n' {
      if ch == '\t' { first_plen = ci; }
      break;
    }
  }

  let plen = buf_len(StudioMem::projects_buf, 3500);
  let mut pi = 0;
  let mut p_idx = 0;
  let mut matched_idx = -1;
  while pi < plen && p_idx < MAX_PROJECTS max 64 {
    let start = pi;
    for _ in 0..80 {
      if pi >= plen || buf_get_cp(StudioMem::projects_buf, pi) == '\n' { break; }
      pi += 1;
    }
    let name_len = pi - start;
    if pi < plen { pi += 1; }
    if name_len > 0 {
      if first_plen > 0 && matched_idx < 0 && spans_equal(StudioMem::projects_buf, start, name_len, StudioMem::convs_buf, 0, first_plen) {
        matched_idx = p_idx;
      }
      p_idx += 1;
    }
  }
  StudioMem.proj_count = p_idx;
  if matched_idx >= 0 && matched_idx < MAX_PROJECTS {
    StudioMem.active_proj_idx = matched_idx;
    StudioMem.proj_expanded[matched_idx] = 1;
  } else if p_idx > 0 {
    StudioMem.proj_expanded[0] = 1;
  }
}

pub fn extract_active_project_to(dst_ptr: i64) -[Mem]-> unit {
  let target = StudioMem.active_proj_idx;
  let plen = buf_len(StudioMem::projects_buf, 3500);
  let mut pi = 0;
  let mut idx = 0;
  buf_clear(dst_ptr);
  while pi < plen && idx <= target max 64 {
    let start = pi;
    for _ in 0..80 {
      if pi >= plen || buf_get_cp(StudioMem::projects_buf, pi) == '\n' { break; }
      pi += 1;
    }
    let nlen = clamp_i64(pi - start, 0, 96);
    if pi < plen { pi += 1; }
    if nlen > 0 {
      if idx == target {
        buf_set_len(dst_ptr, nlen);
        for k in 0..nlen max 96 {
          buf_set_cp(dst_ptr, k, buf_get_cp(StudioMem::projects_buf, start + k));
        }
        break;
      }
      idx += 1;
    }
  }
}

pub fn daemon_fetch_conv_msg(msg_idx: i64) -[Mem, Net]-> i64 {
  buf_clear(StudioMem::http_req_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "GET\n");
  daemon::buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_url_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "/conversations/msg/");
  buf_push_int(StudioMem::http_req_buf, 35900, msg_idx);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "?format=ifm\n");
  daemon::buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_tok_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "\ntext/plain\n");
  buf_clear(StudioMem::http_resp_buf);
  do Net.call(HostOp::NetHttpRequest, StudioMem::http_req_buf, StudioMem::http_resp_buf, 65500);
  host_ret()
}

pub fn daemon_fetch_and_attach_msg_timeline(msg_idx: i64) -[Mem, Net]-> i64 {
  buf_clear(StudioMem::http_req_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "GET\n");
  daemon::buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_url_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "/conversations/msg/");
  buf_push_int(StudioMem::http_req_buf, 35900, msg_idx);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "/timeline?format=ifm\n");
  daemon::buf_append_buf(StudioMem::http_req_buf, 35900, StudioMem::agent_tok_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 35900, "\ntext/plain\n");
  buf_clear(StudioMem::http_resp_buf);
  do Net.call(HostOp::NetHttpRequest, StudioMem::http_req_buf, StudioMem::http_resp_buf, 65500);
  if host_ret() == 200 {
    StudioMem.http_key_tmp[0] = 0;
    let tl_n = daemon::parse_i64(StudioMem::http_resp_buf);
    daemon::parse_skip_to_next_line(StudioMem::http_resp_buf);
    if tl_n >= 7 {
      daemon::parse_timeline_words(StudioMem::http_resp_buf, tl_n);
      attach_live_timeline_to_msg(msg_idx, false);
      1
    } else {
      0
    }
  } else {
    0
  }
}

pub fn daemon_load_gpu_img(msg_idx: i64, img_idx: i64) -[Mem, Net]-> i64 {
  buf_clear(StudioMem::http_req_buf);
  daemon::buf_append_buf(StudioMem::http_req_buf, 2000, StudioMem::agent_url_buf);
  daemon::buf_append_lit(StudioMem::http_req_buf, 2000, "/conversations/img/");
  buf_push_int(StudioMem::http_req_buf, 2000, msg_idx);
  buf_push_cp(StudioMem::http_req_buf, 2000, '/');
  buf_push_int(StudioMem::http_req_buf, 2000, img_idx);
  buf_push_cp(StudioMem::http_req_buf, 2000, '\n');
  daemon::buf_append_buf(StudioMem::http_req_buf, 2000, StudioMem::agent_tok_buf);
  do Net.call(HostOp::GpuLoadImageUrl, StudioMem::http_req_buf, 0, 0);
  host_ret()
}

pub fn daemon_upload_pending_images(cnt: i64) -[Mem, Net]-> unit {
  let n = clamp_i64(cnt, 0, 6);
  if n > 0 {
    daemon::http("DELETE", "/images", 0);
    for k in 0..n max 6 {
      buf_clear(StudioMem::http_req_buf);
      daemon::buf_append_buf(StudioMem::http_req_buf, 2000, StudioMem::agent_url_buf);
      daemon::buf_append_lit(StudioMem::http_req_buf, 2000, "/images\n");
      daemon::buf_append_buf(StudioMem::http_req_buf, 2000, StudioMem::agent_tok_buf);
      let is_last = if k + 1 == n { 1 } else { 0 };
      do Net.call(HostOp::NetPostPendingImage, StudioMem::http_req_buf, k, is_last);
    }
  }
}

pub fn daemon_load_conv(idx: i64) -[Mem, Net]-> i64 {
  buf_clear(StudioMem::http_body_tmp);
  buf_push_int(StudioMem::http_body_tmp, 32, idx);
  let code = daemon::http("POST", "/conversations/load?format=ifm", StudioMem::http_body_tmp);
  if code != 200 {
    0
  } else {
    StudioMem.http_key_tmp[0] = 0;
    daemon::parse_line_into(StudioMem::http_resp_buf, StudioMem::active_hdr_buf, 200);
    let msg_n = clamp_i64(daemon::parse_i64(StudioMem::http_resp_buf), 0, MAX_MESSAGES);

    reset_messages();
    do Net.call(HostOp::GpuClearImages, 0, 0, 0);
    let mut gpu_slot = 0;
    let mut loaded = 0;
    for i in 0..msg_n max 512 {
      let mcode = daemon_fetch_conv_msg(i);
      if mcode == 200 {
        StudioMem.http_key_tmp[0] = 0;
        let role = daemon::parse_i64(StudioMem::http_resp_buf);
        let tl_n = daemon::parse_i64(StudioMem::http_resp_buf);
        let text_len = clamp_i64(daemon::parse_i64(StudioMem::http_resp_buf), 0, MAX_MSG_CHARS);
        let imgs_n = clamp_i64(daemon::parse_i64(StudioMem::http_resp_buf), 0, 6);
        daemon::parse_skip_to_next_line(StudioMem::http_resp_buf);

        if tl_n > 0 {
          daemon::parse_timeline_words(StudioMem::http_resp_buf, tl_n);
        } else {
          StudioMem.live_timeline_words = 0;
          daemon::parse_skip_to_next_line(StudioMem::http_resp_buf);
        }

        let start_pos = StudioMem.http_key_tmp[0];
        let total_len = buf_len(StudioMem::http_resp_buf, 65536);
        let avail = clamp_i64(total_len - start_pos, 0, MAX_MSG_CHARS);
        let copy_len = if text_len < avail { text_len } else { avail };
        daemon::buf_copy_slice(StudioMem::reply_buf, MAX_MSG_CHARS, StudioMem::http_resp_buf, start_pos, copy_len);

        append_message(role, StudioMem::reply_buf, 0, 0, 0);
        if tl_n > 0 {
          attach_live_timeline_to_last_msg();
        }
        if imgs_n > 0 && StudioMem.msg_count > 0 {
          let img_base = gpu_slot;
          let mut img_ok = 0;
          for k in 0..imgs_n max 6 {
            if gpu_slot >= 16 { break; }
            let wh = daemon_load_gpu_img(i, k);
            if wh > 0 {
              StudioMem.img_w[gpu_slot] = wh >> 16;
              StudioMem.img_h[gpu_slot] = wh & 65535;
              gpu_slot += 1;
              img_ok += 1;
            }
          }
          if img_ok > 0 {
            let last_slot = clamp_i64(StudioMem.msg_count - 1, 0, MAX_MESSAGES - 1);
            StudioMem.msg_meta[last_slot].feedback_pack = img_base | (img_ok << 8);
          }
        }
        loaded += 1;
      }
    }
    StudioMem.img_pending_base = gpu_slot;
    StudioMem.img_count = 0;
    StudioMem.pasted_img_w = 0;
    StudioMem.pasted_img_h = 0;
    loaded
  }
}

pub fn start_new_dialog_for_project(p_idx: i64) -[Mem, Net]-> unit {
  let clamped = clamp_i64(p_idx, 0, 63);
  StudioMem.active_proj_idx = clamped;
  StudioMem.proj_expanded[clamped] = 1;
  extract_active_project_to(StudioMem::active_proj_buf);
  daemon::new_conv();
  reset_messages();
  StudioMem.live_timeline_words = 0;
  StudioMem.live_cmd_killing = 0;
  StudioMem.active_conv_idx = -1;
  StudioMem.view_mode = ViewMode::Chat;
  StudioMem.scroll_y = 0;
  scratch_reset();
  let sp = scratch_alloc(512);
  if sp >= 0 {
    buf_set_str(sp, 500, "Начат новый чистый диалог в выбранном проекте. Напишите задачу по-русски — агент видит все файлы и сохранит беседу в общую историю!");
    append_message(1, sp, 0, 0, 0);
  }
  StudioMem.auto_scroll_bottom = 0;
}

pub fn start_gemini_async() -[Mem, Net]-> unit {
  let len = input_len();
  let has_img = StudioMem.pasted_img_w > 0 && StudioMem.pasted_img_h > 0;
  if (len > 0 || has_img) && StudioMem.ai_running == 0 {
    scratch_reset();
    let sp = scratch_alloc(512);
    if len == 0 && has_img {
      if sp >= 0 {
        buf_set_str(sp, 500, "[Изображение] Проанализируй прикреплённое изображение.");
        append_message(0, sp, 0, 0, 0);
      }
    } else {
      append_message(0, StudioMem::input_buf, 0, 0, 0);
    }
    extract_active_project_to(StudioMem::active_proj_buf);
    buf_clear(StudioMem::agent_status_buf);
    StudioMem.live_timeline_words = 0;
    StudioMem.live_cmd_killing = 0;
    daemon_upload_pending_images(StudioMem.img_count);
    let ok = if sp >= 0 {
      buf_set_str(sp, 500, model_api_slug(StudioMem.model_idx));
      daemon::agent_start(StudioMem::input_buf, sp, StudioMem::active_proj_buf)
    } else {
      0
    };
    if ok > 0 {
      StudioMem.ai_running = 1;
    } else if sp >= 0 {
      buf_set_str(sp, 500, "Не удалось связаться с локальным демоном `infimum-agentd`. Запустите Infimum Code через лаунчер `infimum-code`.");
      append_message(1, sp, 0, 0, 0);
    }
    let send_img_base = clamp_i64(StudioMem.img_pending_base, 0, 16);
    let send_img_cnt = clamp_i64(StudioMem.img_count, 0, 6);
    if send_img_cnt > 0 && StudioMem.msg_count > 0 {
      let last_slot = clamp_i64(StudioMem.msg_count - 1, 0, MAX_MESSAGES - 1);
      StudioMem.msg_meta[last_slot].feedback_pack = send_img_base | (send_img_cnt << 8);
      StudioMem.img_pending_base = clamp_i64(send_img_base + send_img_cnt, 0, 16);
    }
    StudioMem.pasted_img_w = 0;
    StudioMem.pasted_img_h = 0;
    StudioMem.img_count = 0;
    StudioMem.img_preview_idx = -1;
    buf_clear(StudioMem::input_buf);
    StudioMem.cursor_pos = 0;
    StudioMem.sel_anchor = 0;
    StudioMem.in_scroll_y = 0;
    StudioMem.in_follow_cursor = 0;
    StudioMem.auto_scroll_bottom = 1;
  }
}

// --- Clipboard Export Implementations ---

pub fn handle_paste_text(ptr: i64, len: i64) -[Mem]-> i64 {
  input_delete_selection();
  let cur_len = input_len();
  let avail = clamp_i64(INPUT_MAX_CHARS - cur_len, 0, INPUT_MAX_CHARS);
  let n = clamp_i64(len, 0, CLIPBOARD_MAX_CHARS);
  let mut ins = 0;
  let mut i = 0;
  while i < n && ins < avail max 4096 {
    let cp = buf_get_cp(ptr, i);
    if cp == '\n' || cp == '\t' || cp >= ' ' { ins += 1; }
    i += 1;
  }
  if ins > 0 {
    let pos = clamp_i64(StudioMem.cursor_pos, 0, cur_len);
    let mut j = cur_len - 1;
    while j >= pos max 8192 {
      buf_set_cp(StudioMem::input_buf, j + ins, buf_get_cp(StudioMem::input_buf, j));
      j -= 1;
    }
    let mut wi = 0;
    let mut ri = 0;
    while ri < n && wi < ins max 4096 {
      let cp = buf_get_cp(ptr, ri);
      if cp == '\n' || cp >= ' ' {
        buf_set_cp(StudioMem::input_buf, pos + wi, cp);
        wi += 1;
      } else if cp == '\t' {
        buf_set_cp(StudioMem::input_buf, pos + wi, ' ');
        wi += 1;
      }
      ri += 1;
    }
    buf_set_len(StudioMem::input_buf, cur_len + ins);
    StudioMem.cursor_pos = pos + ins;
    StudioMem.sel_anchor = pos + ins;
    StudioMem.in_follow_cursor = 1;
  }
  ins
}

pub fn handle_copy_text() -[Mem]-> i64 {
  let ov = StudioMem.copy_override_ptr;
  if ov == -1 {
    StudioMem.copy_override_ptr = 0;
    buf_len(StudioMem::copy_mailbox, LARGE_COPY_MAX_CHARS)
  } else if ov > 0 {
    StudioMem.copy_override_ptr = 0;
    let n = buf_len(ov, LARGE_COPY_MAX_CHARS);
    buf_set_len(StudioMem::copy_mailbox, n);
    let mut i = 0;
    while i < n max 32768 {
      buf_set_cp(StudioMem::copy_mailbox, i, buf_get_cp(ov, i));
      i += 1;
    }
    StudioMem.copy_toast_ticks = 90;
    StudioMem.copy_toast_ptr = ov;
    n
  } else {
    let mp = StudioMem.msg_sel_ptr;
    let ma = StudioMem.msg_sel_anchor;
    let mf = StudioMem.msg_sel_focus;
    if mp > 0 && ma != mf {
      let mlen = buf_len(mp, LARGE_COPY_MAX_CHARS);
      let ca = clamp_i64(ma, 0, mlen);
      let cf = clamp_i64(mf, 0, mlen);
      let lo = min_i64(ca, cf);
      let hi = max_i64(ca, cf);
      let n = clamp_i64(hi - lo, 0, LARGE_COPY_MAX_CHARS);
      buf_set_len(StudioMem::copy_mailbox, n);
      let mut i = 0;
      while i < n max 32768 {
        buf_set_cp(StudioMem::copy_mailbox, i, buf_get_cp(mp, lo + i));
        i += 1;
      }
      StudioMem.copy_toast_ticks = 90;
      StudioMem.copy_toast_ptr = 0;
      n
    } else {
      let len = input_len();
      let c = clamp_i64(StudioMem.cursor_pos, 0, len);
      let a = clamp_i64(StudioMem.sel_anchor, 0, len);
      let lo = if c == a { 0 } else { min_i64(c, a) };
      let hi = if c == a { len } else { max_i64(c, a) };
      let n = clamp_i64(hi - lo, 0, INPUT_MAX_CHARS);
      buf_set_len(StudioMem::copy_mailbox, n);
      let mut i = 0;
      while i < n max 8192 {
        buf_set_cp(StudioMem::copy_mailbox, i, buf_get_cp(StudioMem::input_buf, lo + i));
        i += 1;
      }
      if n > 0 {
        StudioMem.copy_toast_ticks = 70;
        StudioMem.copy_toast_ptr = 0;
      }
      n
    }
  }
}

test "text_buf insert, delete, and 2D line wrap work" {
  buf_clear(StudioMem::input_buf);
  StudioMem.cursor_pos = 0;
  StudioMem.sel_anchor = 0;
  input_insert_char('H');
  input_insert_char('i');
  input_insert_char('\n');
  input_insert_char('!');
  assert(input_len() == 4);
  assert(measure_input_lines(200, 16) == 2);
  input_delete_range(1, 3);
  assert(input_len() == 2);
  assert(measure_input_lines(200, 16) == 1);
}
