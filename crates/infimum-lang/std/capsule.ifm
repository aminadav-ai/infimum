// Infimum Standard Library: std/capsule.ifm
// Unified Headless B2B Capsule ABI (CAPSULE_ABI_VERSION = 1).
// Importing this module alongside `export fn cap_execute(in_len: i64) -> i64`
// automatically exports the 7 `ifw_cap_*` / `ifw_capsule_abi_version` ABI probes.

pub const CAPSULE_ABI_VERSION: i64 = 1;
pub const CAP_MAX_INPUT_BYTES: i64 = 65536;
pub const CAP_MAX_OUTPUT_BYTES: i64 = 65536;
pub const CAP_MAX_SECRET_BYTES: i64 = 4096;

// Private layout: user capsules MUST access I/O buffers via `cap_input`, `cap_output_buf`,
// `cap_read_secret` (which enforces `Secret<str>` taint tracking), and `cap_finish`.
layout CapsuleIo {
  input_buf:  bytes[65536],
  output_buf: bytes[65536],
  secret_buf: bytes[4096],
  err_code:   word,
}

/// Return a bounded `[u8]` view of the host-provided input JSON (`0..=65536`).
pub fn cap_input(in_len: i64) -[Mem]-> [u8]
  ens result.len >= 0 && result.len <= CAP_MAX_INPUT_BYTES
{
  let n = if in_len < 0 {
    0
  } else if in_len > CAP_MAX_INPUT_BYTES {
    CAP_MAX_INPUT_BYTES
  } else {
    in_len
  };
  CapsuleIo.input_buf[0..n]
}

/// Return the full 64 KiB `[u8]` output buffer for writing response JSON.
pub fn cap_output_buf() -[Mem]-> [u8]
  ens result.len == CAP_MAX_OUTPUT_BYTES
{
  CapsuleIo.output_buf[0..CAP_MAX_OUTPUT_BYTES]
}

/// Read the Zero-Trust Vault secret injected into `CapsuleIo.secret_buf` as a taint-tracked `Secret<str>`.
/// The compiler statically forbids leaking `Secret<str>` to `output_buf` or unauthorized domains.
pub fn cap_read_secret(secret_len: i64) -[Mem]-> Secret<str> {
  let n = if secret_len < 0 {
    0
  } else if secret_len > CAP_MAX_SECRET_BYTES {
    CAP_MAX_SECRET_BYTES
  } else {
    secret_len
  };
  secret(CapsuleIo.secret_buf[0..n].as_str())
}

/// Finalize a `cap_execute` handler result:
/// - `Ok(out_len)` -> stores `CapsuleIo.err_code = 0`, returns `out_len` (`>= 0`).
/// - `Err(code)` -> stores `CapsuleIo.err_code = code`, returns `-abs(code)` (`< 0`).
pub fn cap_finish(res: Result<i64, i64>) -[Mem]-> i64 {
  match res {
    Ok(out_len) => {
      CapsuleIo.err_code = 0;
      if out_len < 0 { 0 } else if out_len > CAP_MAX_OUTPUT_BYTES { CAP_MAX_OUTPUT_BYTES } else { out_len }
    }
    Err(code) => {
      let c = if code == 0 { 1 } else if code < 0 { -code } else { code };
      CapsuleIo.err_code = c;
      -c
    }
  }
}
