// Infimum Standard Library: std/markdown.ifm
// Full GFM Rich Markdown Layout, Hit-Test & Render Engine:
//   headings (#..####), bold (**), inline code pills (`), fenced code blocks (```),
//   GFM pipe tables (|...|), blockquotes (>), bullet & numbered lists, HR, word-wrapping,
//   selection highlighting, and pixel-exact hit-testing.
// Guarantees 100% pixel parity across:
//   mode 0 = measure height only
//   mode 1 = hit-test (mx, my) -> raw char index
//   mode 2 = render formatted Markdown + selection highlight [sel_lo_i, sel_hi_i)

use "std/math.ifm";
use "std/color.ifm";
use "std/sys_mem.ifm";
use "std/mem.ifm";
use "std/gfx.ifm";
use "std/text.ifm";
use "std/theme.ifm";

pub const MD_MAX_TBL_COLS: i64 = 12;

pub struct MdStep {
  cy: i64,
  hit_found: i64,
  hit_idx: i64,
}

pub struct MdTableStep {
  cy: i64,
  end_i: i64,
  hit_found: i64,
  hit_idx: i64,
}

pub fn md_find_backtick(ptr: i64, start: i64, le: i64) -[Mem]-> i64 {
  let mut res = -1;
  for k in start..le max 512 {
    if mem_load(ptr + 1 + k) == '`' {
      res = k;
      break;
    }
  }
  res
}

pub fn md_has_closing_bold(ptr: i64, start: i64, le: i64) -[Mem]-> bool {
  let mut ok = false;
  for k in start..(le - 1) max 512 {
    if mem_load(ptr + 1 + k) == '*' && mem_load(ptr + 1 + k + 1) == '*' {
      ok = true;
      break;
    }
  }
  ok
}

pub fn md_measure_word(ptr: i64, start: i64, le: i64, sz: i64, style: i64) -[Mem]-> i64 {
  let mut w = 0;
  for k in start..le max 96 {
    let ch = mem_load(ptr + 1 + k);
    if ch == ' ' || ch == '`' { break; }
    if ch == '*' && k + 1 < le && mem_load(ptr + 1 + k + 1) == '*' { break; }
    w += glyph_px(ch, sz, style);
  }
  w
}

pub fn md_draw_quote_strip(mode: i64, is_quote: bool, q_x: i64, cy: i64, q_w: i64, lh: i64, th: i64, clip: i64, vis_y0: i64, vis_y1: i64) -[Mem]-> unit {
  if mode == 2 && is_quote && cy + lh >= vis_y0 && cy <= vis_y1 {
    ui_rect(q_x, cy - 2, q_w, lh + 2, 2, 0, 0, theme_surf(th), 0, clip);
    ui_rect(q_x, cy - 2, 3, lh + 2, 1, 0, 0, theme_accent(), 0, clip);
  }
}

pub fn md_inline_line(
  mode: i64, mx: i64, my: i64,
  bx: i64, by: i64, bw: i64,
  ptr: i64, start: i64, le: i64,
  sz: i64, lh: i64, base_style: i64, base_col: i64,
  th: i64, clip: i64, vis_y0: i64, vis_y1: i64,
  sel_lo_i: i64, sel_hi_i: i64,
  is_quote: bool, q_x: i64, q_w: i64
) -[Mem]-> MdStep {
  let has_sel = sel_hi_i > sel_lo_i;
  let sel_bg = pack_rgba(59, 130, 246, 115);
  let code_sz = clamp_i64(sz - 1, 10, 38);
  let mut cx = bx;
  let mut cy = by;
  let mut i = start;
  let mut in_bold = false;
  let mut hit_found = 0;
  let mut hit_idx = 0;

  md_draw_quote_strip(mode, is_quote, q_x, cy, q_w, lh, th, clip, vis_y0, vis_y1);

  while i < le max 4096 {
    if mode == 1 && hit_found == 1 {
      break;
    } else if mode == 1 && cy > my {
      hit_idx = i;
      hit_found = 1;
      break;
    }
    let ch = mem_load(ptr + 1 + i);
    if ch == '*' && i + 1 < le && mem_load(ptr + 1 + i + 1) == '*' && (in_bold || md_has_closing_bold(ptr, i + 2, le)) {
      in_bold = !in_bold;
      i += 2;
    } else {
      let end_bt = if ch == '`' { md_find_backtick(ptr, i + 1, le) } else { -1 };
      if ch == '`' && end_bt > i {
        let mut k = i + 1;
        let mut full_w = 0;
        for mk in k..end_bt max 128 {
          full_w += glyph_px(mem_load(ptr + 1 + mk), code_sz, 2);
        }
        if cx > bx && full_w + 10 <= bw && cx + full_w + 10 > bx + bw {
          if mode == 1 && my >= cy && my < cy + lh {
            hit_idx = k;
            hit_found = 1;
          } else {
            cx = bx;
            cy += lh;
            md_draw_quote_strip(mode, is_quote, q_x, cy, q_w, lh, th, clip, vis_y0, vis_y1);
          }
        }

        while k < end_bt max 512 {
          if mode == 1 && hit_found == 1 { break; }
          let mut ce = k;
          let mut cw = 0;
          let avail = clamp_i64((bx + bw) - cx - 10, 24, 4000);
          while ce < end_bt max 256 {
            let ca = glyph_px(mem_load(ptr + 1 + ce), code_sz, 2);
            if ce > k && cw + ca > avail { break; }
            cw += ca;
            ce += 1;
          }
          if mode == 2 && cy + lh >= vis_y0 && cy <= vis_y1 {
            ui_rect(cx, cy - 2, cw + 10, sz + 5, 5, 1, 0, theme_code_pill(th), theme_border(th), clip);
          }
          cx += 5;
          for ck in k..ce max 256 {
            let cch = mem_load(ptr + 1 + ck);
            let cadv = glyph_px(cch, code_sz, 2);
            if mode == 1 && hit_found == 0 && my >= cy && my < cy + lh && mx < cx + cadv / 2 {
              hit_idx = ck;
              hit_found = 1;
            }
            if mode == 2 && cy + lh >= vis_y0 && cy <= vis_y1 {
              if has_sel && ck >= sel_lo_i && ck < sel_hi_i {
                ui_rect(cx, cy - 1, cadv, sz + 4, 0, 0, 0, sel_bg, 0, clip);
              }
              ui_glyph(cx, cy + 1, cch, code_sz, 2, theme_code_text(th), clip);
            }
            cx += cadv;
          }
          cx += 5;
          k = ce;
          if k < end_bt && !(mode == 1 && hit_found == 1) {
            if mode == 1 && my >= cy && my < cy + lh {
              hit_idx = k;
              hit_found = 1;
            } else {
              cx = bx;
              cy += lh;
              md_draw_quote_strip(mode, is_quote, q_x, cy, q_w, lh, th, clip, vis_y0, vis_y1);
            }
          }
        }
        i = end_bt + 1;
      } else {
        let cur_style = if in_bold || base_style == 1 { 1 } else { 0 };
        let cur_col = if in_bold { theme_heading(th) } else { base_col };
        if ch == ' ' {
          let sp = glyph_px(' ', sz, cur_style);
          if cx > bx && cx + sp <= bx + bw {
            if mode == 1 && my >= cy && my < cy + lh && mx < cx + sp / 2 {
              hit_idx = i;
              hit_found = 1;
            } else {
              if mode == 2 && has_sel && i >= sel_lo_i && i < sel_hi_i && cy + lh >= vis_y0 && cy <= vis_y1 {
                ui_rect(cx, cy - 1, sp, sz + 5, 0, 0, 0, sel_bg, 0, clip);
              }
              cx += sp;
            }
          } else if mode == 1 && my >= cy && my < cy + lh && mx < cx {
            hit_idx = i;
            hit_found = 1;
          }
          i += 1;
        } else {
          let ww = md_measure_word(ptr, i, le, sz, cur_style);
          if cx > bx && cx + ww > bx + bw {
            if mode == 1 && my >= cy && my < cy + lh {
              hit_idx = i;
              hit_found = 1;
            } else {
              cx = bx;
              cy += lh;
              md_draw_quote_strip(mode, is_quote, q_x, cy, q_w, lh, th, clip, vis_y0, vis_y1);
            }
          }
          let mut steps_w = 0;
          while i < le && steps_w < 96 max 96 {
            if mode == 1 && hit_found == 1 { break; }
            let c2 = mem_load(ptr + 1 + i);
            if c2 == ' ' || c2 == '`' { break; }
            if steps_w > 0 && c2 == '*' && i + 1 < le && mem_load(ptr + 1 + i + 1) == '*' { break; }
            let adv = glyph_px(c2, sz, cur_style);
            if cx > bx && cx + adv > bx + bw {
              if mode == 1 && my >= cy && my < cy + lh {
                hit_idx = i;
                hit_found = 1;
                break;
              } else {
                cx = bx;
                cy += lh;
                md_draw_quote_strip(mode, is_quote, q_x, cy, q_w, lh, th, clip, vis_y0, vis_y1);
              }
            }
            if mode == 1 && my >= cy && my < cy + lh && mx < cx + adv / 2 {
              hit_idx = i;
              hit_found = 1;
              break;
            }
            if mode == 2 && cy + lh >= vis_y0 && cy <= vis_y1 {
              if has_sel && i >= sel_lo_i && i < sel_hi_i {
                ui_rect(cx, cy - 1, adv, sz + 5, 0, 0, 0, sel_bg, 0, clip);
              }
              ui_glyph(cx, cy, c2, sz, cur_style, cur_col, clip);
            }
            cx += adv;
            i += 1;
            steps_w += 1;
          }
        }
      }
    }
  }
  if mode == 1 && hit_found == 0 && my >= cy && my < cy + lh {
    hit_idx = le;
    hit_found = 1;
  }
  MdStep { cy: cy + lh, hit_found: hit_found, hit_idx: hit_idx }
}

// --- GFM Pipe Table Layout, Hit-Test & Render Engine ---

pub fn md_find_line_end(ptr: i64, start: i64, n: i64) -[Mem]-> i64 {
  let mut k = start;
  while k < n && mem_load(ptr + 1 + k) != '\n' max 4096 {
    k += 1;
  }
  k
}

pub fn md_line_has_pipe(ptr: i64, ls: i64, le: i64) -[Mem]-> bool {
  let mut found = false;
  for k in ls..le max 1024 {
    if mem_load(ptr + 1 + k) == '|' {
      found = true;
      break;
    }
  }
  found
}

pub fn md_is_table_sep(ptr: i64, ls: i64, le: i64) -[Mem]-> bool {
  let mut s = ls;
  while s < le && (mem_load(ptr + 1 + s) == ' ' || mem_load(ptr + 1 + s) == '\t' || mem_load(ptr + 1 + s) == '\r') max 64 {
    s += 1;
  }
  let mut e = le;
  while e > s && (mem_load(ptr + 1 + e - 1) == ' ' || mem_load(ptr + 1 + e - 1) == '\t' || mem_load(ptr + 1 + e - 1) == '\r') max 64 {
    e -= 1;
  }
  if s >= e {
    false
  } else {
    let mut k = s;
    let mut pipes = 0;
    let mut dashes = 0;
    let mut cell_dashes = 0;
    let mut in_cell = false;
    let mut ok = true;
    if mem_load(ptr + 1 + k) == '|' {
      pipes += 1;
      k += 1;
    }
    if e > k && mem_load(ptr + 1 + e - 1) == '|' {
      pipes += 1;
      e -= 1;
    }
    while k < e && ok max 512 {
      let ch = mem_load(ptr + 1 + k);
      if ch == '|' {
        pipes += 1;
        if cell_dashes == 0 { ok = false; }
        cell_dashes = 0;
        in_cell = false;
      } else if ch == '-' {
        dashes += 1;
        cell_dashes += 1;
        in_cell = true;
      } else if ch == ':' || ch == ' ' || ch == '\t' {
        if ch == ':' { in_cell = true; }
      } else {
        ok = false;
      }
      k += 1;
    }
    if in_cell && cell_dashes == 0 { ok = false; }
    ok && pipes >= 1 && dashes >= 1
  }
}

pub fn md_is_table_body_line(ptr: i64, ls: i64, le: i64) -[Mem]-> bool {
  let mut p = ls;
  while p < le && (mem_load(ptr + 1 + p) == ' ' || mem_load(ptr + 1 + p) == '\t' || mem_load(ptr + 1 + p) == '\r') max 64 {
    p += 1;
  }
  if p >= le {
    false
  } else if p + 2 < le && mem_load(ptr + 1 + p) == '`' && mem_load(ptr + 1 + p + 1) == '`' && mem_load(ptr + 1 + p + 2) == '`' {
    false
  } else {
    md_line_has_pipe(ptr, p, le)
  }
}

pub fn md_store_trimmed_cell(scratch: i64, ptr: i64, c: i64, raw_s: i64, raw_e: i64) -[Mem]-> unit {
  let mut cs = raw_s;
  while cs < raw_e && (mem_load(ptr + 1 + cs) == ' ' || mem_load(ptr + 1 + cs) == '\t' || mem_load(ptr + 1 + cs) == '\r') max 64 {
    cs += 1;
  }
  let mut ce = raw_e;
  while ce > cs && (mem_load(ptr + 1 + ce - 1) == ' ' || mem_load(ptr + 1 + ce - 1) == '\t' || mem_load(ptr + 1 + ce - 1) == '\r') max 64 {
    ce -= 1;
  }
  mem_store(scratch + 64 + c, cs);
  mem_store(scratch + 80 + c, ce);
}

pub fn md_parse_table_row(scratch: i64, ptr: i64, ls: i64, le: i64) -[Mem]-> i64 {
  let mut s = ls;
  while s < le && (mem_load(ptr + 1 + s) == ' ' || mem_load(ptr + 1 + s) == '\t' || mem_load(ptr + 1 + s) == '\r') max 64 {
    s += 1;
  }
  let mut e = le;
  while e > s && (mem_load(ptr + 1 + e - 1) == ' ' || mem_load(ptr + 1 + e - 1) == '\t' || mem_load(ptr + 1 + e - 1) == '\r') max 64 {
    e -= 1;
  }
  if s < e && mem_load(ptr + 1 + s) == '|' {
    s += 1;
  }
  if e > s && mem_load(ptr + 1 + e - 1) == '|' {
    let escaped_end = e - 2 >= s && mem_load(ptr + 1 + e - 2) == '\\';
    if !escaped_end {
      e -= 1;
    }
  }
  let mut c = 0;
  let mut cur_s = s;
  let mut k = s;
  let mut in_bt = false;
  while k < e max 1024 {
    let ch = mem_load(ptr + 1 + k);
    if ch == '`' {
      in_bt = !in_bt;
    } else if ch == '|' && !in_bt && c + 1 < MD_MAX_TBL_COLS {
      let escaped = k > s && mem_load(ptr + 1 + k - 1) == '\\';
      if !escaped {
        md_store_trimmed_cell(scratch, ptr, c, cur_s, k);
        c += 1;
        cur_s = k + 1;
      }
    }
    k += 1;
  }
  if c < MD_MAX_TBL_COLS {
    md_store_trimmed_cell(scratch, ptr, c, cur_s, e);
    c += 1;
  }
  for fill in c..MD_MAX_TBL_COLS max 12 {
    mem_store(scratch + 64 + fill, le);
    mem_store(scratch + 80 + fill, le);
  }
  clamp_i64(c, 1, MD_MAX_TBL_COLS)
}

pub fn md_measure_inline_span(ptr: i64, cs: i64, ce: i64, sz: i64, base_style: i64) -[Mem]-> i64 {
  let code_sz = clamp_i64(sz - 1, 10, 38);
  let mut w = 0;
  let mut k = cs;
  let mut in_bold = false;
  while k < ce max 512 {
    let ch = mem_load(ptr + 1 + k);
    if ch == '*' && k + 1 < ce && mem_load(ptr + 1 + k + 1) == '*' && (in_bold || md_has_closing_bold(ptr, k + 2, ce)) {
      in_bold = !in_bold;
      k += 2;
    } else {
      let end_bt = if ch == '`' { md_find_backtick(ptr, k + 1, ce) } else { -1 };
      if ch == '`' && end_bt > k {
        w += 10;
        let mut mk = k + 1;
        while mk < end_bt max 128 {
          w += glyph_px(mem_load(ptr + 1 + mk), code_sz, 2);
          mk += 1;
        }
        k = end_bt + 1;
      } else {
        let st = if in_bold || base_style == 1 { 1 } else { 0 };
        w += glyph_px(ch, sz, st);
        k += 1;
      }
    }
  }
  w
}

pub fn md_render_table_row(
  scratch: i64,
  mode: i64, mx: i64, my: i64,
  x: i64, cy: i64, tbl_w: i64, tbl_cols: i64,
  ptr: i64, r_ls: i64, r_le: i64,
  tbl_sz: i64, tbl_lh: i64, pad_x: i64, pad_y: i64,
  is_header: bool, row_idx: i64,
  th: i64, clip: i64, vis_y0: i64, vis_y1: i64,
  sel_lo_i: i64, sel_hi_i: i64
) -[Mem]-> MdStep {
  md_parse_table_row(scratch, ptr, r_ls, r_le);
  let row_style = if is_header { 1 } else { 0 };
  let row_col = if is_header { theme_heading(th) } else { theme_text(th) };

  let mut max_cell_h = tbl_lh;
  for c in 0..tbl_cols max 12 {
    let cs = mem_load(scratch + 64 + c);
    let ce = mem_load(scratch + 80 + c);
    if ce > cs {
      let cw = mem_load(scratch + 16 + c);
      let inner_w = clamp_i64(cw - pad_x * 2, 20, 4000);
      let st = md_inline_line(0, 0, 0, 0, 0, inner_w, ptr, cs, ce, tbl_sz, tbl_lh, row_style, row_col, th, clip, 0, 0, 0, 0, false, 0, 0);
      if st.cy > max_cell_h { max_cell_h = st.cy; }
    }
  }
  let row_h = max_cell_h + pad_y * 2;
  let mut hit_found = 0;
  let mut hit_idx = 0;

  if mode == 1 {
    if my < cy {
      hit_idx = r_ls;
      hit_found = 1;
    } else if my >= cy && my < cy + row_h {
      if mx < x {
        hit_idx = mem_load(scratch + 64);
        hit_found = 1;
      } else if mx >= x + tbl_w {
        hit_idx = mem_load(scratch + 80 + tbl_cols - 1);
        hit_found = 1;
      } else {
        for hc in 0..tbl_cols max 12 {
          if hit_found == 1 { break; }
          let cx0 = x + mem_load(scratch + 32 + hc);
          let cw = mem_load(scratch + 16 + hc);
          if mx >= cx0 && mx < cx0 + cw {
            let cs = mem_load(scratch + 64 + hc);
            let ce = mem_load(scratch + 80 + hc);
            let inner_w = clamp_i64(cw - pad_x * 2, 20, 4000);
            if ce > cs {
              let st = md_inline_line(1, mx, my, cx0 + pad_x, cy + pad_y, inner_w, ptr, cs, ce, tbl_sz, tbl_lh, row_style, row_col, th, clip, vis_y0, vis_y1, 0, 0, false, 0, 0);
              if st.hit_found == 1 {
                hit_found = 1;
                hit_idx = st.hit_idx;
              }
            }
            if hit_found == 0 {
              hit_idx = ce;
              hit_found = 1;
            }
          }
        }
        if hit_found == 0 {
          hit_idx = r_le;
          hit_found = 1;
        }
      }
    }
  } else if mode == 2 && cy + row_h >= vis_y0 && cy <= vis_y1 {
    let row_bg = if is_header {
      theme_surf2(th)
    } else if (row_idx % 2) == 0 {
      theme_surf(th)
    } else {
      theme_side(th)
    };
    let bcol = theme_border(th);
    ui_rect(x, cy, tbl_w, row_h, 0, 0, 0, row_bg, 0, clip);
    if is_header {
      ui_rect(x, cy, tbl_w, 1, 0, 0, 0, bcol, 0, clip);
      ui_rect(x, cy + row_h - 2, tbl_w, 2, 0, 0, 0, bcol, 0, clip);
    } else {
      ui_rect(x, cy + row_h - 1, tbl_w, 1, 0, 0, 0, bcol, 0, clip);
    }
    ui_rect(x, cy, 1, row_h, 0, 0, 0, bcol, 0, clip);
    ui_rect(x + tbl_w - 1, cy, 1, row_h, 0, 0, 0, bcol, 0, clip);

    for dc in 1..tbl_cols max 12 {
      ui_rect(x + mem_load(scratch + 32 + dc), cy, 1, row_h, 0, 0, 0, bcol, 0, clip);
    }

    for rc in 0..tbl_cols max 12 {
      let cs = mem_load(scratch + 64 + rc);
      let ce = mem_load(scratch + 80 + rc);
      if ce > cs {
        let cx0 = x + mem_load(scratch + 32 + rc);
        let cw = mem_load(scratch + 16 + rc);
        let inner_w = clamp_i64(cw - pad_x * 2, 20, 4000);
        md_inline_line(2, mx, my, cx0 + pad_x, cy + pad_y, inner_w, ptr, cs, ce, tbl_sz, tbl_lh, row_style, row_col, th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, false, 0, 0);
      }
    }
  }
  MdStep { cy: cy + row_h, hit_found: hit_found, hit_idx: hit_idx }
}

pub fn md_layout_table(
  mode: i64, mx: i64, my: i64,
  x: i64, y_start: i64, cur_y: i64, max_w: i64,
  ptr: i64, n: i64, hdr_ls: i64, hdr_le: i64, sep_next_i: i64,
  body_sz: i64, line_h: i64,
  th: i64, clip: i64, vis_y0: i64, vis_y1: i64,
  sel_lo_i: i64, sel_hi_i: i64
) -[Mem]-> MdTableStep {
  let scratch_raw = scratch_alloc(128);
  let scratch = if scratch_raw >= 0 { scratch_raw } else { SYS_SCRATCH_BASE_WORD };
  let safe_max_w = clamp_i64(max_w, 64, 4000);
  let tbl_sz = clamp_i64(body_sz - 1, 11, 36);
  let tbl_lh = clamp_i64(line_h - 2, 16, 52);
  let pad_x = 12;
  let pad_y = 7;

  // Pass 1: Determine column count, natural column widths, and table end offset
  let tbl_cols = clamp_i64(md_parse_table_row(scratch, ptr, hdr_ls, hdr_le), 1, MD_MAX_TBL_COLS);
  for c in 0..tbl_cols max 12 {
    let cs = mem_load(scratch + 64 + c);
    let ce = mem_load(scratch + 80 + c);
    mem_store(scratch + c, md_measure_inline_span(ptr, cs, ce, tbl_sz, 1));
  }

  let mut scan_i = sep_next_i;
  for _scan_r in 0..256 max 256 {
    if scan_i >= n { break; }
    let r_le = md_find_line_end(ptr, scan_i, n);
    if !md_is_table_body_line(ptr, scan_i, r_le) { break; }
    md_parse_table_row(scratch, ptr, scan_i, r_le);
    for sc in 0..tbl_cols max 12 {
      let cs = mem_load(scratch + 64 + sc);
      let ce = mem_load(scratch + 80 + sc);
      let cw = md_measure_inline_span(ptr, cs, ce, tbl_sz, 0);
      if cw > mem_load(scratch + sc) {
        mem_store(scratch + sc, cw);
      }
    }
    scan_i = if r_le < n { r_le + 1 } else { n };
  }
  let tbl_end_i = scan_i;

  // Compute content-aware column widths fitting within safe_max_w
  let max_even = clamp_i64(safe_max_w / tbl_cols, 1, safe_max_w);
  let min_col_w = if max_even < 68 { max_even } else { 68 };
  let mut total_desired = 0;
  for dc in 0..tbl_cols max 12 {
    let des = clamp_i64(mem_load(scratch + dc) + pad_x * 2, min_col_w, safe_max_w);
    mem_store(scratch + dc, des);
    total_desired += des;
  }

  if total_desired <= safe_max_w {
    for fc in 0..tbl_cols max 12 {
      mem_store(scratch + 16 + fc, mem_load(scratch + fc));
    }
  } else {
    let fair_w = safe_max_w / tbl_cols;
    let mut narrow_sum = 0;
    let mut wide_sum = 0;
    for sc2 in 0..tbl_cols max 12 {
      let des = mem_load(scratch + sc2);
      if des <= fair_w { narrow_sum += des; } else { wide_sum += des; }
    }
    let rem_w = clamp_i64(safe_max_w - narrow_sum, min_col_w, safe_max_w);
    let safe_wide = if wide_sum > 0 { wide_sum } else { 1 };
    let mut used_w = 0;
    let mut widest_c = 0;
    let mut widest_w = 0;
    for ac in 0..tbl_cols max 12 {
      let des = mem_load(scratch + ac);
      let w_col = if des <= fair_w {
        des
      } else {
        clamp_i64((rem_w * des) / safe_wide, min_col_w, rem_w)
      };
      mem_store(scratch + 16 + ac, w_col);
      used_w += w_col;
      if w_col > widest_w {
        widest_w = w_col;
        widest_c = ac;
      }
    }
    let diff = safe_max_w - used_w;
    if diff != 0 {
      let adj = clamp_i64(mem_load(scratch + 16 + widest_c) + diff, min_col_w, safe_max_w);
      mem_store(scratch + 16 + widest_c, adj);
    }
  }

  let mut acc_x = 0;
  for xc in 0..tbl_cols max 12 {
    mem_store(scratch + 32 + xc, acc_x);
    acc_x += mem_load(scratch + 16 + xc);
  }
  let tbl_w = clamp_i64(acc_x, min_col_w, safe_max_w);

  // Pass 2: Layout / Hit-Test / Render header and body rows
  let mut cy = cur_y;
  if cy > y_start { cy += 6; }
  let hdr_st = md_render_table_row(scratch, mode, mx, my, x, cy, tbl_w, tbl_cols, ptr, hdr_ls, hdr_le, tbl_sz, tbl_lh, pad_x, pad_y, true, 0, th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i);
  cy = hdr_st.cy;
  let mut hit_found = hdr_st.hit_found;
  let mut hit_idx = hdr_st.hit_idx;

  let mut ri = sep_next_i;
  for r_idx in 0..256 max 256 {
    if ri >= tbl_end_i || (mode == 1 && hit_found == 1) { break; }
    let r_le = md_find_line_end(ptr, ri, n);
    let rst = md_render_table_row(scratch, mode, mx, my, x, cy, tbl_w, tbl_cols, ptr, ri, r_le, tbl_sz, tbl_lh, pad_x, pad_y, false, r_idx, th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i);
    cy = rst.cy;
    if rst.hit_found == 1 {
      hit_found = 1;
      hit_idx = rst.hit_idx;
    }
    ri = if r_le < n { r_le + 1 } else { n };
  }
  MdTableStep { cy: cy + 8, end_i: tbl_end_i, hit_found: hit_found, hit_idx: hit_idx }
}

pub fn md_layout(
  mode: i64, mx: i64, my: i64,
  x: i64, y: i64, max_w: i64,
  ptr: i64, max_cap: i64, body_sz: i64, line_h: i64,
  th: i64, clip: i64, vis_y0: i64, vis_y1: i64,
  sel_lo_i: i64, sel_hi_i: i64
) -[Mem]-> i64 {
  let cap = clamp_i64(max_cap, 1, 32768);
  let n = clamp_i64(mem_load(ptr), 0, cap);
  let has_sel = sel_hi_i > sel_lo_i;
  let sel_bg = pack_rgba(59, 130, 246, 115);
  let code_sz = clamp_i64(body_sz - 2, 10, 34);
  let code_lh = clamp_i64(line_h - 3, 15, 48);
  let mut hit_found = if mode == 1 && my < y { 1 } else { 0 };
  let mut hit_idx = if mode == 1 && my < y { 0 } else { n };

  let mut cy = y;
  let mut i = 0;
  let mut in_fence = false;

  while i < n max 4096 {
    if mode == 1 && hit_found == 1 { break; }
    let ls = i;
    let mut le = ls;
    while le < n && mem_load(ptr + 1 + le) != '\n' max 4096 {
      le += 1;
    }
    let next_i = if le < n { le + 1 } else { n };
    let mut adv_i = next_i;

    let mut lead_sp = 0;
    let mut p = ls;
    while p < le && mem_load(ptr + 1 + p) == ' ' && lead_sp < 12 max 12 {
      lead_sp += 1;
      p += 1;
    }

    // 1. Fenced code block delimiter ```
    let is_fence = p + 2 < le
      && mem_load(ptr + 1 + p) == '`'
      && mem_load(ptr + 1 + p + 1) == '`'
      && mem_load(ptr + 1 + p + 2) == '`';
    if is_fence {
      if !in_fence {
        in_fence = true;
        if cy > y { cy += 4; }
        if mode == 2 && cy + 10 >= vis_y0 && cy <= vis_y1 {
          ui_rect(x, cy, max_w, 10, 6, 1, 0, theme_code_bg(th), theme_border(th), clip);
          ui_rect(x + 1, cy + 5, max_w - 2, 6, 0, 0, 0, theme_code_bg(th), 0, clip);
        }
        cy += 8;
      } else {
        in_fence = false;
        if mode == 2 && cy + 10 >= vis_y0 && cy <= vis_y1 {
          ui_rect(x, cy - 2, max_w, 10, 6, 1, 0, theme_code_bg(th), theme_border(th), clip);
          ui_rect(x + 1, cy - 2, max_w - 2, 5, 0, 0, 0, theme_code_bg(th), 0, clip);
        }
        cy += 12;
      }
      if mode == 1 && hit_found == 0 && my < cy {
        hit_idx = ls;
        hit_found = 1;
      }
    } else if in_fence {
      let cbx = x + 12;
      let cbw = clamp_i64(max_w - 24, 60, 4000);
      let mut cx = cbx;
      if mode == 2 && cy + code_lh >= vis_y0 && cy <= vis_y1 {
        ui_rect(x, cy - 1, max_w, code_lh + 2, 0, 0, 0, theme_code_bg(th), 0, clip);
        ui_rect(x, cy - 1, 1, code_lh + 2, 0, 0, 0, theme_border(th), 0, clip);
        ui_rect(x + max_w - 1, cy - 1, 1, code_lh + 2, 0, 0, 0, theme_border(th), 0, clip);
      }
      for k in ls..le max 1024 {
        if mode == 1 && hit_found == 1 { break; }
        let ch_c = mem_load(ptr + 1 + k);
        let adv_c = glyph_px(ch_c, code_sz, 2);
        if cx > cbx && cx + adv_c > cbx + cbw {
          if mode == 1 && my >= cy && my < cy + code_lh {
            hit_idx = k;
            hit_found = 1;
            break;
          } else {
            cx = cbx;
            cy += code_lh;
            if mode == 2 && cy + code_lh >= vis_y0 && cy <= vis_y1 {
              ui_rect(x, cy - 1, max_w, code_lh + 2, 0, 0, 0, theme_code_bg(th), 0, clip);
              ui_rect(x, cy - 1, 1, code_lh + 2, 0, 0, 0, theme_border(th), 0, clip);
              ui_rect(x + max_w - 1, cy - 1, 1, code_lh + 2, 0, 0, 0, theme_border(th), 0, clip);
            }
          }
        }
        if mode == 1 && my >= cy && my < cy + code_lh && mx < cx + adv_c / 2 {
          hit_idx = k;
          hit_found = 1;
          break;
        }
        if mode == 2 && cy + code_lh >= vis_y0 && cy <= vis_y1 {
          if has_sel && k >= sel_lo_i && k < sel_hi_i {
            ui_rect(cx, cy - 1, adv_c, code_sz + 4, 0, 0, 0, sel_bg, 0, clip);
          }
          ui_glyph(cx, cy, ch_c, code_sz, 2, theme_code_text(th), clip);
        }
        cx += adv_c;
      }
      if mode == 1 && hit_found == 0 && my >= cy && my < cy + code_lh {
        hit_idx = le;
        hit_found = 1;
      }
      cy += code_lh;
    } else if p == le {
      // 2. Blank / whitespace-only line
      let gap = clamp_i64(line_h / 2, 8, 22);
      if mode == 1 && hit_found == 0 && my >= cy && my < cy + gap {
        hit_idx = ls;
        hit_found = 1;
      }
      cy += gap;
    } else {
      // 3. GFM Pipe Table (header row with `|` followed by separator row `|---|---|`)
      let mut is_tbl = false;
      let mut sep_next_i = next_i;
      if next_i < n && md_line_has_pipe(ptr, p, le) {
        let sep_le = md_find_line_end(ptr, next_i, n);
        if md_is_table_sep(ptr, next_i, sep_le) {
          is_tbl = true;
          sep_next_i = if sep_le < n { sep_le + 1 } else { n };
        }
      }

      if is_tbl {
        let tst = md_layout_table(mode, mx, my, x, y, cy, max_w, ptr, n, ls, le, sep_next_i, body_sz, line_h, th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i);
        cy = tst.cy;
        adv_i = tst.end_i;
        if tst.hit_found == 1 {
          hit_found = 1;
          hit_idx = tst.hit_idx;
        }
      } else {
        // 4. Horizontal Rule (`---`, `***`, `___`)
        let c0 = mem_load(ptr + 1 + p);
        let mut is_hr = (c0 == '-' || c0 == '*' || c0 == '_') && (le - p >= 3);
        if is_hr {
          let mut hcnt = 0;
          for hk in p..le max 64 {
            let hc = mem_load(ptr + 1 + hk);
            if hc == c0 { hcnt += 1; } else if hc != ' ' { is_hr = false; break; }
          }
          if hcnt < 3 { is_hr = false; }
        }

        if is_hr {
          let hr_h = clamp_i64((line_h * 3) / 4, 14, 30);
          if mode == 2 && cy + hr_h >= vis_y0 && cy <= vis_y1 {
            ui_rect(x, cy + hr_h / 2, max_w, 1, 0, 0, 0, theme_border(th), 0, clip);
          }
          if mode == 1 && hit_found == 0 && my >= cy && my < cy + hr_h {
            hit_idx = ls;
            hit_found = 1;
          }
          cy += hr_h;
        } else {
          // 5. Headings (`# `, `## `, `### `, `#### `)
          let mut hashes = 0;
          while p + hashes < le && mem_load(ptr + 1 + p + hashes) == '#' && hashes < 5 max 5 {
            hashes += 1;
          }
          if hashes >= 1 && hashes <= 4 && p + hashes < le && mem_load(ptr + 1 + p + hashes) == ' ' {
            if cy > y { cy += 6; }
            let h_sz = if hashes == 1 { clamp_i64(body_sz + 5, 14, 42) }
              else if hashes == 2 { clamp_i64(body_sz + 3, 13, 40) }
              else { clamp_i64(body_sz + 1, 12, 38) };
            let h_lh = h_sz + clamp_i64(line_h - body_sz + 2, 6, 16);
            let st = md_inline_line(mode, mx, my, x, cy, max_w, ptr, p + hashes + 1, le, h_sz, h_lh, 1, theme_heading(th), th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, false, x, max_w);
            cy = st.cy + 3;
            if st.hit_found == 1 { hit_found = 1; hit_idx = st.hit_idx; }
          } else if c0 == '>' && (p + 1 == le || mem_load(ptr + 1 + p + 1) == ' ') {
            // 6. Blockquote (`> `)
            let qs = if p + 1 < le && mem_load(ptr + 1 + p + 1) == ' ' { p + 2 } else { p + 1 };
            let st = md_inline_line(mode, mx, my, x + 16, cy, clamp_i64(max_w - 24, 60, 4000), ptr, qs, le, body_sz, line_h, 0, theme_text(th), th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, true, x + 2, clamp_i64(max_w - 4, 60, 4000));
            cy = st.cy;
            if st.hit_found == 1 { hit_found = 1; hit_idx = st.hit_idx; }
          } else if (c0 == '-' || c0 == '*' || c0 == 8226) && p + 1 < le && mem_load(ptr + 1 + p + 1) == ' ' {
            // 7. Bullet list (`- `, `* `, `• `)
            let nest = (lead_sp / 2) * 16;
            if mode == 2 && cy + line_h >= vis_y0 && cy <= vis_y1 {
              let r_in = if nest > 0 { 2 } else { 0 };
              ui_circle(x + nest + 9, cy + body_sz / 2 + 2, 3, r_in, theme_text(th), clip);
            }
            let b_indent = nest + 22;
            let st = md_inline_line(mode, mx, my, x + b_indent, cy, clamp_i64(max_w - b_indent, 60, 4000), ptr, p + 2, le, body_sz, line_h, 0, theme_text(th), th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, false, x, max_w);
            cy = st.cy + 2;
            if st.hit_found == 1 { hit_found = 1; hit_idx = st.hit_idx; }
          } else {
            // 8. Numbered list (`1. `, `12. `)
            let mut d_end = p;
            while d_end < le && d_end - p < 3 && mem_load(ptr + 1 + d_end) >= '0' && mem_load(ptr + 1 + d_end) <= '9' max 3 {
              d_end += 1;
            }
            let is_num = d_end > p && d_end + 1 < le && mem_load(ptr + 1 + d_end) == '.' && mem_load(ptr + 1 + d_end + 1) == ' ';
            if is_num {
              let nest = (lead_sp / 2) * 16;
              let mut nx = x + nest + 2;
              for nk in p..(d_end + 1) max 4 {
                let nch = mem_load(ptr + 1 + nk);
                let nadv = glyph_px(nch, body_sz, 0);
                if mode == 2 && cy + line_h >= vis_y0 && cy <= vis_y1 {
                  ui_glyph(nx, cy, nch, body_sz, 0, theme_muted(th), clip);
                }
                nx += nadv;
              }
              let n_indent = (nx - x) + 6;
              let st = md_inline_line(mode, mx, my, x + n_indent, cy, clamp_i64(max_w - n_indent, 60, 4000), ptr, d_end + 2, le, body_sz, line_h, 0, theme_text(th), th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, false, x, max_w);
              cy = st.cy + 2;
              if st.hit_found == 1 { hit_found = 1; hit_idx = st.hit_idx; }
            } else {
              // 9. Normal prose paragraph line
              let st = md_inline_line(mode, mx, my, x, cy, max_w, ptr, ls, le, body_sz, line_h, 0, theme_text(th), th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i, false, x, max_w);
              cy = st.cy;
              if st.hit_found == 1 { hit_found = 1; hit_idx = st.hit_idx; }
            }
          }
        }
      }
    }
    i = adv_i;
  }

  if mode == 1 {
    hit_idx
  } else {
    let h_tot = cy - y;
    if h_tot > 0 { h_tot } else { line_h }
  }
}

pub fn md_measure_h(buf_ptr: i64, max_cap: i64, max_w: i64, body_sz: i64, line_h: i64, th: i64) -[Mem]-> i64 {
  md_layout(0, 0, 0, 0, 0, max_w, buf_ptr, max_cap, body_sz, line_h, th, 0, 0, 0, 0, 0)
}

pub fn md_hit(
  buf_ptr: i64, max_cap: i64, mx: i64, my: i64, x: i64, y: i64, max_w: i64,
  body_sz: i64, line_h: i64, th: i64
) -[Mem]-> i64 {
  md_layout(1, mx, my, x, y, max_w, buf_ptr, max_cap, body_sz, line_h, th, 0, 0, 0, 0, 0)
}

pub fn md_draw(
  buf_ptr: i64, max_cap: i64, x: i64, y: i64, max_w: i64,
  body_sz: i64, line_h: i64, th: i64, clip: i64, vis_y0: i64, vis_y1: i64
) -[Mem]-> i64 {
  md_layout(2, 0, 0, x, y, max_w, buf_ptr, max_cap, body_sz, line_h, th, clip, vis_y0, vis_y1, 0, 0)
}

pub fn md_draw_sel(
  buf_ptr: i64, max_cap: i64, x: i64, y: i64, max_w: i64,
  body_sz: i64, line_h: i64, th: i64, clip: i64, vis_y0: i64, vis_y1: i64,
  sel_lo_i: i64, sel_hi_i: i64
) -[Mem]-> i64 {
  md_layout(2, 0, 0, x, y, max_w, buf_ptr, max_cap, body_sz, line_h, th, clip, vis_y0, vis_y1, sel_lo_i, sel_hi_i)
}
