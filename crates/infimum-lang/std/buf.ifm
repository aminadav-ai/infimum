// Infimum Standard Library: std/buf.ifm
// Z3-safe UTF-32 linear-memory buffer writer and search primitives.
// Convention: `mem_load(buf_ptr)` stores current length; elements at `buf_ptr + 1 + i`.

use "std/math.ifm";
use "std/slice.ifm";

pub fn buf_len(buf_ptr: i64, max_len: i64) -[Mem]-> i64 {
  clamp_i64(mem_load(buf_ptr), 0, max_i64(max_len, 0))
}

pub fn buf_clear(buf_ptr: i64) -[Mem]-> unit {
  mem_store(buf_ptr, 0);
}

pub fn buf_push_cp(buf_ptr: i64, max_len: i64, cp: i64) -[Mem]-> unit {
  let cap = max_i64(max_len, 0);
  let n = clamp_i64(mem_load(buf_ptr), 0, cap);
  if n < cap {
    mem_store(buf_ptr + 1 + n, cp);
    mem_store(buf_ptr, n + 1);
  }
}

pub fn buf_push_int(buf_ptr: i64, max_len: i64, val: i64) -[Mem]-> unit {
  let mut v = val;
  if v < 0 {
    buf_push_cp(buf_ptr, max_len, '-');
    v = -v;
  }
  if v == 0 {
    buf_push_cp(buf_ptr, max_len, '0');
  } else {
    let mut div = 1;
    let mut tmp = v;
    while tmp >= 10 max 20 {
      tmp = tmp / 10;
      div = div * 10;
    }
    let mut rem = v;
    while div > 0 max 20 {
      let d = rem / div;
      buf_push_cp(buf_ptr, max_len, '0' + d);
      rem = rem % div;
      div = div / 10;
    }
  }
}

// Append `src[src_start .. src_start + src_len)` into `dst` with JSON string escaping.
pub fn buf_push_json_escaped(dst_ptr: i64, dst_max: i64, src_ptr: i64, src_start: i64, src_len: i64) -[Mem]-> unit {
  let lim = clamp_i64(src_len, 0, 16384);
  for i in 0..lim max 16384 {
    let cp = mem_load(src_ptr + 1 + src_start + i);
    if cp == '"' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, '"');
    } else if cp == '\\' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, '\\');
    } else if cp == '\n' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 'n');
    } else if cp == '\r' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 'r');
    } else if cp == '\t' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 't');
    } else {
      buf_push_cp(dst_ptr, dst_max, cp);
    }
  }
}

pub fn buf_eq_slice(a_ptr: i64, a_start: i64, a_len: i64, b_ptr: i64, b_start: i64, b_len: i64) -[Mem]-> bool {
  let ap = a_ptr + 1 + a_start;
  let bp = b_ptr + 1 + b_start;
  if a_len != b_len || a_len < 0 || ap < 0 || bp < 0 {
    false
  } else {
    let lim = clamp_i64(a_len, 0, 4096);
    slice_eq(slice_i64(ap, lim), slice_i64(bp, lim))
  }
}

pub fn buf_find_cp(buf_ptr: i64, start: i64, end: i64, cp: i64) -[Mem]-> i64 {
  let s = max_i64(start, 0);
  let p = buf_ptr + 1 + s;
  if end <= s || p < 0 {
    -1
  } else {
    let idx = slice_find(slice_i64(p, end - s), cp);
    if idx >= 0 { s + idx } else { -1 }
  }
}

// ============================================================================
// Zero-GC Read-Only `str` & UTF-32 Buffer Ergonomics (O(1) static string binding)
// ============================================================================

/// Length of a string literal or `str` value in Unicode codepoints (`0..=4096`).
pub fn str_len(s: str) -[Mem]-> i64
  ens result >= 0 && result <= 4096
{
  let ss = str_as_slice(s);
  clamp_i64(ss.len, 0, 4096)
}

/// Read the `idx`-th Unicode codepoint of `s` (returns `0` if out of bounds).
pub fn str_char(s: str, idx: i64) -[Mem]-> i64 {
  let ss = str_as_slice(s);
  if idx >= 0 && idx < ss.len {
    ss[idx]
  } else {
    0
  }
}

/// Append a `str` into a length-prefixed UTF-32 buffer (clamped to `max_len`).
pub fn buf_push_str(buf_ptr: i64, max_len: i64, s: str) -[Mem]-> unit {
  let cap = max_i64(max_len, 0);
  let cur = clamp_i64(mem_load(buf_ptr), 0, cap);
  let rem = cap - cur;
  let dst_p = buf_ptr + 1 + cur;
  if rem > 0 && dst_p >= 0 {
    let copied = slice_copy(slice_i64(dst_p, rem), str_as_slice(s));
    mem_store(buf_ptr, cur + copied);
  }
}

/// Clear a UTF-32 buffer and copy `s` into it.
pub fn buf_set_str(buf_ptr: i64, max_len: i64, s: str) -[Mem]-> unit {
  buf_clear(buf_ptr);
  buf_push_str(buf_ptr, max_len, s);
}

/// Exact equality check between a length-prefixed UTF-32 buffer and a `str`.
pub fn buf_eq_str(buf_ptr: i64, s: str) -[Mem]-> bool {
  let bn = mem_load(buf_ptr);
  let p = buf_ptr + 1;
  if bn < 0 || p < 0 {
    false
  } else {
    slice_eq(slice_i64(p, bn), str_as_slice(s))
  }
}

/// Exact equality check between a raw UTF-32 slice (`mem[raw_ptr .. raw_ptr + len)`) and a `str`.
pub fn slice_eq_str(raw_ptr: i64, len: i64, s: str) -[Mem]-> bool {
  if len < 0 || raw_ptr < 0 {
    false
  } else {
    slice_eq(slice_i64(raw_ptr, len), str_as_slice(s))
  }
}

/// Check whether a length-prefixed UTF-32 buffer starts with `s`.
pub fn buf_starts_with(buf_ptr: i64, s: str) -[Mem]-> bool {
  let p = buf_ptr + 1;
  if p < 0 {
    false
  } else {
    let bn = clamp_i64(mem_load(buf_ptr), 0, 16384);
    slice_starts_with(slice_i64(p, bn), str_as_slice(s))
  }
}

/// Check whether a length-prefixed UTF-32 buffer ends with `s`.
pub fn buf_ends_with(buf_ptr: i64, s: str) -[Mem]-> bool {
  let p = buf_ptr + 1;
  if p < 0 {
    false
  } else {
    let bn = clamp_i64(mem_load(buf_ptr), 0, 16384);
    slice_ends_with(slice_i64(p, bn), str_as_slice(s))
  }
}

/// Check whether a length-prefixed UTF-32 buffer contains substring `s`.
pub fn buf_has_str(buf_ptr: i64, s: str) -[Mem]-> bool {
  let p = buf_ptr + 1;
  if p < 0 {
    false
  } else {
    let bn = clamp_i64(mem_load(buf_ptr), 0, 4096);
    slice_find_slice(slice_i64(p, bn), str_as_slice(s)) >= 0
  }
}
