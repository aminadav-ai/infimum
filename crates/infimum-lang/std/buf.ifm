// Infimum Standard Library: std/buf.ifm
// Z3-safe UTF-32 linear-memory buffer writer and search primitives.
// Convention: `mem_load(buf_ptr)` stores current length; elements at `buf_ptr + 1 + i`.

use "std/math.ifm";
use "std/sys_mem.ifm";

fn buf_len(buf_ptr: i64, max_len: i64) -[Mem]-> i64 {
  clamp_i64(mem_load(buf_ptr), 0, max_i64(max_len, 0))
}

fn buf_clear(buf_ptr: i64) -[Mem]-> unit {
  mem_store(buf_ptr, 0);
}

fn buf_push_cp(buf_ptr: i64, max_len: i64, cp: i64) -[Mem]-> unit {
  let cap = max_i64(max_len, 0);
  let n = clamp_i64(mem_load(buf_ptr), 0, cap);
  if n < cap {
    mem_store(buf_ptr + 1 + n, cp);
    mem_store(buf_ptr, n + 1);
  }
}

fn buf_push_int(buf_ptr: i64, max_len: i64, val: i64) -[Mem]-> unit {
  let mut v = val;
  if v < 0 {
    buf_push_cp(buf_ptr, max_len, '-');
    v = -v;
  }
  if v == 0 {
    buf_push_cp(buf_ptr, max_len, '0');
  } else {
    let mut div = 1;
    let mut tmp = v;
    while tmp >= 10 max 20 {
      tmp = tmp / 10;
      div = div * 10;
    }
    let mut rem = v;
    while div > 0 max 20 {
      let d = rem / div;
      buf_push_cp(buf_ptr, max_len, '0' + d);
      rem = rem % div;
      div = div / 10;
    }
  }
}

// Append `src[src_start .. src_start + src_len)` into `dst` with JSON string escaping.
fn buf_push_json_escaped(dst_ptr: i64, dst_max: i64, src_ptr: i64, src_start: i64, src_len: i64) -[Mem]-> unit {
  let lim = clamp_i64(src_len, 0, 16384);
  for i in 0..lim max 16384 {
    let cp = mem_load(src_ptr + 1 + src_start + i);
    if cp == '"' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, '"');
    } else if cp == '\\' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, '\\');
    } else if cp == '\n' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 'n');
    } else if cp == '\r' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 'r');
    } else if cp == '\t' {
      buf_push_cp(dst_ptr, dst_max, '\\');
      buf_push_cp(dst_ptr, dst_max, 't');
    } else {
      buf_push_cp(dst_ptr, dst_max, cp);
    }
  }
}

fn buf_eq_slice(a_ptr: i64, a_start: i64, a_len: i64, b_ptr: i64, b_start: i64, b_len: i64) -[Mem]-> bool {
  if a_len != b_len || a_len < 0 {
    false
  } else {
    let lim = clamp_i64(a_len, 0, 4096);
    let mut eq = true;
    for i in 0..lim max 4096 {
      if mem_load(a_ptr + 1 + a_start + i) != mem_load(b_ptr + 1 + b_start + i) {
        eq = false;
        break;
      }
    }
    eq
  }
}

fn buf_find_cp(buf_ptr: i64, start: i64, end: i64, cp: i64) -[Mem]-> i64 {
  let s = max_i64(start, 0);
  let mut found = -1;
  for i in s..end max 16384 {
    if mem_load(buf_ptr + 1 + i) == cp {
      found = i;
      break;
    }
  }
  found
}

// ============================================================================
// Zero-GC Read-Only `str` & UTF-32 Buffer Ergonomics (O(1) static string binding)
// ============================================================================

/// Length of a string literal or `str` value in Unicode codepoints (`0..=4096`).
fn str_len(s: str) -[Mem]-> i64
  ens result >= 0 && result <= 4096
{
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let ptr = mem_load(SYS_STR_SCRATCH_WORD);
  clamp_i64(mem_load(ptr), 0, 4096)
}

/// Read the `idx`-th Unicode codepoint of `s` (returns `0` if out of bounds).
fn str_char(s: str, idx: i64) -[Mem]-> i64 {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let n = clamp_i64(mem_load(ptr), 0, 4096);
  if idx >= 0 && idx < n {
    mem_load(ptr + 1 + idx)
  } else {
    0
  }
}

/// Append a `str` into a length-prefixed UTF-32 buffer (clamped to `max_len`).
fn buf_push_str(buf_ptr: i64, max_len: i64, s: str) -[Mem]-> unit {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 4096);
  let cap = max_i64(max_len, 0);
  let mut cur = clamp_i64(mem_load(buf_ptr), 0, cap);
  for i in 0..sn max 4096 {
    if cur >= cap { break; }
    mem_store(buf_ptr + 1 + cur, mem_load(s_ptr + 1 + i));
    cur += 1;
  }
  mem_store(buf_ptr, cur);
}

/// Clear a UTF-32 buffer and copy `s` into it.
fn buf_set_str(buf_ptr: i64, max_len: i64, s: str) -[Mem]-> unit {
  buf_clear(buf_ptr);
  buf_push_str(buf_ptr, max_len, s);
}

/// Exact equality check between a length-prefixed UTF-32 buffer and a `str`.
fn buf_eq_str(buf_ptr: i64, s: str) -[Mem]-> bool {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 4096);
  let bn = mem_load(buf_ptr);
  if bn != sn {
    false
  } else {
    let mut ok = true;
    for i in 0..sn max 4096 {
      if mem_load(buf_ptr + 1 + i) != mem_load(s_ptr + 1 + i) {
        ok = false;
        break;
      }
    }
    ok
  }
}

/// Exact equality check between a raw UTF-32 slice (`mem[raw_ptr .. raw_ptr + len)`) and a `str`.
fn slice_eq_str(raw_ptr: i64, len: i64, s: str) -[Mem]-> bool {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 4096);
  if len != sn || len < 0 {
    false
  } else {
    let mut ok = true;
    for i in 0..sn max 4096 {
      if mem_load(raw_ptr + i) != mem_load(s_ptr + 1 + i) {
        ok = false;
        break;
      }
    }
    ok
  }
}

/// Check whether a length-prefixed UTF-32 buffer starts with `s`.
fn buf_starts_with(buf_ptr: i64, s: str) -[Mem]-> bool {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 4096);
  let bn = clamp_i64(mem_load(buf_ptr), 0, 16384);
  if bn < sn {
    false
  } else {
    let mut ok = true;
    for i in 0..sn max 4096 {
      if mem_load(buf_ptr + 1 + i) != mem_load(s_ptr + 1 + i) {
        ok = false;
        break;
      }
    }
    ok
  }
}

/// Check whether a length-prefixed UTF-32 buffer ends with `s`.
fn buf_ends_with(buf_ptr: i64, s: str) -[Mem]-> bool {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 4096);
  let bn = clamp_i64(mem_load(buf_ptr), 0, 16384);
  if bn < sn {
    false
  } else {
    let off = bn - sn;
    let mut ok = true;
    for i in 0..sn max 4096 {
      if mem_load(buf_ptr + 1 + off + i) != mem_load(s_ptr + 1 + i) {
        ok = false;
        break;
      }
    }
    ok
  }
}

/// Check whether a length-prefixed UTF-32 buffer contains substring `s`.
fn buf_has_str(buf_ptr: i64, s: str) -[Mem]-> bool {
  do Mem.store_str(SYS_STR_SCRATCH_WORD, s);
  let s_ptr = mem_load(SYS_STR_SCRATCH_WORD);
  let sn = clamp_i64(mem_load(s_ptr), 0, 256);
  let bn = clamp_i64(mem_load(buf_ptr), 0, 4096);
  if sn == 0 {
    true
  } else if bn < sn {
    false
  } else {
    let limit = bn - sn + 1;
    let mut found = false;
    for pos in 0..limit max 4096 {
      let mut eq = true;
      for j in 0..sn max 256 {
        if mem_load(buf_ptr + 1 + pos + j) != mem_load(s_ptr + 1 + j) {
          eq = false;
          break;
        }
      }
      if eq {
        found = true;
        break;
      }
    }
    found
  }
}
