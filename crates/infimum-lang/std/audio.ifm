// Infimum Standard Library: std/audio.ifm
// Zero-asset procedural sound effects via infimum-web built-in audio synthesizer (opcodes 50 & 51).
// Requires only `-[Gpu]->` effect (already present in `step_ui`), zero audio files needed!

use "std/math.ifm";

pub const SFX_CLACK: i64 = 1;
pub const SFX_HOP: i64 = 2;
pub const SFX_CLICK: i64 = 3;
pub const SFX_SPAWN: i64 = 4;
pub const SFX_CLEAR: i64 = 5;
pub const SFX_ERROR: i64 = 6;
pub const SFX_WIN: i64 = 7;
pub const SFX_SHOTGUN: i64 = 8;
pub const SFX_MONSTER_HIT: i64 = 9;
pub const SFX_MONSTER_DIE: i64 = 10;
pub const SFX_PLAYER_HURT: i64 = 11;
pub const SFX_STEP: i64 = 12;
pub const SFX_GATE: i64 = 13;
pub const SFX_JUMP: i64 = 14;
pub const SFX_LION_ROAR: i64 = 15;
pub const SFX_SHEEP_BAA: i64 = 16;
pub const SFX_LASER: i64 = 17;
pub const SFX_MISSILE: i64 = 18;

// Play a built-in procedural SFX preset with pitch scaling (40..250%) and volume (0..100%)
pub fn sfx_play(preset: i64, pitch_pct: i64, vol_pct: i64) -[Gpu]-> unit {
  let p = clamp_i64(preset, 1, 18);
  let pi = clamp_i64(pitch_pct, 40, 250);
  let v = clamp_i64(vol_pct, 0, 100);
  do Gpu.call(50, p, pi, v);
}

pub fn sfx_click() -[Gpu]-> unit { sfx_play(SFX_CLICK, 100, 75); }
pub fn sfx_clack() -[Gpu]-> unit { sfx_play(SFX_CLACK, 100, 85); }
pub fn sfx_hop() -[Gpu]-> unit { sfx_play(SFX_HOP, 100, 70); }
pub fn sfx_spawn() -[Gpu]-> unit { sfx_play(SFX_SPAWN, 100, 65); }
pub fn sfx_clear() -[Gpu]-> unit { sfx_play(SFX_CLEAR, 100, 85); }
pub fn sfx_error() -[Gpu]-> unit { sfx_play(SFX_ERROR, 100, 75); }
pub fn sfx_win() -[Gpu]-> unit { sfx_play(SFX_WIN, 100, 85); }

// Custom procedural synth tone: wave 0=sine, 1=triangle, 2=square, 3=glass bell FM
pub fn sfx_tone(freq_hz: i64, dur_ms: i64, wave: i64) -[Gpu]-> unit {
  let f = clamp_i64(freq_hz, 60, 4000);
  let d = clamp_i64(dur_ms, 10, 1500);
  let w = clamp_i64(wave, 0, 3);
  do Gpu.call(51, f, d, w);
}
