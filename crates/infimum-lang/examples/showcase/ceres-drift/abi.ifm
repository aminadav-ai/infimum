// CERES DRIFT — Shared Typed ABI, Fixed Room-and-Tube Constants & Auto-Placed Layout
// True 6-DOF Zero-Gravity 3D Room-and-Tube Spaceship Shooter in Infimum Lang (Dark Sci-Fi 1K PBR Edition)

pub use "std/prelude.ifm";
pub use "std/mesh3d.ifm";

// 1K CC0 Poly Haven Dark Sci-Fi PBR Material Slots (bound via textures.json)
pub const PBR_CEILING_STEEL: i64 = 0;   // rusty_metal_03 (dark weathered industrial steel plates for ceilings & bulkheads)
pub const PBR_TUBE_CORR: i64 = 1;       // corrugated_iron_03 (corrugated industrial steel for tubes, columns & airlock ribs)
pub const PBR_STATION_WALL: i64 = 2;    // blue_metal_plate (dark scratched metallic armor plates for station walls)
pub const PBR_WEAPON_METAL: i64 = 3;    // metal_plate (dark patterned techno-metal for ship cannons, drones & airlock frame)
pub const PBR_GRATE_FLOOR: i64 = 6;     // metal_grate_rusty (industrial metal floor grate for Main & Upper decks)
pub const PBR_CONCRETE_FLOOR: i64 = 7;  // hangar_concrete_floor (rough dark concrete for Lower Mine & Airlock floor)
pub const PBR_REACTOR_ARMOR: i64 = 8;   // rusty_metal_grid (heavy industrial steel grid for Reactor Vault & blast barriers)
pub const PBR_INDUSTRIAL_WALL: i64 = 10;// painted_metal_shutter (dark ribbed industrial wall panels for Armory, Security, Deck 3)
pub const PBR_RIB_RUST: i64 = 11;       // rusty_metal_shutter (ribbed rusted steel for vertical shafts, tube bevels & structural ribs)

// World-space UV tile size in mm (1.6m per 1x1 texture repeat for crisp zero-stretch tiling)
pub const PBR_TILE_MM: i64 = 1600;

// Handcrafted Fixed 3D Mine Dimensions: 11 Distinct Chambers + 13 Octagonal Tubes across 3 Decks
pub const ROOM_COUNT: i64 = 11;
pub const TUBE_COUNT: i64 = 13;

// Octagonal Tube Geometry (2400 x 2400 mm cross-section with 400 mm 45-degree corner bevels)
pub const TUBE_HALF: i64 = 1200;
pub const TUBE_FLAT: i64 = 800;
pub const TUBE_OVERLAP: i64 = 1100;

// 6-bit face opening mask for rooms
pub const DIR_PX: i64 = 1;
pub const DIR_NX: i64 = 2;
pub const DIR_PY: i64 = 4;
pub const DIR_NY: i64 = 8;
pub const DIR_PZ: i64 = 16;
pub const DIR_NZ: i64 = 32;

// Tube axis constants
pub const AXIS_X: i64 = 0;
pub const AXIS_Y: i64 = 1;
pub const AXIS_Z: i64 = 2;

// Key Room IDs
pub const ROOM_START: i64 = 0;    // Шлюз Альфа (0, 10000, 20000)
pub const ROOM_ATRIUM: i64 = 1;   // Главный Атриум (0, 10000, 9000)
pub const ROOM_ARMORY: i64 = 2;   // Склад Оружия (-11000, 10000, 9000)
pub const ROOM_GEN: i64 = 3;      // Зал Генераторов (11000, 10000, 9000)
pub const ROOM_CRYO: i64 = 4;     // Крио-Сектор (-11000, 10000, -2000)
pub const ROOM_GUARD: i64 = 5;    // Охранный Пост (11000, 10000, -2000)
pub const ROOM_REACTOR: i64 = 6;  // Ядро Реактора (0, 10000, -2000)
pub const ROOM_MINE: i64 = 7;     // Рудная Шахта (0, 2000, 9000) — Deck 1
pub const ROOM_COOLER: i64 = 8;   // Нижний Охладитель (0, 2000, -2000) — Deck 1
pub const ROOM_BRIDGE: i64 = 9;   // Обзорный Мостик (0, 18000, 9000) — Deck 3
pub const ROOM_DOME: i64 = 10;    // Купол Реактора (0, 18000, -2000) — Deck 3

// Entity capacities
pub const DRONE_COUNT: i64 = 18;
pub const BOLT_COUNT: i64 = 40;
pub const PICKUP_COUNT: i64 = 16;
pub const PARTICLE_COUNT: i64 = 48;

pub enum GamePhase {
  Playing = 0,
  Escape = 1,   // Reactor destroyed! Self-destruct countdown active — reach Exit Airlock!
  Victory = 2,
  Dead = 3,
}

pub enum DroneKind {
  Scout = 1,    // Agile twin-wing interceptor
  Vulcan = 2,   // Heavy armored gunship
  Guardian = 3, // Reactor defense heavy sentinel
}

pub enum BoltKind {
  PlayerLaser = 1,
  PlayerMissile = 2,
  EnemyPlasma = 3,
}

pub enum PickupKind {
  Shield = 1,
  Energy = 2,
  Missiles = 3,
}

pub struct Vec3 {
  x: fixed,
  y: fixed,
  z: fixed,
}

pub struct Room {
  x0: word,
  y0: word,
  z0: word,
  x1: word,
  y1: word,
  z1: word,
  deck: word,      // 0 = Палуба 1 (Нижняя), 1 = Палуба 2 (Основная), 2 = Палуба 3 (Верхняя)
  theme: word,     // 0=Airlock, 1=Atrium, 2=Armory, 3=Generator, 4=Cryo, 5=Security, 6=Reactor, 7=LowerMine, 8=UpperDeck
  open_mask: word, // 6-bit mask of faces with octagonal tube openings
}

pub struct Tube {
  axis: word,   // 0=X, 1=Y (vertical shaft), 2=Z
  cx: word,     // cross-section X center (used by Y/Z tubes)
  cy: word,     // cross-section Y center (used by X/Z tubes)
  cz: word,     // cross-section Z center (used by X/Y tubes)
  a0: word,     // tube start coordinate along axis
  a1: word,     // tube end coordinate along axis
  room_a: word, // connected room ID A
  room_b: word, // connected room ID B
  theme: word,  // glowing guide ring color theme
}

pub struct Drone {
  x: word,
  y: word,
  z: word,
  vx: word,
  vy: word,
  vz: word,
  yaw: word,
  kind: word,
  hp: word,
  alive: word,
  cd: word,
  flash: word,
  anim: word,
  home_x: word,
  home_y: word,
  home_z: word,
}

pub struct Bolt {
  x: word,
  y: word,
  z: word,
  vx: word,
  vy: word,
  vz: word,
  kind: word,
  life: word,
}

pub struct Pickup {
  x: word,
  y: word,
  z: word,
  kind: word,
  active: word,
}

pub struct Particle {
  x: word,
  y: word,
  z: word,
  vx: word,
  vy: word,
  vz: word,
  col: word,
  life: word,
  size: word,
}

// Auto-placed linear memory layout (safely placed by compiler at word 705536+)
pub layout GameMem {
  tick: word,
  phase: word inv 0..=3,
  rng_state: word,

  // 6-DOF Spaceship state (world coordinates in mm, velocity in Q16.16 fixed)
  ship_x: word,
  ship_y: word,
  ship_z: word,
  vel_x: fixed,
  vel_y: fixed,
  vel_z: fixed,
  yaw: word,
  pitch: word inv -240..=240,
  bank_vis: word,

  // Ship combat stats
  shield: word inv 0..=100,
  energy: word inv 0..=100,
  missiles: word inv 0..=20,
  kills: word inv 0..=18,
  score: word,

  // Reactor Core & Escape countdown
  reactor_hp: word inv 0..=300,
  reactor_flash: word,
  escape_ticks: word,

  // Weapon & feedback timers
  laser_cd: word,
  missile_cd: word,
  laser_side: word inv 0..=1,
  recoil_l: word,
  recoil_r: word,
  muzzle_t: word,
  hurt_t: word,
  pickup_t: word,
  msg_timer: word,
  msg_code: word,

  // Target lock-on indicator (screen HUD)
  lock_active: word inv 0..=1,
  lock_dist: word,

  // Edge-triggered key tracking
  prev_r_key: word,
  prev_e_key: word,

  // Fixed handcrafted 3D Room-and-Tube Mine Architecture
  rooms: Room[11],
  tubes: Tube[13],

  // World entities
  drones: Drone[18],
  bolts: vec<Bolt>[40],
  pickups: Pickup[16],
  particles: vec<Particle>[48],
}
