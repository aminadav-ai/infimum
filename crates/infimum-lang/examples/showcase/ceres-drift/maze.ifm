// CERES DRIFT — Fixed Handcrafted 11-Room & 13-Octagonal-Tube Asteroid Mine
// Exact CSG Union Collision, 3D Line-of-Sight, Room/Deck Queries & Graph Reachability

use "abi.ifm";

fn next_rand() -[Mem]-> i64 {
  let s = GameMem.rng_state;
  let nxt = (s * 1103515245 + 12345) & 2147483647;
  let safe = if nxt == 0 { 19950317 } else { nxt };
  GameMem.rng_state = safe;
  safe
}

fn set_room(
  id: i64,
  cx: i64, cy: i64, cz: i64,
  hx: i64, hy: i64, hz: i64,
  deck: i64, theme: i64, open_mask: i64
) -[Mem]-> unit {
  let i = clamp_i64(id, 0, 10);
  GameMem.rooms[i].x0 = cx - hx;
  GameMem.rooms[i].y0 = cy - hy;
  GameMem.rooms[i].z0 = cz - hz;
  GameMem.rooms[i].x1 = cx + hx;
  GameMem.rooms[i].y1 = cy + hy;
  GameMem.rooms[i].z1 = cz + hz;
  GameMem.rooms[i].deck = deck;
  GameMem.rooms[i].theme = theme;
  GameMem.rooms[i].open_mask = open_mask;
}

fn set_tube(
  id: i64,
  axis: i64,
  cx: i64, cy: i64, cz: i64,
  a0: i64, a1: i64,
  room_a: i64, room_b: i64,
  theme: i64
) -[Mem]-> unit {
  let i = clamp_i64(id, 0, 12);
  GameMem.tubes[i].axis = axis;
  GameMem.tubes[i].cx = cx;
  GameMem.tubes[i].cy = cy;
  GameMem.tubes[i].cz = cz;
  GameMem.tubes[i].a0 = a0;
  GameMem.tubes[i].a1 = a1;
  GameMem.tubes[i].room_a = room_a;
  GameMem.tubes[i].room_b = room_b;
  GameMem.tubes[i].theme = theme;
}

fn room_center_xyz(id: i64) -[Mem]-> (i64, i64, i64) {
  let i = clamp_i64(id, 0, 10);
  let cx = (GameMem.rooms[i].x0 + GameMem.rooms[i].x1) / 2;
  let cy = (GameMem.rooms[i].y0 + GameMem.rooms[i].y1) / 2;
  let cz = (GameMem.rooms[i].z0 + GameMem.rooms[i].z1) / 2;
  (cx, cy, cz)
}

// Build the FIXED, memorable, handcrafted 3D Lunar Mine «ШАХТА ЦЕРЕРА-1»
// Always identical so the pilot can memorize every chamber, tube & shortcut!
fn build_ceres_mine() -[Mem]-> unit {
  // === 11 DISTINCT CHAMBERS ACROSS 3 VERTICAL DECKS ===
  // Deck 2 (Main Level, Y = 10000):
  // 0: Шлюз Альфа (Start & Escape Airlock) — opens -Z into Entry Tube 0
  set_room(ROOM_START, 0, 10000, 20000, 2600, 2000, 2600, 1, 0, DIR_NZ);

  // 1: Главный Атриум (Grand Central 3D Hub) — opens +Z, -X, +X, -Y (down), +Y (up)
  set_room(ROOM_ATRIUM, 0, 10000, 9000, 3600, 2600, 3600, 1, 1, DIR_PZ | DIR_NX | DIR_PX | DIR_NY | DIR_PY);

  // 2: Склад Оружия (West Armory) — opens +X (Atrium) & -Z (Cryo)
  set_room(ROOM_ARMORY, -11000, 10000, 9000, 2800, 2100, 2800, 1, 2, DIR_PX | DIR_NZ);

  // 3: Зал Генераторов (East Power Hall) — opens -X (Atrium) & -Z (Guard Post)
  set_room(ROOM_GEN, 11000, 10000, 9000, 2800, 2100, 2800, 1, 3, DIR_NX | DIR_NZ);

  // 4: Крио-Сектор (NW Coolant Bay) — opens +Z (Armory) & +X (Reactor)
  set_room(ROOM_CRYO, -11000, 10000, -2000, 2800, 2100, 2800, 1, 4, DIR_PZ | DIR_PX);

  // 5: Охранный Пост (NE Security Outpost) — opens +Z (Gen Hall) & -X (Reactor)
  set_room(ROOM_GUARD, 11000, 10000, -2000, 2800, 2100, 2800, 1, 5, DIR_PZ | DIR_NX);

  // 6: Ядро Реактора (Boss Reactor Chamber) — opens -X, +X, -Y (lower shaft), +Y (upper dive shaft)
  set_room(ROOM_REACTOR, 0, 10000, -2000, 3700, 2700, 3700, 1, 6, DIR_NX | DIR_PX | DIR_NY | DIR_PY);

  // Deck 1 (Lower Mining Tunnels, Y = 2000):
  // 7: Рудная Шахта (Below Atrium) — opens +Y (Atrium) & -Z (Lower Cooler)
  set_room(ROOM_MINE, 0, 2000, 9000, 3000, 2100, 3000, 0, 7, DIR_PY | DIR_NZ);

  // 8: Нижний Охладитель (Below Reactor) — opens +Z (Ore Mine) & +Y (Reactor under-shaft)
  set_room(ROOM_COOLER, 0, 2000, -2000, 3000, 2100, 3000, 0, 7, DIR_PZ | DIR_PY);

  // Deck 3 (Upper Command Deck, Y = 18000):
  // 9: Обзорный Мостик (Above Atrium) — opens -Y (Atrium) & -Z (Reactor Dome)
  set_room(ROOM_BRIDGE, 0, 18000, 9000, 3000, 2100, 3000, 2, 8, DIR_NY | DIR_NZ);

  // 10: Купол Реактора (Above Reactor) — opens +Z (Bridge) & -Y (Reactor dive shaft)
  set_room(ROOM_DOME, 0, 18000, -2000, 3000, 2100, 3000, 2, 8, DIR_PZ | DIR_NY);

  // === 13 OCTAGONAL CONNECTING TUBES & VERTICAL ELEVATOR SHAFTS ===
  // Tube 0 (Z): Шлюз Альфа <-> Главный Атриум (4800 mm long)
  set_tube(0, AXIS_Z, 0, 10000, 0, 12600, 17400, ROOM_ATRIUM, ROOM_START, 0);

  // Tube 1 (X): Склад Оружия <-> Главный Атриум (4600 mm long)
  set_tube(1, AXIS_X, 0, 10000, 9000, -8200, -3600, ROOM_ARMORY, ROOM_ATRIUM, 2);

  // Tube 2 (X): Главный Атриум <-> Зал Генераторов (4600 mm long)
  set_tube(2, AXIS_X, 0, 10000, 9000, 3600, 8200, ROOM_ATRIUM, ROOM_GEN, 3);

  // Tube 3 (Z): Крио-Сектор <-> Склад Оружия (5400 mm long)
  set_tube(3, AXIS_Z, -11000, 10000, 0, 800, 6200, ROOM_CRYO, ROOM_ARMORY, 4);

  // Tube 4 (Z): Охранный Пост <-> Зал Генераторов (5400 mm long)
  set_tube(4, AXIS_Z, 11000, 10000, 0, 800, 6200, ROOM_GUARD, ROOM_GEN, 5);

  // Tube 5 (X): Крио-Сектор <-> Ядро Реактора (4500 mm long)
  set_tube(5, AXIS_X, 0, 10000, -2000, -8200, -3700, ROOM_CRYO, ROOM_REACTOR, 6);

  // Tube 6 (X): Ядро Реактора <-> Охранный Пост (4500 mm long)
  set_tube(6, AXIS_X, 0, 10000, -2000, 3700, 8200, ROOM_REACTOR, ROOM_GUARD, 6);

  // Tube 7 (Y vertical shaft): Рудная Шахта (Deck 1) <-> Главный Атриум (Deck 2)
  set_tube(7, AXIS_Y, 0, 0, 9000, 4100, 7400, ROOM_MINE, ROOM_ATRIUM, 7);

  // Tube 8 (Z Deck 1): Нижний Охладитель <-> Рудная Шахта (5000 mm long)
  set_tube(8, AXIS_Z, 0, 2000, 0, 1000, 6000, ROOM_COOLER, ROOM_MINE, 7);

  // Tube 9 (Y vertical shaft): Нижний Охладитель (Deck 1) <-> Ядро Реактора (Deck 2)
  set_tube(9, AXIS_Y, 0, 0, -2000, 4100, 7300, ROOM_COOLER, ROOM_REACTOR, 6);

  // Tube 10 (Y vertical shaft): Главный Атриум (Deck 2) <-> Обзорный Мостик (Deck 3)
  set_tube(10, AXIS_Y, 0, 0, 9000, 12600, 15900, ROOM_ATRIUM, ROOM_BRIDGE, 8);

  // Tube 11 (Z Deck 3): Купол Реактора <-> Обзорный Мостик (5000 mm long)
  set_tube(11, AXIS_Z, 0, 18000, 0, 1000, 6000, ROOM_DOME, ROOM_BRIDGE, 8);

  // Tube 12 (Y vertical shaft): Ядро Реактора (Deck 2) <-> Купол Реактора (Deck 3)
  set_tube(12, AXIS_Y, 0, 0, -2000, 12700, 15900, ROOM_REACTOR, ROOM_DOME, 6);
}

// Verify room-graph connectivity via BFS (used in built-in unit tests)
fn mine_rooms_reachable(src: i64, dst: i64) -[Mem]-> bool {
  for i in 0..16 {
    GameMem.visited[i] = 0;
    GameMem.queue[i] = 0;
  }
  let s = clamp_i64(src, 0, 10);
  let t = clamp_i64(dst, 0, 10);
  GameMem.visited[s] = 1;
  GameMem.queue[0] = s;
  let mut head = 0;
  let mut tail = 1;

  for _iter in 0..24 {
    if head >= tail { break; }
    let cur = clamp_i64(GameMem.queue[clamp_i64(head, 0, 15)], 0, 10);
    head += 1;
    if cur == t { break; }
    for k in 0..13 {
      let ra = GameMem.tubes[k].room_a;
      let rb = GameMem.tubes[k].room_b;
      let nxt = if ra == cur { rb } else if rb == cur { ra } else { -1 };
      if nxt >= 0 && nxt < 11 && GameMem.visited[nxt] == 0 {
        GameMem.visited[nxt] = 1;
        if tail < 16 {
          GameMem.queue[tail] = nxt;
          tail += 1;
        }
      }
    }
  }
  GameMem.visited[t] == 1
}

// Query current vertical deck (0=Lower P1, 1=Main P2, 2=Upper P3)
fn world_to_deck(py: i64) -> i64
  ens result >= 0 && result <= 2
{
  if py < 5800 {
    0
  } else if py > 14200 {
    2
  } else {
    1
  }
}

// Returns Room ID (0..10) if point is inside a chamber, or -1 if flying inside a tube
fn find_current_room(px: i64, py: i64, pz: i64) -[Mem]-> i64 {
  let mut found = -1;
  for r in 0..11 {
    if px >= GameMem.rooms[r].x0 && px <= GameMem.rooms[r].x1
      && py >= GameMem.rooms[r].y0 && py <= GameMem.rooms[r].y1
      && pz >= GameMem.rooms[r].z0 && pz <= GameMem.rooms[r].z1
    {
      found = r;
      break;
    }
  }
  found
}

// Returns Tube ID (0..12) if point is inside a tube, or -1
fn find_current_tube(px: i64, py: i64, pz: i64) -[Mem]-> i64 {
  let mut found = -1;
  for t in 0..13 {
    let ax = GameMem.tubes[t].axis;
    let a0 = GameMem.tubes[t].a0;
    let a1 = GameMem.tubes[t].a1;
    if ax == AXIS_X {
      if px >= a0 && px <= a1
        && abs_i64(py - GameMem.tubes[t].cy) <= TUBE_HALF
        && abs_i64(pz - GameMem.tubes[t].cz) <= TUBE_HALF
      {
        found = t;
        break;
      }
    } else if ax == AXIS_Y {
      if py >= a0 && py <= a1
        && abs_i64(px - GameMem.tubes[t].cx) <= TUBE_HALF
        && abs_i64(pz - GameMem.tubes[t].cz) <= TUBE_HALF
      {
        found = t;
        break;
      }
    } else {
      if pz >= a0 && pz <= a1
        && abs_i64(px - GameMem.tubes[t].cx) <= TUBE_HALF
        && abs_i64(py - GameMem.tubes[t].cy) <= TUBE_HALF
      {
        found = t;
        break;
      }
    }
  }
  found
}

// Exact O(1) CSG Union Collision against 11 Rooms + 13 Octagonal Tubes
// Returns true if (px, py, pz) with bounding radius `rad` hits a solid wall.
fn hits_maze_3d(px: i64, py: i64, pz: i64, rad: i64) -[Mem]-> bool {
  let mut inside = false;

  // 1. Inside any of the 11 Chambers?
  for r in 0..11 {
    if px >= GameMem.rooms[r].x0 + rad && px <= GameMem.rooms[r].x1 - rad
      && py >= GameMem.rooms[r].y0 + rad && py <= GameMem.rooms[r].y1 - rad
      && pz >= GameMem.rooms[r].z0 + rad && pz <= GameMem.rooms[r].z1 - rad
    {
      inside = true;
      break;
    }
  }

  // 2. Inside any of the 13 Octagonal Tubes (including seamless doorway overlap into rooms)?
  if !inside {
    let m = TUBE_HALF - rad;
    let oct_lim = TUBE_HALF + TUBE_FLAT - (rad * 142) / 100;
    if m > 0 && oct_lim > 0 {
      for t in 0..13 {
        let ax = GameMem.tubes[t].axis;
        let lo = GameMem.tubes[t].a0 - TUBE_OVERLAP + rad;
        let hi = GameMem.tubes[t].a1 + TUBE_OVERLAP - rad;
        if ax == AXIS_X {
          if px >= lo && px <= hi {
            let dy = abs_i64(py - GameMem.tubes[t].cy);
            let dz = abs_i64(pz - GameMem.tubes[t].cz);
            if dy <= m && dz <= m && (dy + dz) <= oct_lim {
              inside = true;
              break;
            }
          }
        } else if ax == AXIS_Y {
          if py >= lo && py <= hi {
            let dx = abs_i64(px - GameMem.tubes[t].cx);
            let dz = abs_i64(pz - GameMem.tubes[t].cz);
            if dx <= m && dz <= m && (dx + dz) <= oct_lim {
              inside = true;
              break;
            }
          }
        } else {
          if pz >= lo && pz <= hi {
            let dx = abs_i64(px - GameMem.tubes[t].cx);
            let dy = abs_i64(py - GameMem.tubes[t].cy);
            if dx <= m && dy <= m && (dx + dy) <= oct_lim {
              inside = true;
              break;
            }
          }
        }
      }
    }
  }

  !inside
}

// 24-step 3D Line-of-Sight raycast through chambers and octagonal tubes
fn has_los_3d(x0: i64, y0: i64, z0: i64, x1: i64, y1: i64, z1: i64) -[Mem]-> bool {
  let mut clear = true;
  for s in 1..24 {
    let px = x0 + ((x1 - x0) * s) / 24;
    let py = y0 + ((y1 - y0) * s) / 24;
    let pz = z0 + ((z1 - z0) * s) / 24;
    if hits_maze_3d(px, py, pz, 70) {
      clear = false;
      break;
    }
  }
  clear
}
