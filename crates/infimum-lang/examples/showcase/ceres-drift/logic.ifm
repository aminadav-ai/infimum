use "abi.ifm";
use "maze.ifm" as maze;

// --- Pure Telos-Verified Kernels ---

pub fn clamp_pitch(p: i64) -> i64
  ens result >= -240 && result <= 240
{
  if p < -240 { -240 } else if p > 240 { 240 } else { p }
}

pub fn clamp_stat(v: i64, hi: i64) -> i64
  req hi >= 0
  ens result >= 0 && result <= hi
{
  if v < 0 { 0 } else if v > hi { hi } else { v }
}

pub fn compute_ceres_score(kills: i64, reactor_dead: i64, shield_left: i64, escape_secs: i64) -> i64
  req kills >= 0 && kills <= 18 && reactor_dead >= 0 && reactor_dead <= 1 && shield_left >= 0 && shield_left <= 100 && escape_secs >= 0 && escape_secs <= 60
  ens result >= 0
{
  kills * 250 + reactor_dead * 1500 + shield_left * 10 + escape_secs * 50
}

pub fn ship_forward_vec(yaw: i64, pitch: i64) -> Vec3 {
  let p_ang = (pitch * 2 + 4096) & 4095;
  let cp = fixed_cos(p_ang);
  let sp = fixed_sin(p_ang);
  Vec3 {
    x: fixed_sin(yaw) * cp,
    y: sp,
    z: -fixed_cos(yaw) * cp,
  }
}

pub fn reactor_center_xyz() -[Mem]-> (i64, i64, i64) {
  maze::room_center_xyz(ROOM_REACTOR)
}

pub fn exit_center_xyz() -[Mem]-> (i64, i64, i64) {
  maze::room_center_xyz(ROOM_START)
}

// --- 3D Particles (vec<Particle>[48]) ---

fn spawn_explosion(wx: i64, wy: i64, wz: i64, count: i64, kind: i64) -[Mem]-> unit {
  let lim = clamp_i64(count, 1, 18);
  let spread = if kind == 2 { 5 } else if kind == 1 { 3 } else { 2 };
  for _s in 0..lim max 18 {
    let r1 = maze::next_rand();
    let r2 = maze::next_rand();
    let r3 = maze::next_rand();
    let col = if kind == 0 {
      pack_rgba(88, 245, 255, 255)
    } else if kind == 1 {
      if (r1 & 1) == 0 { pack_rgba(255, 198, 64, 255) } else { pack_rgba(255, 92, 38, 255) }
    } else {
      if (r1 & 1) == 0 { pack_rgba(255, 232, 118, 255) } else { pack_rgba(255, 64, 148, 255) }
    };
    let ok = GameMem.particles.try_push(Particle {
      x: wx,
      y: wy,
      z: wz,
      vx: ((r1 & 127) - 64) * spread,
      vy: ((r2 & 127) - 64) * spread,
      vz: ((r3 & 127) - 64) * spread,
      col: col,
      life: (if kind == 2 { 28 } else { 16 }) + (r3 & 11),
      size: if kind == 2 { 110 } else if kind == 1 { 72 } else { 42 },
    });
    if !ok { break; }
  }
}

fn step_particles() -[Mem]-> unit {
  let mut i = 0;
  while i < GameMem.particles.len max 48 {
    if i >= 0 && i < GameMem.particles.len {
      let mut pt = GameMem.particles[i];
      if pt.life <= 1 {
        let _ = GameMem.particles.swap_remove(i);
      } else {
        pt.x += pt.vx;
        pt.y += pt.vy;
        pt.z += pt.vz;
        pt.vx = (pt.vx * 92) / 100;
        pt.vy = (pt.vy * 92) / 100;
        pt.vz = (pt.vz * 92) / 100;
        pt.life -= 1;
        GameMem.particles[i] = pt;
        i += 1;
      }
    } else {
      break;
    }
  }
}

// --- Spawn Fixed Handcrafted Drones & Pickups ---

fn spawn_drone_xyz(slot: i64, wx: i64, wy: i64, wz: i64, kind: i64) -[Mem]-> unit {
  let i = clamp_i64(slot, 0, 17);
  GameMem.drones[i].x = wx;
  GameMem.drones[i].y = wy;
  GameMem.drones[i].z = wz;
  GameMem.drones[i].home_x = wx;
  GameMem.drones[i].home_y = wy;
  GameMem.drones[i].home_z = wz;
  GameMem.drones[i].vx = 0;
  GameMem.drones[i].vy = 0;
  GameMem.drones[i].vz = 0;
  GameMem.drones[i].yaw = (i * 512) & 4095;
  GameMem.drones[i].kind = kind;
  GameMem.drones[i].hp = if kind == DroneKind::Guardian { 130 } else if kind == DroneKind::Vulcan { 85 } else { 48 };
  GameMem.drones[i].alive = 1;
  GameMem.drones[i].cd = 35 + (i * 7) % 40;
  GameMem.drones[i].flash = 0;
  GameMem.drones[i].anim = i * 47;
}

fn spawn_pickup_at(slot: i64, wx: i64, wy: i64, wz: i64, kind: i64) -[Mem]-> unit {
  let i = clamp_i64(slot, 0, 15);
  GameMem.pickups[i].x = wx;
  GameMem.pickups[i].y = wy;
  GameMem.pickups[i].z = wz;
  GameMem.pickups[i].kind = kind;
  GameMem.pickups[i].active = 1;
}

fn drop_pickup_if_free(wx: i64, wy: i64, wz: i64, kind: i64) -[Mem]-> unit {
  for i in 0..16 {
    if GameMem.pickups[i].active == 0 {
      spawn_pickup_at(i, wx, wy, wz, kind);
      break;
    }
  }
}

pub fn reset_ceres() -[Mem]-> unit {
  maze::build_ceres_mine();
  GameMem.rng_state = 19950317;

  GameMem.tick = 0;
  GameMem.phase = GamePhase::Playing;

  // Spawn inside Room 0 «ШЛЮЗ АЛЬФА» looking straight down Entry Tube 0 toward Главный Атриум!
  GameMem.ship_x = 0;
  GameMem.ship_y = 10000;
  GameMem.ship_z = 20400;
  GameMem.vel_x = 0.0;
  GameMem.vel_y = 0.0;
  GameMem.vel_z = 0.0;
  GameMem.yaw = 0;
  GameMem.pitch = 0;
  GameMem.bank_vis = 0;

  GameMem.shield = 100;
  GameMem.energy = 100;
  GameMem.missiles = 8;
  GameMem.kills = 0;
  GameMem.score = 0;

  GameMem.reactor_hp = 300;
  GameMem.reactor_flash = 0;
  GameMem.escape_ticks = 0;

  GameMem.laser_cd = 0;
  GameMem.missile_cd = 0;
  GameMem.laser_side = 0;
  GameMem.recoil_l = 0;
  GameMem.recoil_r = 0;
  GameMem.muzzle_t = 0;
  GameMem.hurt_t = 0;
  GameMem.pickup_t = 0;
  GameMem.msg_timer = 0;
  GameMem.msg_code = 0;
  GameMem.lock_active = 0;
  GameMem.lock_dist = 0;

  GameMem.bolts.clear();
  GameMem.particles.clear();
  for pk in 0..16 {
    GameMem.pickups[pk].active = 0;
  }

  // === 18 HANDCRAFTED FIXED DRONE PATROLS ACROSS THE 10 COMBAT ROOMS ===
  // Room 1: Главный Атриум (First exhilarating dogfight!)
  spawn_drone_xyz(0, -1500, 10400, 8200, DroneKind::Scout);
  spawn_drone_xyz(1, 1500, 9600, 8200, DroneKind::Scout);

  // Room 2: Склад Оружия (West Armory)
  spawn_drone_xyz(2, -11800, 10300, 8400, DroneKind::Scout);
  spawn_drone_xyz(3, -10200, 9600, 9600, DroneKind::Vulcan);

  // Room 3: Зал Генераторов (East Power Hall)
  spawn_drone_xyz(4, 11800, 10300, 8400, DroneKind::Scout);
  spawn_drone_xyz(5, 10200, 9600, 9600, DroneKind::Vulcan);

  // Room 4: Крио-Сектор (NW Coolant Bay)
  spawn_drone_xyz(6, -11800, 10400, -2700, DroneKind::Scout);
  spawn_drone_xyz(7, -10200, 9600, -1300, DroneKind::Vulcan);

  // Room 5: Охранный Пост (NE Security Outpost)
  spawn_drone_xyz(8, 11800, 10300, -2700, DroneKind::Vulcan);
  spawn_drone_xyz(9, 10200, 9700, -1300, DroneKind::Guardian);

  // Room 6: Ядро Реактора (Boss Arena — Twin Guardians defending the Core!)
  spawn_drone_xyz(10, -1900, 10400, -3400, DroneKind::Guardian);
  spawn_drone_xyz(11, 1900, 9600, -3400, DroneKind::Guardian);

  // Room 7: Рудная Шахта (Deck 1 Lower Mine)
  spawn_drone_xyz(12, -1200, 2200, 8400, DroneKind::Scout);
  spawn_drone_xyz(13, 1200, 1800, 9600, DroneKind::Vulcan);

  // Room 8: Нижний Охладитель (Deck 1 Under Reactor)
  spawn_drone_xyz(14, 0, 2000, -2800, DroneKind::Vulcan);

  // Room 9: Обзорный Мостик (Deck 3 Upper Command Deck)
  spawn_drone_xyz(15, -1200, 18300, 8400, DroneKind::Scout);
  spawn_drone_xyz(16, 1200, 17700, 9600, DroneKind::Vulcan);

  // Room 10: Купол Реактора (Deck 3 Reactor Overlook)
  spawn_drone_xyz(17, 0, 18200, -2800, DroneKind::Guardian);

  // === 12 MEMORABLE FIXED PICKUP CACHES (4 slots kept open for drone drops) ===
  spawn_pickup_at(0, 0, 9400, 18300, PickupKind::Missiles);         // Шлюз Альфа (near Tube 0)
  spawn_pickup_at(1, 2100, 9100, 10800, PickupKind::Shield);        // Главный Атриум
  spawn_pickup_at(2, -12300, 9300, 10200, PickupKind::Missiles);    // Склад Оружия
  spawn_pickup_at(3, -12300, 9300, 7800, PickupKind::Shield);       // Склад Оружия
  spawn_pickup_at(4, 12300, 9300, 10200, PickupKind::Energy);       // Зал Генераторов
  spawn_pickup_at(5, 12300, 9300, 7800, PickupKind::Shield);        // Зал Генераторов
  spawn_pickup_at(6, -12100, 9300, -3200, PickupKind::Missiles);    // Крио-Сектор
  spawn_pickup_at(7, 12100, 9300, -3200, PickupKind::Energy);       // Охранный Пост
  spawn_pickup_at(8, 1500, 1300, 7600, PickupKind::Shield);         // Рудная Шахта (П1)
  spawn_pickup_at(9, -1500, 1300, -3200, PickupKind::Missiles);     // Нижний Охладитель (П1)
  spawn_pickup_at(10, -1500, 17300, 7600, PickupKind::Energy);      // Обзорный Мостик (П3)
  spawn_pickup_at(11, 1500, 17300, -3200, PickupKind::Shield);      // Купол Реактора (П3)
}

// --- Damage & Reactor Destruction ---

fn damage_ship(dmg: i64) -[Mem, Gpu]-> unit {
  if GameMem.phase == GamePhase::Playing || GameMem.phase == GamePhase::Escape {
    let nsh = clamp_stat(GameMem.shield - dmg, 100);
    GameMem.shield = nsh;
    GameMem.hurt_t = 12;
    sfx_play(SFX_PLAYER_HURT, 105, 88);
    if nsh <= 0 {
      GameMem.phase = GamePhase::Dead;
      spawn_explosion(GameMem.ship_x, GameMem.ship_y, GameMem.ship_z, 16, 2);
      sfx_play(SFX_MONSTER_DIE, 58, 95);
    } else if nsh <= 25 {
      GameMem.msg_code = 3;
      GameMem.msg_timer = 75;
    }
  }
}

pub fn damage_reactor(dmg: i64) -[Mem, Gpu]-> unit {
  if GameMem.reactor_hp > 0 && GameMem.phase == GamePhase::Playing {
    let (rx, ry, rz) = reactor_center_xyz();
    let nhp = clamp_stat(GameMem.reactor_hp - dmg, 300);
    GameMem.reactor_hp = nhp;
    GameMem.reactor_flash = 10;
    spawn_explosion(rx, ry, rz, 8, 1);
    if nhp <= 0 {
      GameMem.phase = GamePhase::Escape;
      GameMem.escape_ticks = 2700; // 45 seconds!
      GameMem.msg_code = 2;
      GameMem.msg_timer = 240;
      spawn_explosion(rx, ry, rz, 18, 2);
      sfx_play(SFX_SHOTGUN, 52, 100);
      sfx_play(SFX_GATE, 85, 95);
    } else {
      GameMem.msg_code = 1;
      GameMem.msg_timer = 45;
      sfx_play(SFX_MONSTER_HIT, 75, 88);
    }
  }
}

fn damage_drone(idx: i64, dmg: i64) -[Mem, Gpu]-> unit {
  let i = clamp_i64(idx, 0, 17);
  if GameMem.drones[i].alive == 1 {
    let nhp = GameMem.drones[i].hp - dmg;
    GameMem.drones[i].flash = 8;
    let dx = GameMem.drones[i].x;
    let dy = GameMem.drones[i].y;
    let dz = GameMem.drones[i].z;
    if nhp <= 0 {
      GameMem.drones[i].hp = 0;
      GameMem.drones[i].alive = 0;
      GameMem.kills = clamp_i64(GameMem.kills + 1, 0, 18);
      spawn_explosion(dx, dy, dz, 14, 1);
      let kind = GameMem.drones[i].kind;
      let pit = if kind == DroneKind::Guardian { 68 } else if kind == DroneKind::Vulcan { 86 } else { 115 };
      sfx_play(SFX_MONSTER_DIE, pit, 90);
      let drop_k = 1 + (maze::next_rand() % 3);
      drop_pickup_if_free(dx, dy, dz, drop_k);
    } else {
      GameMem.drones[i].hp = nhp;
      spawn_explosion(dx, dy, dz, 5, 0);
      sfx_play(SFX_MONSTER_HIT, 118, 78);
    }
  }
}

// --- Target Lock Detection & Weapon Firing ---

fn find_aim_target() -[Mem]-> (i64, i64, i64, i64, i64) {
  let sx = GameMem.ship_x;
  let sy = GameMem.ship_y;
  let sz = GameMem.ship_z;
  let fwd = ship_forward_vec(GameMem.yaw, GameMem.pitch);

  let mut best_found = 0;
  let mut best_dist = 16000;
  let mut best_tx = 0;
  let mut best_ty = 0;
  let mut best_tz = 0;

  for i in 0..18 {
    if GameMem.drones[i].alive == 1 {
      let ex = GameMem.drones[i].x;
      let ey = GameMem.drones[i].y;
      let ez = GameMem.drones[i].z;
      let rx = fixed(ex - sx);
      let ry = fixed(ey - sy);
      let rz = fixed(ez - sz);
      let t_proj = fixed_to_int(rx * fwd.x + ry * fwd.y + rz * fwd.z);
      if t_proj > 260 && t_proj < best_dist {
        let px = ex - (sx + fixed_to_int(fwd.x * t_proj));
        let py = ey - (sy + fixed_to_int(fwd.y * t_proj));
        let pz = ez - (sz + fixed_to_int(fwd.z * t_proj));
        let perp = abs_i64(px) + abs_i64(py) + abs_i64(pz);
        let cone = 560 + t_proj / 6;
        if perp < cone && maze::has_los_3d(sx, sy, sz, ex, ey, ez) {
          best_found = 1;
          best_dist = t_proj;
          best_tx = ex;
          best_ty = ey;
          best_tz = ez;
        }
      }
    }
  }

  if GameMem.reactor_hp > 0 {
    let (ex, ey, ez) = reactor_center_xyz();
    let rx = fixed(ex - sx);
    let ry = fixed(ey - sy);
    let rz = fixed(ez - sz);
    let t_proj = fixed_to_int(rx * fwd.x + ry * fwd.y + rz * fwd.z);
    if t_proj > 300 && t_proj < best_dist {
      let px = ex - (sx + fixed_to_int(fwd.x * t_proj));
      let py = ey - (sy + fixed_to_int(fwd.y * t_proj));
      let pz = ez - (sz + fixed_to_int(fwd.z * t_proj));
      let perp = abs_i64(px) + abs_i64(py) + abs_i64(pz);
      let cone = 900 + t_proj / 5;
      if perp < cone && maze::has_los_3d(sx, sy, sz, ex, ey, ez) {
        best_found = 1;
        best_dist = t_proj;
        best_tx = ex;
        best_ty = ey;
        best_tz = ez;
      }
    }
  }

  (best_found, best_tx, best_ty, best_tz, best_dist)
}

fn spawn_bolt(x: i64, y: i64, z: i64, vx: i64, vy: i64, vz: i64, kind: i64, life: i64) -[Mem]-> unit {
  let _ = GameMem.bolts.try_push(Bolt {
    x: x,
    y: y,
    z: z,
    vx: vx,
    vy: vy,
    vz: vz,
    kind: kind,
    life: life,
  });
}

pub fn fire_player_laser() -[Mem, Gpu]-> unit {
  if GameMem.laser_cd == 0 && GameMem.energy >= 2 {
    GameMem.energy = clamp_stat(GameMem.energy - 2, 100);
    GameMem.laser_cd = 7;
    GameMem.muzzle_t = 4;

    let side = GameMem.laser_side;
    GameMem.laser_side = 1 - side;
    if side == 0 { GameMem.recoil_l = 7; } else { GameMem.recoil_r = 7; }

    let fwd = ship_forward_vec(GameMem.yaw, GameMem.pitch);
    let right_x = fixed_cos(GameMem.yaw);
    let right_z = fixed_sin(GameMem.yaw);
    let wing_sign = if side == 0 { -230 } else { 230 };

    let bx = GameMem.ship_x + fixed_to_int(right_x * wing_sign) + fixed_to_int(fwd.x * 260);
    let by = GameMem.ship_y - 110 + fixed_to_int(fwd.y * 260);
    let bz = GameMem.ship_z + fixed_to_int(right_z * wing_sign) + fixed_to_int(fwd.z * 260);

    let (locked, ltx, lty, ltz, _ld) = find_aim_target();
    let tx = if locked == 1 { ltx } else { GameMem.ship_x + fixed_to_int(fwd.x * 4200) };
    let ty = if locked == 1 { lty } else { GameMem.ship_y + fixed_to_int(fwd.y * 4200) };
    let tz = if locked == 1 { ltz } else { GameMem.ship_z + fixed_to_int(fwd.z * 4200) };

    let dx = tx - bx;
    let dy = ty - by;
    let dz = tz - bz;
    let len = isqrt((dx * dx + dy * dy + dz * dz) / 64) * 8;
    let denom = if len > 40 { len } else { 40 };
    let spd = 650;
    let vx = (dx * spd) / denom;
    let vy = (dy * spd) / denom;
    let vz = (dz * spd) / denom;

    spawn_bolt(bx, by, bz, vx, vy, vz, BoltKind::PlayerLaser, 56);
    sfx_play(SFX_LASER, if side == 0 { 104 } else { 96 }, 80);
  }
}

pub fn fire_player_missile() -[Mem, Gpu]-> unit {
  if GameMem.missile_cd == 0 {
    if GameMem.missiles > 0 {
      GameMem.missiles = clamp_stat(GameMem.missiles - 1, 20);
      GameMem.missile_cd = 26;
      GameMem.muzzle_t = 7;
      GameMem.recoil_l = 10;
      GameMem.recoil_r = 10;

      let fwd = ship_forward_vec(GameMem.yaw, GameMem.pitch);
      let bx = GameMem.ship_x + fixed_to_int(fwd.x * 320);
      let by = GameMem.ship_y - 140 + fixed_to_int(fwd.y * 320);
      let bz = GameMem.ship_z + fixed_to_int(fwd.z * 320);
      let spd = 450;
      spawn_bolt(
        bx, by, bz,
        fixed_to_int(fwd.x * spd),
        fixed_to_int(fwd.y * spd),
        fixed_to_int(fwd.z * spd),
        BoltKind::PlayerMissile,
        82
      );
      sfx_play(SFX_MISSILE, 100, 88);
    } else {
      GameMem.msg_code = 4;
      GameMem.msg_timer = 55;
      sfx_error();
    }
  }
}

// --- Step Bolts (Lasers, Homing Missiles & Enemy Plasma) ---

fn detonate_missile(mx: i64, my: i64, mz: i64) -[Mem, Gpu]-> unit {
  spawn_explosion(mx, my, mz, 16, 2);
  sfx_play(SFX_SHOTGUN, 64, 95);
  for d in 0..18 {
    if GameMem.drones[d].alive == 1 {
      let dist = abs_i64(GameMem.drones[d].x - mx) + abs_i64(GameMem.drones[d].y - my) + abs_i64(GameMem.drones[d].z - mz);
      if dist < 1750 {
        damage_drone(d, if dist < 850 { 105 } else { 62 });
      }
    }
  }
  if GameMem.reactor_hp > 0 {
    let (rx, ry, rz) = reactor_center_xyz();
    let rdist = abs_i64(rx - mx) + abs_i64(ry - my) + abs_i64(rz - mz);
    if rdist < 1950 {
      damage_reactor(90);
    }
  }
}

fn step_bolts() -[Mem, Gpu]-> unit {
  let sx = GameMem.ship_x;
  let sy = GameMem.ship_y;
  let sz = GameMem.ship_z;
  let (rx, ry, rz) = reactor_center_xyz();

  let mut i = 0;
  while i >= 0 && i < GameMem.bolts.len max 40 {
    let mut b = GameMem.bolts[i];
    if b.life <= 0 {
      GameMem.bolts.swap_remove(i);
      continue;
    }
    let kind = b.kind;

    if kind == BoltKind::PlayerMissile {
      let bx = b.x;
      let by = b.y;
      let bz = b.z;
      let mut h_dist = 8200;
      let mut h_tx = bx;
      let mut h_ty = by;
      let mut h_tz = bz;
      let mut has_h = 0;

      for d in 0..18 {
        if GameMem.drones[d].alive == 1 {
          let dd = abs_i64(GameMem.drones[d].x - bx) + abs_i64(GameMem.drones[d].y - by) + abs_i64(GameMem.drones[d].z - bz);
          if dd < h_dist {
            h_dist = dd;
            h_tx = GameMem.drones[d].x;
            h_ty = GameMem.drones[d].y;
            h_tz = GameMem.drones[d].z;
            has_h = 1;
          }
        }
      }
      if GameMem.reactor_hp > 0 {
        let rd = abs_i64(rx - bx) + abs_i64(ry - by) + abs_i64(rz - bz);
        if rd < h_dist {
          h_dist = rd;
          h_tx = rx;
          h_ty = ry;
          h_tz = rz;
          has_h = 1;
        }
      }
      if has_h == 1 && h_dist > 120 {
        let gx = ((h_tx - bx) * 450) / h_dist;
        let gy = ((h_ty - by) * 450) / h_dist;
        let gz = ((h_tz - bz) * 450) / h_dist;
        b.vx = (b.vx * 5 + gx) / 6;
        b.vy = (b.vy * 5 + gy) / 6;
        b.vz = (b.vz * 5 + gz) / 6;
      }
    }

    let nx = b.x + b.vx;
    let ny = b.y + b.vy;
    let nz = b.z + b.vz;
    b.x = nx;
    b.y = ny;
    b.z = nz;
    b.life = b.life - 1;

    if maze::hits_maze_3d(nx, ny, nz, 85) {
      if i < GameMem.bolts.len {
        GameMem.bolts.swap_remove(i);
      }
      if kind == BoltKind::PlayerMissile {
        detonate_missile(nx, ny, nz);
      } else {
        spawn_explosion(nx, ny, nz, 4, 0);
      }
      continue;
    }

    let mut destroyed = b.life <= 0;
    if kind == BoltKind::PlayerLaser || kind == BoltKind::PlayerMissile {
      let mut hit_any = false;
      for d in 0..18 {
        if GameMem.drones[d].alive == 1 {
          let hr = if GameMem.drones[d].kind == DroneKind::Guardian { 560 } else { 470 };
          if abs_i64(nx - GameMem.drones[d].x) < hr
            && abs_i64(ny - GameMem.drones[d].y) < hr
            && abs_i64(nz - GameMem.drones[d].z) < hr
          {
            destroyed = true;
            hit_any = true;
            if kind == BoltKind::PlayerMissile {
              detonate_missile(nx, ny, nz);
            } else {
              damage_drone(d, 22);
            }
            break;
          }
        }
      }
      if !hit_any && GameMem.reactor_hp > 0 {
        if abs_i64(nx - rx) < 820 && abs_i64(ny - ry) < 820 && abs_i64(nz - rz) < 820 {
          destroyed = true;
          if kind == BoltKind::PlayerMissile {
            detonate_missile(nx, ny, nz);
          } else {
            damage_reactor(18);
          }
        }
      }
    } else {
      if abs_i64(nx - sx) < 420 && abs_i64(ny - sy) < 420 && abs_i64(nz - sz) < 420 {
        destroyed = true;
        spawn_explosion(nx, ny, nz, 6, 1);
        damage_ship(9);
      }
    }

    if destroyed {
      if i < GameMem.bolts.len {
        GameMem.bolts.swap_remove(i);
      }
    } else {
      if i < GameMem.bolts.len {
        GameMem.bolts[i] = b;
      }
      i += 1;
    }
  }
}

// --- Step 3D Drones, Reactor Defense & Pickups ---

fn step_drones_and_pickups() -[Mem, Gpu]-> unit {
  let sx = GameMem.ship_x;
  let sy = GameMem.ship_y;
  let sz = GameMem.ship_z;
  let tick = GameMem.tick;

  for pk in 0..16 {
    if GameMem.pickups[pk].active == 1 {
      let dx = abs_i64(sx - GameMem.pickups[pk].x);
      let dy = abs_i64(sy - GameMem.pickups[pk].y);
      let dz = abs_i64(sz - GameMem.pickups[pk].z);
      if dx < 620 && dy < 620 && dz < 620 {
        let k = GameMem.pickups[pk].kind;
        let mut took = false;
        if k == PickupKind::Shield && GameMem.shield < 100 {
          GameMem.shield = clamp_stat(GameMem.shield + 30, 100);
          took = true;
        } else if k == PickupKind::Energy && GameMem.energy < 100 {
          GameMem.energy = clamp_stat(GameMem.energy + 45, 100);
          took = true;
        } else if k == PickupKind::Missiles && GameMem.missiles < 20 {
          GameMem.missiles = clamp_stat(GameMem.missiles + 4, 20);
          took = true;
        }
        if took {
          GameMem.pickups[pk].active = 0;
          GameMem.pickup_t = 10;
          sfx_spawn();
        }
      }
    }
  }

  for i in 0..18 {
    if GameMem.drones[i].alive == 0 { continue; }
    if GameMem.drones[i].flash > 0 { GameMem.drones[i].flash -= 1; }
    GameMem.drones[i].anim = (GameMem.drones[i].anim + 1) & 4095;

    let ex = GameMem.drones[i].x;
    let ey = GameMem.drones[i].y;
    let ez = GameMem.drones[i].z;
    let kind = GameMem.drones[i].kind;
    let dx = sx - ex;
    let dy = sy - ey;
    let dz = sz - ez;
    let dist = abs_i64(dx) + abs_i64(dy) + abs_i64(dz);

    if dist < 13500 && maze::has_los_3d(ex, ey, ez, sx, sy, sz) {
      let ax = abs_i64(dx);
      let az = abs_i64(dz);
      let target_yaw = if az >= ax {
        if dz >= 0 { 0 } else { 2048 }
      } else {
        if dx >= 0 { 1024 } else { 3072 }
      };
      GameMem.drones[i].yaw = target_yaw;

      let spd = if kind == DroneKind::Scout { 56 } else if kind == DroneKind::Vulcan { 44 } else { 36 };
      let mut mvx = 0;
      let mut mvy = 0;
      let mut mvz = 0;
      if dist > 2500 {
        mvx = (dx * spd) / (dist + 1);
        mvy = (dy * spd) / (dist + 1);
        mvz = (dz * spd) / (dist + 1);
      } else if dist < 1500 {
        mvx = -(dx * spd) / (dist + 1);
        mvy = -(dy * spd) / (dist + 1);
        mvz = -(dz * spd) / (dist + 1);
      }
      let orb = sin_1024(tick * 24 + i * 256);
      mvx += (orb * 24) / 1024;
      mvy += (cos_1024(tick * 32 + i * 310) * 20) / 1024;

      let nx = ex + mvx;
      if !maze::hits_maze_3d(nx, ey, ez, 480) { GameMem.drones[i].x = nx; }
      let cur_x = GameMem.drones[i].x;
      let ny = ey + mvy;
      if !maze::hits_maze_3d(cur_x, ny, ez, 480) { GameMem.drones[i].y = ny; }
      let cur_y = GameMem.drones[i].y;
      let nz = ez + mvz;
      if !maze::hits_maze_3d(cur_x, cur_y, nz, 480) { GameMem.drones[i].z = nz; }

      let cd = GameMem.drones[i].cd - 1;
      if cd <= 0 {
        let bspd = if kind == DroneKind::Guardian { 265 } else { 230 };
        let bvx = (dx * bspd) / (dist + 1);
        let bvy = (dy * bspd) / (dist + 1);
        let bvz = (dz * bspd) / (dist + 1);
        spawn_bolt(GameMem.drones[i].x, GameMem.drones[i].y, GameMem.drones[i].z, bvx, bvy, bvz, BoltKind::EnemyPlasma, 65);
        sfx_tone(290, 60, 1);
        GameMem.drones[i].cd = if kind == DroneKind::Guardian { 48 } else if kind == DroneKind::Vulcan { 58 } else { 70 };
      } else {
        GameMem.drones[i].cd = cd;
      }
    } else {
      let hy = GameMem.drones[i].home_y + (sin_1024(tick * 18 + i * 300) * 160) / 1024;
      if !maze::hits_maze_3d(ex, hy, ez, 480) {
        GameMem.drones[i].y = hy;
      }
      GameMem.drones[i].yaw = (GameMem.drones[i].yaw + 14) & 4095;
    }
  }

  if GameMem.reactor_hp > 0 && (tick % 64) == 0 {
    let (rx, ry, rz) = reactor_center_xyz();
    let rdist = abs_i64(sx - rx) + abs_i64(sy - ry) + abs_i64(sz - rz);
    if rdist < 7200 && maze::has_los_3d(rx, ry, rz, sx, sy, sz) {
      let bvx = ((sx - rx) * 245) / (rdist + 1);
      let bvy = ((sy - ry) * 245) / (rdist + 1);
      let bvz = ((sz - rz) * 245) / (rdist + 1);
      spawn_bolt(rx, ry, rz, bvx, bvy, bvz, BoltKind::EnemyPlasma, 64);
      sfx_tone(210, 85, 2);
    }
  }
}

// --- Main 6-DOF Simulation Tick ---

pub fn step_ceres_sim(
  fwd_in: i64, strafe_in: i64, vert_in: i64,
  turn_yaw: i64, turn_pitch: i64,
  fire_laser: i64, fire_missile: i64
) -[Mem, Gpu]-> unit {
  let tick = GameMem.tick + 1;
  GameMem.tick = tick;

  if GameMem.phase == GamePhase::Playing || GameMem.phase == GamePhase::Escape {
    if GameMem.laser_cd > 0 { GameMem.laser_cd -= 1; }
    if GameMem.missile_cd > 0 { GameMem.missile_cd -= 1; }
    if GameMem.recoil_l > 0 { GameMem.recoil_l -= 1; }
    if GameMem.recoil_r > 0 { GameMem.recoil_r -= 1; }
    if GameMem.muzzle_t > 0 { GameMem.muzzle_t -= 1; }
    if GameMem.hurt_t > 0 { GameMem.hurt_t -= 1; }
    if GameMem.pickup_t > 0 { GameMem.pickup_t -= 1; }
    if GameMem.reactor_flash > 0 { GameMem.reactor_flash -= 1; }
    if GameMem.msg_timer > 0 { GameMem.msg_timer -= 1; }

    if (tick % 9) == 0 && GameMem.energy < 100 {
      GameMem.energy = clamp_stat(GameMem.energy + 1, 100);
    }

    let nyaw = (GameMem.yaw + turn_yaw + 4096) & 4095;
    let npitch = clamp_pitch(GameMem.pitch + turn_pitch);
    GameMem.yaw = nyaw;
    GameMem.pitch = npitch;

    let target_bank = clamp_i64(strafe_in * 24 + clamp_i64(turn_yaw, -32, 32), -42, 42);
    GameMem.bank_vis = (GameMem.bank_vis * 4 + target_bank) / 5;

    let fwd = ship_forward_vec(nyaw, npitch);
    let right_x = fixed_cos(nyaw);
    let right_z = fixed_sin(nyaw);

    let thrust = 29.0;
    let ax = (fwd.x * fwd_in + right_x * strafe_in) * thrust;
    let ay = (fwd.y * fwd_in + fixed(vert_in)) * thrust;
    let az = (fwd.z * fwd_in + right_z * strafe_in) * thrust;

    let vx = fixed_clamp(GameMem.vel_x * 0.88 + ax, -295.0, 295.0);
    let vy = fixed_clamp(GameMem.vel_y * 0.88 + ay, -270.0, 270.0);
    let vz = fixed_clamp(GameMem.vel_z * 0.88 + az, -295.0, 295.0);

    let mut px = GameMem.ship_x;
    let mut py = GameMem.ship_y;
    let mut pz = GameMem.ship_z;
    let mut fvx = vx;
    let mut fvy = vy;
    let mut fvz = vz;

    // Independent X, Y, Z 3D wall-sliding collision through chambers & octagonal tubes
    let nx = px + fixed_to_int(fvx);
    if !maze::hits_maze_3d(nx, py, pz, 420) {
      px = nx;
    } else {
      fvx = -fvx * 0.15;
    }

    let ny = py + fixed_to_int(fvy);
    if !maze::hits_maze_3d(px, ny, pz, 420) {
      py = ny;
    } else {
      fvy = -fvy * 0.15;
    }

    let nz = pz + fixed_to_int(fvz);
    if !maze::hits_maze_3d(px, py, nz, 420) {
      pz = nz;
    } else {
      fvz = -fvz * 0.15;
    }

    // Prevent flying straight through intact Reactor Core sphere
    if GameMem.reactor_hp > 0 {
      let (rx, ry, rz) = reactor_center_xyz();
      if abs_i64(px - rx) < 880 && abs_i64(py - ry) < 880 && abs_i64(pz - rz) < 880 {
        px = GameMem.ship_x;
        py = GameMem.ship_y;
        pz = GameMem.ship_z;
        fvx = -fvx * 0.5;
        fvy = -fvy * 0.5;
        fvz = -fvz * 0.5;
      }
    }

    // 3D Mass-Weighted Elastic Ship-to-Drone Collisions (no flying through enemy hulls)
    for d in 0..18 {
      if GameMem.drones[d].alive == 0 { continue; }
      let ex = GameMem.drones[d].x;
      let ey = GameMem.drones[d].y;
      let ez = GameMem.drones[d].z;
      let kind = GameMem.drones[d].kind;
      let d_rad = if kind == DroneKind::Guardian { 580 } else if kind == DroneKind::Vulcan { 470 } else { 390 };
      let min_dist = 420 + d_rad;
      let dx = px - ex;
      let dy = py - ey;
      let dz = pz - ez;
      if abs_i64(dx) < min_dist && abs_i64(dy) < min_dist && abs_i64(dz) < min_dist {
        let sdx = dx / 10;
        let sdy = dy / 10;
        let sdz = dz / 10;
        let dist2 = sdx * sdx + sdy * sdy + sdz * sdz;
        let md10 = min_dist / 10;
        if dist2 < md10 * md10 {
          let dist10 = clamp_i64(isqrt(dist2), 1, md10);
          let dist = dist10 * 10;
          let nx = if dist2 == 0 { 1000 } else { (dx * 1000) / dist };
          let ny = if dist2 == 0 { 0 } else { (dy * 1000) / dist };
          let nz = if dist2 == 0 { 0 } else { (dz * 1000) / dist };
          let overlap = min_dist - dist + 24;

          // Mass-weighted separation & elastic impulse (Ship=100, Scout=55, Vulcan=110, Guardian=220)
          let d_mass = if kind == DroneKind::Guardian { 220 } else if kind == DroneKind::Vulcan { 110 } else { 55 };
          let total_m = 100 + d_mass;
          let ship_share = (d_mass * 100) / total_m;
          let drone_share = (100 * 100) / total_m;

          let spx = px + (nx * overlap * ship_share) / 100000;
          let spy = py + (ny * overlap * ship_share) / 100000;
          let spz = pz + (nz * overlap * ship_share) / 100000;
          if !maze::hits_maze_3d(spx, spy, spz, 420) {
            px = spx;
            py = spy;
            pz = spz;
          }

          let dpx = ex - (nx * (overlap + 140) * drone_share) / 100000;
          let dpy = ey - (ny * (overlap + 140) * drone_share) / 100000;
          let dpz = ez - (nz * (overlap + 140) * drone_share) / 100000;
          if !maze::hits_maze_3d(dpx, dpy, dpz, 480) {
            GameMem.drones[d].x = dpx;
            GameMem.drones[d].y = dpy;
            GameMem.drones[d].z = dpz;
          }

          let rel_spd = abs_i64(fixed_to_int(fvx)) + abs_i64(fixed_to_int(fvy)) + abs_i64(fixed_to_int(fvz));
          let bounce = clamp_i64(((135 + rel_spd / 2) * ship_share) / 100, 75, 250);
          fvx = fixed_clamp(fvx + fixed((nx * bounce) / 1000), -295.0, 295.0);
          fvy = fixed_clamp(fvy + fixed((ny * bounce) / 1000), -270.0, 270.0);
          fvz = fixed_clamp(fvz + fixed((nz * bounce) / 1000), -295.0, 295.0);

          GameMem.drones[d].flash = 5;
          spawn_explosion((px + ex) / 2, (py + ey) / 2, (pz + ez) / 2, 5, 1);
          let clank_pit = if kind == DroneKind::Guardian { 52 } else if kind == DroneKind::Vulcan { 68 } else { 86 };
          sfx_play(SFX_CLACK, clank_pit, 86);
          if GameMem.hurt_t == 0 {
            let hull_dmg = if kind == DroneKind::Guardian { 8 } else if kind == DroneKind::Vulcan { 6 } else { 4 };
            damage_ship(hull_dmg);
          }
        }
      }
    }

    GameMem.ship_x = px;
    GameMem.ship_y = py;
    GameMem.ship_z = pz;
    GameMem.vel_x = fvx;
    GameMem.vel_y = fvy;
    GameMem.vel_z = fvz;

    let (locked, _lx, _ly, _lz, ldist) = find_aim_target();
    GameMem.lock_active = if locked == 1 { 1 } else { 0 };
    GameMem.lock_dist = ldist;

    if fire_laser == 1 { fire_player_laser(); }
    if fire_missile == 1 { fire_player_missile(); }

    step_bolts();
    step_drones_and_pickups();
    step_particles();

    if GameMem.phase == GamePhase::Escape {
      if GameMem.escape_ticks > 0 {
        GameMem.escape_ticks -= 1;
        if (GameMem.escape_ticks % 60) == 0 && GameMem.escape_ticks > 0 {
          sfx_tone(if GameMem.escape_ticks < 600 { 720 } else { 520 }, 90, 2);
        }
        let (ex, ey, ez) = exit_center_xyz();
        if abs_i64(px - ex) < 1900 && abs_i64(py - ey) < 1600 && abs_i64(pz - ez) < 1900 {
          GameMem.phase = GamePhase::Victory;
          sfx_win();
        }
      } else {
        GameMem.phase = GamePhase::Dead;
        spawn_explosion(px, py, pz, 18, 2);
        sfx_play(SFX_SHOTGUN, 45, 100);
      }
    }

    let r_dead = if GameMem.reactor_hp == 0 { 1 } else { 0 };
    let esc_s = clamp_i64(GameMem.escape_ticks / 60, 0, 60);
    GameMem.score = compute_ceres_score(GameMem.kills, r_dead, GameMem.shield, if GameMem.phase == GamePhase::Victory { esc_s } else { 0 });
  } else {
    step_particles();
  }
}
