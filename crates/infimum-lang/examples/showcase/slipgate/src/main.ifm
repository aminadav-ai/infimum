// INFIMUM SLIPGATE — Native .ifw Capsule Entrypoint for `infimum-web`
// 100% Clean-Room Infimum Lang (Telos + Flux + Strata) • Zero JS / Zero Chromium

use "abi.ifm";
use "logic.ifm" as logic;
use "render.ifm" as render;

export fn init_app(seed: i64, _vw: i64, _vh: i64) -[Mem, Gpu]-> i64 {
  FpsMem.prev_r_key = 0;
  FpsMem.prev_sp_key = 0;
  logic::reset_slipgate(seed);
  1
}

export fn step_ui(
  vw: i64, vh: i64,
  mx: i64, my: i64,
  m_down: i64, m_clicked: i64,
  _wheel_dy: i64, key_char: i64, _key_special: i64
) -[Mem, Gpu]-> i64 {
  let w = clamp_i64(vw, 560, 4096);
  let h = clamp_i64(vh, 460, 2160);
  gfx_begin_frame(w, h);

  // Instant restart [R]
  let r_now = if key_held(KEY_R) || key_char == 'r' || key_char == 'R' { 1 } else { 0 };
  if r_now == 1 && FpsMem.prev_r_key == 0 {
    logic::reset_slipgate(FpsMem.rng_state + FpsMem.tick + 9973);
    sfx_play(SFX_CLICK, 110, 75);
  }
  FpsMem.prev_r_key = r_now;

  // WASD movement + Arrow keys or locked raw MouseMotion (infinite 360° yaw + pitch!)
  let mut fwd = 0;
  let mut strafe = 0;
  let mut turn = 0;
  if key_held(KEY_W) || key_held(KEY_UP) { fwd += 1; }
  if key_held(KEY_S) || key_held(KEY_DOWN) { fwd -= 1; }
  if key_held(KEY_A) { strafe -= 1; }
  if key_held(KEY_D) { strafe += 1; }
  if key_held(KEY_LEFT) { turn -= 48; }
  if key_held(KEY_RIGHT) { turn += 48; }

  let locked = pointer_locked();
  let mut fire = 0;
  if FpsMem.game_state == GameState::Playing {
    if !locked && m_clicked == 1 {
      // First click locks the cursor for infinite 360° FPS mouselook (Esc unlocks)
      set_pointer_lock(true);
    } else if locked {
      let rdx = mouse_dx();
      let rdy = mouse_dy();
      turn += rdx * 5;
      FpsMem.pitch = logic::clamp_pitch(FpsMem.pitch - rdy);
      if m_clicked == 1 || m_down == 1 || key_held(KEY_E) { fire = 1; }
    } else if key_held(KEY_E) {
      fire = 1;
    }
  } else if locked {
    set_pointer_lock(false);
  }

  let sp_now = if key_held(KEY_SPACE) || key_char == ' ' { 1 } else { 0 };
  let jump = if sp_now == 1 && FpsMem.prev_sp_key == 0 { 1 } else { 0 };
  FpsMem.prev_sp_key = sp_now;

  logic::step_fps_sim(fwd, strafe, turn, jump, fire);
  render::render_slipgate_frame(w, h, mx, my, m_clicked);
  gfx_end_frame()
}

test "init builds 6-zone citadel and spawns player" {
  let _ = init_app(777, 1024, 768);
  assert(FpsMem.game_state == GameState::Playing);
  assert(FpsMem.health == 100);
  assert(FpsMem.ammo > 0);
  assert(FpsMem.walls.len > 20);
  assert(FpsMem.sectors.len > 5);
}

test "clamp_pitch stays within vertical look bounds" {
  assert(logic::clamp_pitch(999) == 260);
  assert(logic::clamp_pitch(-999) == -260);
  assert(logic::clamp_pitch(45) == 45);
}

test "player cannot walk through living enemy" {
  let _ = init_app(777, 1024, 768);
  let ex = FpsMem.enemies[0].x;
  let ey = FpsMem.enemies[0].y;
  let ez = FpsMem.enemies[0].z;
  assert(logic::hits_enemy_3d(ex, ey, ez, 280, -1));
  assert(logic::hits_enemy_3d(ex + 200, ey, ez, 280, -1));
  // Dead monster does not block passage
  FpsMem.enemies[0].state = 2;
  assert(!logic::hits_enemy_3d(ex, ey, ez, 280, -1));
}
