// INFIMUM SLIPGATE — Shared Typed ABI & Memory Layout (Z3-Verified, Large 6-Zone Citadel)

pub use "std/prelude.ifm";
pub use "std/mesh3d.ifm";

pub const ENEMY_COUNT: i64 = 16;
pub const ITEM_COUNT: i64 = 16;
pub const PARTICLE_COUNT: i64 = 32;
pub const MAX_WALLS: i64 = 112;
pub const MAX_SECTORS: i64 = 40;
pub const MAT_ROCK: i64 = 7;
pub const MAT_TIMBER: i64 = 8;

pub enum GameState {
  Playing = 0,
  Victory = 1,
  Dead = 2,
}

pub enum CursorKind {
  Default = 0,
  Pointer = 1,
}

pub struct Sector {
  x0: word,
  z0: word,
  x1: word,
  z1: word,
  fy: word,
  mat: word,
  col: word,
  pad: word,
}

pub struct Wall {
  x0: word,
  z0: word,
  x1: word,
  z1: word,
  y0: word,
  y1: word,
  mat: word,
  col: word,
}

pub struct Enemy {
  x: word,
  y: word,
  z: word,
  kind: word,
  hp: word,
  state: word,
  cd: word,
  flash: word,
  anim: word,
  pad: word,
  spawn_x: word,
  spawn_z: word,
}

pub struct Item {
  x: word,
  y: word,
  z: word,
  kind: word,
  active: word,
  pad: word,
}

pub struct Particle {
  x: word,
  y: word,
  z: word,
  vx: word,
  vy: word,
  vz: word,
  col: word,
  life: word,
}

// Auto-placed non-overlapping linear memory layout (compiler safely places at word 705536+)
pub layout FpsMem {
  tick: word,
  cam_x: word,
  cam_y: word,
  cam_z: word,
  yaw: word,                      // 0..4095 (matching std/math.ifm sin_1024/cos_1024!)
  pitch: word inv -260..=260,     // -260..260 vertical look offset
  foot_y: word,
  vel_y: word,
  health: word,
  armor: word,
  ammo: word,
  kills: word,
  score: word,
  muzzle_t: word,
  recoil_t: word,
  hurt_t: word,
  pickup_t: word,
  bob_t: word,
  game_state: word inv 0..=2,
  on_ground: word inv 0..=1,
  rng_state: word,
  has_key: word inv 0..=1,
  gate_y: word,
  prev_r_key: word,
  prev_sp_key: word,
  msg_timer: word,

  // Walkable sectors: dynamic vec of up to 40 typed Sector structs
  sectors: vec<Sector>[40],
  // Solid 3D box colliders/pillars/walls: dynamic vec of up to 112 typed Wall structs
  walls: vec<Wall>[112],
  // 16 typed Enemy structs
  enemies: Enemy[16],
  // 16 typed Item structs
  items: Item[16],
  // 32 typed Particle structs
  particles: vec<Particle>[32],
}
