//
// Reference B2B Capsule #1: FinTech Pricing & Tax Engine
// - Exact decimal money arithmetic (`dec64`, 10^-4 scale, zero IEEE-754 drift)
// - Formal Z3 contract proofs on pricing/discount invariants
// - Zero-copy UTF-8 JSON reader + safe escaping JsonWriter (`std/json.ifm` v2)
// - Unified Headless B2B ABI (`std/capsule.ifm`)

use "std/capsule.ifm";
use "std/json.ifm";
use "std/dec.ifm";

pub enum PricingErr {
  InvalidAmount   = 2001,
  InvalidTaxRate  = 2002,
  InvalidDiscount = 2003,
}

/// Formally verified pricing calculation:
/// Given non-negative amount <= 10,000,000.00, discount_pct in [0.0, 0.5], and tax_rate in [0.0, 0.3],
/// Z3 proves that the resulting total is always non-negative and never overflows dec64.
pub fn calc_total_with_tax(amount: dec64, discount_pct: dec64, tax_rate: dec64) -> dec64
  req amount >= 0.0d && amount <= 10000000.0d
  req discount_pct >= 0.0d && discount_pct <= 0.5d
  req tax_rate >= 0.0d && tax_rate <= 0.3d
  ens result >= 0.0d
{
  let discount = amount * discount_pct;
  let net = amount - discount;
  let tax = net * tax_rate;
  net + tax
}

fn handle_pricing(input: [u8], out: [u8]) -[Mem]-> Result<i64, i64> {
  let amount = json_get_dec64(input, "amount")?;
  let tax_rate = json_get_dec64(input, "tax_rate")?;
  let discount_pct = json_get_dec64(input, "discount_pct").unwrap_or(0.0d);
  let currency = json_get_str_raw(input, "currency").unwrap_or("USD");

  if amount < 0.0d || amount > 10000000.0d {
    Err(PricingErr::InvalidAmount)
  } else if discount_pct < 0.0d || discount_pct > 0.5d {
    Err(PricingErr::InvalidDiscount)
  } else if tax_rate < 0.0d || tax_rate > 0.3d {
    Err(PricingErr::InvalidTaxRate)
  } else {
    let discount = dec64_clamp(dec64_round_half_even_cents(amount * discount_pct), 0.0d, amount);
    let net = dec64_clamp(amount - discount, 0.0d, 10000000.0d);
    let tax = dec64_clamp(dec64_round_half_even_cents(net * tax_rate), 0.0d, 10000000.0d);
    // Accounting invariant: rounded line items sum cleanly (`net + tax == total`)
    let total = net + tax;

    let w = jw_begin_obj(out);
    let w = jw_kv_str(out, w, "status", "ok");
    let w = jw_kv_str(out, w, "currency", currency);
    let w = jw_kv_dec64(out, w, "net_amount", net);
    let w = jw_kv_dec64(out, w, "tax", tax);
    let w = jw_kv_dec64(out, w, "total", total);
    let w = jw_kv_int(out, w, "total_cents", dec64_to_cents(total));
    jw_end_obj(out, w)
  }
}

export fn cap_execute(in_len: i64) -[Mem]-> i64 {
  let input = cap_input(in_len);
  let out = cap_output_buf();
  cap_finish(handle_pricing(input, out))
}

test "fintech_pricing exact dec64 tax and discount" {
  let total = calc_total_with_tax(100.00d, 0.10d, 0.20d);
  assert(total == 108.00d);
  assert(dec64_to_cents(total) == 10800);
}

test "fintech_pricing zero discount preserves cents" {
  let total = calc_total_with_tax(19.99d, 0.0d, 0.0d);
  assert(total == 19.99d);
  assert(dec64_to_cents(total) == 1999);
}
