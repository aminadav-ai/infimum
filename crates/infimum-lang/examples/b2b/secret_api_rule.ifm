//
// Reference B2B Capsule #3: Zero-Trust Secret API Rule
// - Reads Vault-injected secret as taint-tracked `Secret<str>` via `cap_read_secret`
// - Statically pins secret disclosure to `Net("api.stripe.com")` via `reveal("api.stripe.com", ...)`
// - Impossible to leak `Secret<str>` into `output_buf` or any unauthorized domain
// - Host runtime (`infimum-rt`) zeroizes `secret_buf` immediately after `cap_execute`

use "std/capsule.ifm";
use "std/json.ifm";
use "std/dec.ifm";

pub enum StripeRuleErr {
  AmountOutOfBounds = 4001,
  UpstreamRejected  = 4002,
}

/// Formally verified payout risk guard:
/// Z3 guarantees only amounts in `(0.0d, 10000.0d]` are eligible for automated dispatch.
pub fn is_charge_within_limit(amount: dec64) -> bool
  ens result == (amount > 0.0d && amount <= 10000.0d)
{
  amount > 0.0d && amount <= 10000.0d
}

fn dispatch_stripe_charge(api_key: Secret<str>) -[Mem, Net("api.stripe.com")]-> bool {
  // Formal domain-pinned secret pipe recorded in SecurityPassport.secret_pipes:
  do Net.auth(reveal("api.stripe.com", api_key));
  // Host-enforced HTTPS call (op=60, url, dst_byte_ptr=0):
  do Net.call(60, "https://api.stripe.com/v1/charges", 0);
  true
}

fn handle_stripe_rule(input: [u8], out: [u8]) -[Mem, Net("api.stripe.com")]-> Result<i64, i64> {
  let amount = json_get_dec64(input, "amount")?;
  let currency = json_get_str_raw(input, "currency").unwrap_or("USD");

  if !is_charge_within_limit(amount) {
    Err(StripeRuleErr::AmountOutOfBounds)
  } else {
    let api_key = cap_read_secret(32);
    let _sent = dispatch_stripe_charge(api_key);
    let w = jw_begin_obj(out);
    let w = jw_kv_str(out, w, "status", "dispatched");
    let w = jw_kv_str(out, w, "provider", "api.stripe.com");
    let w = jw_kv_dec64(out, w, "amount", amount);
    let w = jw_kv_str(out, w, "currency", currency);
    jw_end_obj(out, w)
  }
}

export fn cap_execute(in_len: i64) -[Mem, Net("api.stripe.com")]-> i64 {
  let input = cap_input(in_len);
  let out = cap_output_buf();
  cap_finish(handle_stripe_rule(input, out))
}

test "secret_api_rule amount guard" {
  assert(is_charge_within_limit(49.95d));
  assert(!is_charge_within_limit(0.0d));
  assert(!is_charge_within_limit(25000.0d));
}
