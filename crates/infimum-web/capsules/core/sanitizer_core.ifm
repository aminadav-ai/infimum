//
// Z3-Verified Zero-JS HTML Sanitizer Core (`Legacy HTML -> Clean Structured Text`).
// Strips <script>, <style>, <iframe>, <svg>, <noscript>, HTML comments, and all
// attributes/event handlers before a single character reaches any capsule.

use "std/math.ifm";
use "std/slice.ifm";
use "std/utf8.ifm";

const MAX_IN_BYTES: i64 = 65536;
const MAX_OUT_BYTES: i64 = 65536;

// Skip-block kinds for raw-text elements
enum SkipKind {
  None = 0,
  Script = 1,
  Style = 2,
  Iframe = 3,
  Svg = 4,
  Noscript = 5,
}

// Tag classification IDs
enum TagKind {
  Other = 0,
  Script = 1,
  Style = 2,
  Iframe = 3,
  Svg = 4,
  Noscript = 5,
  Heading = 6,
  Li = 7,
  Block = 8,
  Cell = 9,
  Br = 10,
}

// Auto-placed UTF-8 byte layout with self-describing ABI getters for `infimum-web/src/sanitizer.rs`.
layout SanMem {
  out_len: word inv 0..=65536,
  stripped_scripts: word,
  stripped_iframes: word,
  stripped_tags: word,
  in_buf: bytes[65536],
  out_buf: bytes[65536],
}

export fn core_abi_version() -> i64 { 2 }
export fn get_out_len_word() -> i64 { SanMem::out_len }
export fn get_stripped_scripts_word() -> i64 { SanMem::stripped_scripts }
export fn get_stripped_iframes_word() -> i64 { SanMem::stripped_iframes }
export fn get_stripped_tags_word() -> i64 { SanMem::stripped_tags }
export fn get_in_buf_word() -> i64 { SanMem::in_buf }
export fn get_out_buf_word() -> i64 { SanMem::out_buf }

fn to_ascii_lower(c: i64) -> i64 {
  if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

fn is_ws(c: i64) -> bool {
  c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 160
}

fn in_at(idx: i64, n: i64) -[Mem]-> i64 {
  if idx >= 0 && idx < n && idx < MAX_IN_BYTES {
    SanMem.in_buf[idx]
  } else {
    0
  }
}

fn out_push_byte(b: i64) -[Mem]-> unit {
  let l = SanMem.out_len;
  if l < MAX_OUT_BYTES && b >= 0 && b <= 255 {
    SanMem.out_buf[l] = u8(b);
    SanMem.out_len = l + 1;
  }
}

fn out_push(cp: i64) -[Mem]-> unit {
  let l = SanMem.out_len;
  if cp >= 0 && cp <= 127 {
    if l < MAX_OUT_BYTES {
      SanMem.out_buf[l] = u8(cp);
      SanMem.out_len = l + 1;
    }
  } else if l < MAX_OUT_BYTES {
    let w = utf8_encode(cp, SanMem.out_buf[..], l);
    SanMem.out_len = clamp_i64(l + w, 0, MAX_OUT_BYTES);
  }
}

fn out_trim_trailing_spaces() -[Mem]-> unit {
  let mut l = SanMem.out_len;
  while l > 0 && l <= MAX_OUT_BYTES max 64 {
    if SanMem.out_buf[l - 1] == ' ' {
      l -= 1;
    } else {
      break;
    }
  }
  SanMem.out_len = clamp_i64(l, 0, MAX_OUT_BYTES);
}

fn out_ensure_newline() -[Mem]-> unit {
  out_trim_trailing_spaces();
  let l = SanMem.out_len;
  if l > 0 && SanMem.out_buf[l - 1] != '\n' {
    out_push('\n');
  }
}

fn out_push_word_sep() -[Mem]-> unit {
  let l = SanMem.out_len;
  if l > 0 {
    let last = SanMem.out_buf[l - 1];
    if last != '\n' && last != ' ' {
      out_push(' ');
    }
  }
}

fn in_matches_ci(pos: i64, n: i64, pat: str) -[Mem]-> bool {
  let ps = pat.as_bytes();
  let lim = clamp_i64(n, 0, MAX_IN_BYTES);
  if pos < 0 || ps.len < 0 || pos + ps.len > lim {
    false
  } else {
    bytes_eq_ascii_ci(SanMem.in_buf[pos..pos + ps.len], ps)
  }
}

// Classify HTML tag name at [start..start+tlen)
fn classify_tag(start: i64, tlen: i64, n: i64) -[Mem]-> i64 {
  let lim = clamp_i64(n, 0, MAX_IN_BYTES);
  if start < 0 || tlen <= 0 || start + tlen > lim {
    TagKind::Other
  } else {
    let tag = SanMem.in_buf[start..start + tlen];
    match tlen {
      1 => if bytes_eq_ascii_ci(tag, "p".as_bytes()) { TagKind::Block } else { TagKind::Other },
      2 => {
        if bytes_eq_ascii_ci(tag, "h1".as_bytes())
          || bytes_eq_ascii_ci(tag, "h2".as_bytes())
          || bytes_eq_ascii_ci(tag, "h3".as_bytes())
        {
          TagKind::Heading
        } else if bytes_eq_ascii_ci(tag, "li".as_bytes()) {
          TagKind::Li
        } else if bytes_eq_ascii_ci(tag, "br".as_bytes()) {
          TagKind::Br
        } else if bytes_eq_ascii_ci(tag, "tr".as_bytes()) {
          TagKind::Block
        } else if bytes_eq_ascii_ci(tag, "td".as_bytes()) || bytes_eq_ascii_ci(tag, "th".as_bytes()) {
          TagKind::Cell
        } else {
          TagKind::Other
        }
      },
      3 => {
        if bytes_eq_ascii_ci(tag, "div".as_bytes()) {
          TagKind::Block
        } else if bytes_eq_ascii_ci(tag, "svg".as_bytes()) {
          TagKind::Svg
        } else {
          TagKind::Other
        }
      },
      5 => if bytes_eq_ascii_ci(tag, "style".as_bytes()) { TagKind::Style } else { TagKind::Other },
      6 => {
        if bytes_eq_ascii_ci(tag, "script".as_bytes()) {
          TagKind::Script
        } else if bytes_eq_ascii_ci(tag, "iframe".as_bytes()) {
          TagKind::Iframe
        } else {
          TagKind::Other
        }
      },
      7 => {
        if bytes_eq_ascii_ci(tag, "section".as_bytes())
          || bytes_eq_ascii_ci(tag, "article".as_bytes())
        {
          TagKind::Block
        } else {
          TagKind::Other
        }
      },
      8 => if bytes_eq_ascii_ci(tag, "noscript".as_bytes()) { TagKind::Noscript } else { TagKind::Other },
      _ => TagKind::Other,
    }
  }
}

// Check if position `pos` matches `</script>`, `</style>`, `</iframe>`, `</svg>`, or `</noscript>`
fn match_skip_end(pos: i64, n: i64, kind: i64) -[Mem]-> i64 {
  match kind {
    SkipKind::Script => if in_matches_ci(pos, n, "</script>") { 9 } else { 0 },
    SkipKind::Style => if in_matches_ci(pos, n, "</style>") { 8 } else { 0 },
    SkipKind::Iframe => if in_matches_ci(pos, n, "</iframe>") { 9 } else { 0 },
    SkipKind::Svg => if in_matches_ci(pos, n, "</svg>") { 6 } else { 0 },
    SkipKind::Noscript => if in_matches_ci(pos, n, "</noscript>") { 11 } else { 0 },
    _ => 0,
  }
}

// Decode common HTML entities at `pos` (where in_at(pos) == '&').
// Returns tuple `(consumed_len, decoded_codepoint)`, or `(0, 0)` if not a known entity.
fn decode_entity_at(pos: i64, n: i64) -[Mem]-> (i64, i64) {
  if in_at(pos, n) != '&' {
    (0, 0)
  } else if in_matches_ci(pos, n, "&lt;") {
    (4, '<')
  } else if in_matches_ci(pos, n, "&gt;") {
    (4, '>')
  } else if in_matches_ci(pos, n, "&amp;") {
    (5, '&')
  } else if in_matches_ci(pos, n, "&#39;") {
    (5, '\'')
  } else if in_matches_ci(pos, n, "&nbsp;") {
    (6, ' ')
  } else if in_matches_ci(pos, n, "&quot;") {
    (6, '"')
  } else if in_matches_ci(pos, n, "&bull;") {
    (6, 8226)
  } else if in_matches_ci(pos, n, "&mdash;") {
    (7, 8212)
  } else if in_matches_ci(pos, n, "&ndash;") {
    (7, '-')
  } else {
    (0, 0)
  }
}

export fn sanitize_html_ifm(raw_len: i64) -[Mem]-> i64 {
  let n = clamp_i64(raw_len, 0, MAX_IN_BYTES);
  SanMem.out_len = 0;
  SanMem.stripped_scripts = 0;
  SanMem.stripped_iframes = 0;
  SanMem.stripped_tags = 0;

  let mut i = 0;
  let mut skip_kind = SkipKind::None;
  let mut pending_ws = false;

  while i < n max 65536 {
    if skip_kind != SkipKind::None {
      let end_len = match_skip_end(i, n, skip_kind);
      if end_len > 0 {
        i += end_len;
        skip_kind = SkipKind::None;
      } else {
        i += 1;
      }
    } else if in_at(i, n) == '<' && in_at(i + 1, n) == '!' && in_at(i + 2, n) == '-' && in_at(i + 3, n) == '-' {
      // HTML comment: skip until `-->`
      let mut next_i = n;
      for j in (i + 4)..(n - 2) max 65536 {
        if in_at(j, n) == '-' && in_at(j + 1, n) == '-' && in_at(j + 2, n) == '>' {
          next_i = j + 3;
          break;
        }
      }
      i = next_i;
    } else if in_at(i, n) == '<' {
      // Scan to matching '>'
      let mut gt = -1;
      for k in (i + 1)..n max 4096 {
        if in_at(k, n) == '>' {
          gt = k;
          break;
        }
      }
      if gt < 0 {
        i = n;
      } else {
        SanMem.stripped_tags = SanMem.stripped_tags + 1;
        let mut tpos = i + 1;
        while tpos < gt && is_ws(in_at(tpos, n)) max 64 {
          tpos += 1;
        }
        let is_closing = tpos < gt && in_at(tpos, n) == '/';
        if is_closing { tpos += 1; }
        let name_start = tpos;
        let mut name_end = gt;
        for k in tpos..gt max 32 {
          let ch = in_at(k, n);
          if is_ws(ch) || ch == '/' {
            name_end = k;
            break;
          }
        }
        let tag_kind = classify_tag(name_start, name_end - name_start, n);
        if !is_closing {
          match tag_kind {
            TagKind::Script => {
              SanMem.stripped_scripts = SanMem.stripped_scripts + 1;
              skip_kind = SkipKind::Script;
            },
            TagKind::Style => { skip_kind = SkipKind::Style; },
            TagKind::Iframe => {
              SanMem.stripped_iframes = SanMem.stripped_iframes + 1;
              skip_kind = SkipKind::Iframe;
            },
            TagKind::Svg => { skip_kind = SkipKind::Svg; },
            TagKind::Noscript => { skip_kind = SkipKind::Noscript; },
            TagKind::Heading => {
              out_ensure_newline();
              out_push('#');
              out_push(' ');
              pending_ws = false;
            },
            TagKind::Li => {
              out_ensure_newline();
              out_push(8226);
              out_push(' ');
              pending_ws = false;
            },
            TagKind::Block => {
              out_ensure_newline();
              pending_ws = false;
            },
            TagKind::Br => {
              out_ensure_newline();
              pending_ws = false;
            },
            TagKind::Cell => {
              out_push(' ');
              out_push('|');
              out_push(' ');
              pending_ws = false;
            },
            _ => {},
          }
        } else {
          if tag_kind == TagKind::Heading || tag_kind == TagKind::Li || tag_kind == TagKind::Block {
            out_ensure_newline();
            pending_ws = false;
          }
        }
        i = gt + 1;
      }
    } else {
      // Plain text byte or HTML entity
      let (ent_len, ent_cp) = decode_entity_at(i, n);
      if ent_len > 0 {
        if is_ws(ent_cp) {
          pending_ws = true;
        } else {
          if pending_ws {
            out_push_word_sep();
            pending_ws = false;
          }
          out_push(ent_cp);
        }
        i += ent_len;
      } else {
        let b = in_at(i, n);
        if is_ws(b) {
          pending_ws = true;
        } else {
          if pending_ws {
            out_push_word_sep();
            pending_ws = false;
          }
          out_push_byte(b);
        }
        i += 1;
      }
    }
  }

  out_trim_trailing_spaces();
  // Trim trailing newline if any
  let final_l = SanMem.out_len;
  if final_l > 0 && SanMem.out_buf[final_l - 1] == '\n' {
    SanMem.out_len = final_l - 1;
  }
  SanMem.out_len
}

test "sanitizer strips script tags and decodes entities" {
  // "<script>x</script>A&amp;B"
  SanMem.in_buf[0] = '<'; SanMem.in_buf[1] = 's'; SanMem.in_buf[2] = 'c'; SanMem.in_buf[3] = 'r';
  SanMem.in_buf[4] = 'i'; SanMem.in_buf[5] = 'p'; SanMem.in_buf[6] = 't'; SanMem.in_buf[7] = '>';
  SanMem.in_buf[8] = 'x';
  SanMem.in_buf[9] = '<'; SanMem.in_buf[10] = '/'; SanMem.in_buf[11] = 's'; SanMem.in_buf[12] = 'c';
  SanMem.in_buf[13] = 'r'; SanMem.in_buf[14] = 'i'; SanMem.in_buf[15] = 'p'; SanMem.in_buf[16] = 't';
  SanMem.in_buf[17] = '>';
  SanMem.in_buf[18] = 'A';
  SanMem.in_buf[19] = '&'; SanMem.in_buf[20] = 'a'; SanMem.in_buf[21] = 'm'; SanMem.in_buf[22] = 'p'; SanMem.in_buf[23] = ';';
  SanMem.in_buf[24] = 'B';
  let out_n = sanitize_html_ifm(25);
  assert(SanMem.stripped_scripts == 1);
  assert(out_n == 3);
  assert(SanMem.out_buf[0] == 'A');
  assert(SanMem.out_buf[1] == '&');
  assert(SanMem.out_buf[2] == 'B');
}
